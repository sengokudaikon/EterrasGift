// Settings (spec/shell-and-settings.md §10). Switches save the moment they flip; the typed locations wait for
// "Save locations".

import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../tokens.slint";
import { TitleText, SectionText, SecondaryText, LabelText, CaptionText } from "../widgets/text.slint";
import { Button, ButtonKind } from "../widgets/button.slint";
import { ToggleSwitch } from "../widgets/toggle.slint";
import { TextField } from "../widgets/text-field.slint";
import { ActionBar, MessageTone, SettingGroup, SwitchSetting } from "common.slint";

export struct LocationSetting {
    label: string,
    value: string,
    placeholder: string,
    caption: string,
    browse-label: string,
}

export global SettingsState {
    // Module switches (one module today: the trainer).
    in-out property <bool> trainer-enabled;
    in property <string> trainer-problem;
    // The trainer's own groups show only in a run that has the trainer.
    in property <bool> trainer-running;
    in-out property <bool> auto-connect: true;
    in-out property <bool> expert;
    in property <string> definitions: "No game-data cache loaded";
    in property <bool> can-refresh-definitions;

    in property <[LocationSetting]> locations;
    in property <bool> locations-changed;

    in property <string> message;
    in property <MessageTone> message-tone;
    in property <bool> can-restart;

    callback trainer-toggled(bool);
    callback auto-connect-toggled(bool);
    callback expert-toggled(bool);
    callback refresh-definitions();
    callback location-edited(int, string);
    callback browse(int);
    callback save-locations();
    callback restart();
}

export component SettingsPage inherits Rectangle {
    in property <bool> compact;

    VerticalLayout {
        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            // Measured from where the body actually ends: a layout's preferred height counts wrapped text inside `if` and
            // `for` blocks as one line (research/slint.md, "Known pain points").
            content-height: body.y + locations-group.y + locations.y + locations-end.y + Tokens.settings-body-margin.bottom;

            // The body's margin sits outside its maximum width, as in the C# view. Its height is its own, so where its
            // last child ends never depends on the scroll content's height (that would be a binding loop).
            body := VerticalLayout {
                x: root.compact ? Tokens.settings-body-compact-margin.left : Tokens.settings-body-margin.left;
                y: Tokens.settings-body-margin.top;
                width: Math.min(Tokens.settings-max-width, parent.width - self.x
                    - (root.compact ? Tokens.settings-body-compact-margin.right : Tokens.settings-body-margin.right));
                height: self.preferred-height;
                alignment: start;

                TitleText {
                    text: "Settings";
                }

                Rectangle {
                    height: Tokens.settings-title-margin.bottom;
                }

                SettingGroup {
                    SwitchSetting {
                        title: "Trainer";
                        description: "Edits items in the running game for offline characters. It loads a helper into Last Epoch, which stays there until the game restarts. Online characters are always refused.";
                        note: "Takes effect after restarting Eterra's Gift.";
                        problem: SettingsState.trainer-problem;

                        ToggleSwitch {
                            label: "Trainer";
                            checked <=> SettingsState.trainer-enabled;
                            toggled(on) => {
                                SettingsState.trainer-toggled(on);
                            }
                        }
                    }
                }

                if SettingsState.trainer-running: SettingGroup {
                    SwitchSetting {
                        title: "Connection";
                        description: "Find Last Epoch and connect once an offline character is loaded. Online characters are always refused.";

                        ToggleSwitch {
                            label: "Connection";
                            on-text: "Automatic";
                            off-text: "Manual";
                            checked <=> SettingsState.auto-connect;
                            toggled(on) => {
                                SettingsState.auto-connect-toggled(on);
                            }
                        }
                    }
                }

                if SettingsState.trainer-running: SettingGroup {
                    SwitchSetting {
                        title: "I know what I'm doing";
                        description: "Writes edits the game would not make itself: Weaver, enchantment and corrupted affixes wherever the slot fits, incompatible affixes and bases, another idol size, Weaver's Will on any unique and Weaver's Touch on any idol. With this off, incompatible affixes can still be listed but not written.";
                        note: "Use expendable items. The game may drop or rearrange what it does not support.";

                        ToggleSwitch {
                            label: "I know what I'm doing";
                            checked <=> SettingsState.expert;
                            toggled(on) => {
                                SettingsState.expert-toggled(on);
                            }
                        }
                    }
                }

                if SettingsState.trainer-running: SettingGroup {
                    VerticalLayout {
                        spacing: Tokens.space-12;

                        SectionText {
                            text: "Game definitions";
                        }

                        SecondaryText {
                            text: "Affix and unique definitions captured from the game on first connection, keyed by game build and language.";
                        }

                        Rectangle {
                            background: Tokens.surface-brush;
                            border-width: 1px;
                            border-color: Tokens.hairline-brush;
                            border-radius: Tokens.control-radius;

                            HorizontalLayout {
                                padding-left: Tokens.notice-padding.left;
                                padding-right: Tokens.notice-padding.right;
                                padding-top: Tokens.notice-padding.top;
                                padding-bottom: Tokens.notice-padding.bottom;

                                Text {
                                    text: SettingsState.definitions;
                                    color: Tokens.text-brush;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: Tokens.space-12;
                            alignment: start;

                            Button {
                                text: "Refresh from game";
                                icon: Tokens.icon-refresh;
                                enabled: SettingsState.can-refresh-definitions;
                                clicked => {
                                    SettingsState.refresh-definitions();
                                }
                            }

                            if !SettingsState.can-refresh-definitions: CaptionText {
                                text: "Available once an offline character is connected.";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

                locations-group := SettingGroup {
                    last: true;

                    locations := VerticalLayout {
                        spacing: Tokens.space-16;

                        SectionText {
                            text: "Locations";
                        }

                        for location[i] in SettingsState.locations: VerticalLayout {
                            spacing: Tokens.space-6;

                            LabelText {
                                text: location.label;
                            }

                            HorizontalLayout {
                                spacing: Tokens.space-8;

                                TextField {
                                    label: location.label;
                                    text: location.value;
                                    placeholder: location.placeholder;
                                    edited(text) => {
                                        SettingsState.location-edited(i, text);
                                    }
                                }

                                Button {
                                    text: "Browse…";
                                    icon: Tokens.icon-folder;
                                    tip: location.browse-label;
                                    clicked => {
                                        SettingsState.browse(i);
                                    }
                                }
                            }

                            CaptionText {
                                text: location.caption;
                            }
                        }

                        // Where the page really ends; see `content-height`.
                        locations-end := Rectangle {
                            height: 0px;
                        }
                    }
                }

            }
        }

        ActionBar {
            message: SettingsState.message;
            tone: SettingsState.message-tone;

            if SettingsState.can-restart: Button {
                text: "Restart now";
                tip: "Close Eterra's Gift and start it again, so the saved change takes effect";
                clicked => {
                    SettingsState.restart();
                }
            }

            Button {
                text: "Save locations";
                kind: ButtonKind.primary;
                enabled: SettingsState.locations-changed;
                tip: "Save the locations. The game executable, user-data, mod library and MelonLoader folders take effect after a restart; the mod sources and .NET SDK folders at once.";
                clicked => {
                    SettingsState.save-locations();
                }
            }
        }
    }
}
