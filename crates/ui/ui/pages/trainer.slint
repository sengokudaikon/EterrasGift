// Trainer pages: a page's sections along the top,
// left out when it has one, and the chosen section beneath: rows of features, or Forge › Item, which is the Item Forge.
// Rust (crates/ui/src/trainer) builds the rows from the catalog and owns every value; the view lays them out.
// Forge › Item is the Item Forge (pages/forge/) while the session holds an item. Without the game the hooks are a profile
// to set up; once a game is seen they wait, behind the connection's notice, until an offline character is in play.

import { ScrollView } from "../widgets/scroll-view.slint";
import { Tokens } from "../tokens.slint";
import { Connection, KeyboardFocus, Tip } from "../globals.slint";
import { Button, ButtonKind } from "../widgets/button.slint";
import { ToggleSwitch } from "../widgets/toggle.slint";
import { FocusRing } from "../widgets/focus.slint";
import { BodyText, LabelText, CaptionText, CaptionTone, TitleText } from "../widgets/text.slint";
import { HelpButton } from "../widgets/help-button.slint";
import { NumberBox } from "../widgets/number-box.slint";
import { ValueSlider } from "../widgets/value-slider.slint";
import { ChoiceBox } from "../widgets/choice-box.slint";
import { AshField, EterraFrames } from "../decorations.slint";
import { ItemForge } from "forge/editor.slint";
import { ForgeState } from "forge/state.slint";
import { TrainerText } from "../strings/trainer.slint";

// A row is a game hook (a switch, with values), an editor (fields read from the game), a list of what the character holds,
// a feature not ported yet (a source checkout only), or a section's heading on a page that stacks its sections.
export enum FeatureRowKind { heading, hook, editor, held, planned }

// A status line's mark: the check once the game holds it, the error mark with the reason.
export enum FeatureTone { none, confirmed, error }

// A hook's value: a number box with its unit, or a pick from a list.
export struct FeatureValueView {
    label: string,
    accessible-name: string,
    unit: string,
    choice: bool,
    choices: [string],
    choice-index: int,
    text: string,
    step-tip: string,
    // Where it sits on its bar (0 to 1), and its "minimum – maximum" for the typing popover.
    fraction: float,
    range: string,
}

// An editor's field: its name over what the game holds, and its box (a draft until Apply).
export struct FeatureFieldView {
    label: string,
    group: string,
    starts-group: bool,
    first: bool,
    accessible-name: string,
    text: string,
    game-text: string,
    drafted: bool,
    step-tip: string,
}

export struct FeatureRowView {
    kind: FeatureRowKind,
    title: string,
    help: string,
    // A hook: its switch, its one value on the title line or several listed under it, and where it stands.
    on: bool,
    has-inline: bool,
    choice-only: bool,
    inline-value: FeatureValueView,
    status: string,
    tone: FeatureTone,
    // Its controls take changes: an editor connected, served and not waiting on the game; a hook unless the connected game
    // cannot have it in this version.
    can-use: bool,
    // An editor or held items: why it cannot be used, under the title (it waits for a connection, or this version cannot
    // serve it).
    reason: string,
    unread: bool,
    empty: bool,
    has-drafts: bool,
    can-discard: bool,
    can-apply: bool,
    apply-text: string,
    // A planned feature: its values and their defaults, or its fields' names.
    details: string,
}

// A row's lists: a hook's values listed under its title, an editor's fields. They sit apart from the row so a change to the
// row leaves their items in place (a box being typed in keeps its focus); a list is replaced only when its length changes.
export struct FeatureRowModels {
    listed-values: [FeatureValueView],
    fields: [FeatureFieldView],
}

// Where Rust placed a row (by its index in `TrainerState.rows`): its column, its top in the list (a heading's below the
// section spacing Rust leaves above it), and whether it ends that column.
export struct FeatureRowPlace { column: int, y: length, ends: bool }

// What the trainer pages can do: set up a profile while no game runs, wait behind the connection's notice from the moment
// a game is seen until an offline character is in play (or after a stop), and act on the game once one is.
export enum TrainerAccess { setup, locked, live }

export global TrainerState {
    in property <TrainerAccess> access: TrainerAccess.locked;
    // Every kept profile (its character's name, class and cycle), the last played first; the character whose hooks the
    // rows are, by its index among them (-1 for one in play without a profile), its name and its full label (empty while
    // none is), whether its hooks are kept as its profile or last this session only; and what the rows do with them.
    in property <[string]> profiles;
    in property <int> profile-index: -1;
    in property <string> profile-name;
    in property <string> profile-label;
    in property <bool> profile-kept: true;
    in property <string> profile-caption;
    // While no game runs: show another profile, or delete the shown one. While its character is in play: keep its hooks
    // as its profile, or delete the profile, leaving its hooks for this session.
    callback select-profile(int);
    callback delete-profile();
    callback keep-profile();

    // What every trainer page shows in place of its body while it waits (`access` locked), and what the Item Forge shows
    // without the game: waiting for the game or a character, connecting, online mode, a stop.
    // Rust's texts, set before the window shows.
    in property <string> connection-title;
    in property <string> connection-detail;
    // The connection stopped for a reason the user has to fix: the warning mark beside the title.
    in property <bool> connection-stopped;
    // A real wait (for the game, a character, the connection): ash drifts under it.
    in property <bool> connection-waiting;
    // Connected, but the forge's item could not be shown: why (empty when it can, or the forge is empty).
    in property <string> item-unavailable;

    // The open page: its sections (none when it has one), the chosen one, and what that section holds.
    in property <[string]> sections;
    in-out property <int> section;
    in property <bool> item-forge;
    in property <[FeatureRowView]> rows;
    in property <[FeatureRowModels]> row-models;
    in property <[FeatureRowPlace]> row-places;
    in property <int> column-count: 1;
    // The tallest column, with every row in place.
    in property <length> rows-height;
    // False while a section's rows wait for their split, so they appear in their columns (view.rs `Layout`).
    in property <bool> rows-ready: true;
    // Changes when another page or section opens, so the list starts at its top.
    in property <int> serial;

    callback open(string);
    callback select-section(int);
    // The layout reports how many columns fit and each row's height; Rust splits the rows into the columns.
    callback columns-changed(int);
    callback row-measured(int, length);

    callback hook-toggled(int, bool);
    callback value-committed(int, int, string);
    callback value-stepped(int, int, int);
    // A hook value's cell: a drag's distance as a share of its range (sent once, when it ends; true when cancelled), the
    // ends, and why a typed text is no value (empty when it is one).
    callback value-scrubbed(int, int, float);
    callback value-scrub-ended(int, int, bool);
    callback value-stepped-to-end(int, int, bool);
    pure callback value-checked(int, int, string) -> string;
    callback value-chosen(int, int, int);
    callback field-edited(int, int, string);
    callback field-committed(int, int, string);
    callback field-stepped(int, int, int);
    callback read(int);
    callback apply(int);
    callback discard(int);
}

// A page's section tabs in the manner of Windows' selector bar: plain words, the current one over the game's active-tab
// mark, a crimson bar on a bronze line (the line carries it clear of the ground, where crimson alone is under 2:1), and a
// hairline beneath the strip. One tab stop: Left and Right (Home and End) move between sections, and the section follows.
component SectionBar inherits Rectangle {
    in property <[string]> sections;
    in-out property <int> current;
    in property <bool> compact;
    in property <string> title;

    accessible-role: tab-list;
    accessible-label: root.title;
    height: layout.preferred-height + Tokens.border-bottom.bottom;

    Rectangle {
        y: parent.height - self.height;
        height: Tokens.border-bottom.bottom;
        background: Tokens.hairline-brush;
    }

    strip := FocusScope {
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) {
                KeyboardFocus.visible = true;
            }
        }
        key-pressed(event) => {
            if (event.modifiers.alt || event.modifiers.control || event.modifiers.meta) {
                return reject;
            }
            if (event.text == Key.LeftArrow && root.current > 0) {
                root.current -= 1;
                return accept;
            }
            if (event.text == Key.RightArrow && root.current < root.sections.length - 1) {
                root.current += 1;
                return accept;
            }
            if (event.text == Key.Home) {
                root.current = 0;
                return accept;
            }
            if (event.text == Key.End) {
                root.current = root.sections.length - 1;
                return accept;
            }
            reject
        }

        layout := HorizontalLayout {
            y: 0;
            height: self.preferred-height;
            padding-left: root.compact ? Tokens.section-bar-compact-padding.left : Tokens.section-bar-padding.left;
            padding-top: Tokens.section-bar-padding.top;
            spacing: Tokens.space-24;
            alignment: start;

            for section[i] in root.sections: Rectangle {
                width: label.preferred-width;
                height: tab-layout.preferred-height;
                accessible-role: tab;
                accessible-label: section;
                accessible-item-selected: root.current == i;

                tab-layout := VerticalLayout {
                    padding-top: Tokens.section-tab-padding.top;
                    padding-bottom: Tokens.section-tab-padding.bottom + Tokens.section-tab-indicator.bottom + Tokens.border-bottom.bottom;

                    label := Text {
                        text: section;
                        font-size: Tokens.font-size-value;
                        color: root.current == i ? Tokens.text-brush : touch.has-hover ? Tokens.text-secondary-brush : Tokens.text-muted-brush;
                    }
                }

                Rectangle {
                    y: parent.height - Tokens.border-bottom.bottom - self.height;
                    height: Tokens.section-tab-indicator.bottom;
                    background: root.current == i ? Tokens.primary-brush : transparent;
                }

                Rectangle {
                    y: parent.height - self.height;
                    height: Tokens.border-bottom.bottom;
                    background: root.current == i ? Tokens.accent-trim-brush : transparent;
                }

                touch := TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            KeyboardFocus.visible = false;
                        }
                    }
                    clicked => {
                        root.current = i;
                        strip.focus();
                    }
                }

                // The ring marks the current section while the keyboard is on the strip, with room beside the words.
                Rectangle {
                    x: -Tokens.space-6;
                    width: parent.width + Tokens.space-6 * 2;

                    FocusRing {
                        focused: strip.has-focus && root.current == i;
                    }
                }
            }
        }
    }
}

// One of a hook's several values: [name | box], the name indented under the title, the box in the value column.
component ValueLine inherits Rectangle {
    // From the page: what this shows and what it asks of it.
    pure callback value-checked(int, int, string) -> string;
    callback value-chosen(int, int, int);
    callback value-committed(int, int, string);
    callback value-scrub-ended(int, int, bool);
    callback value-scrubbed(int, int, float);
    callback value-stepped(int, int, int);
    callback value-stepped-to-end(int, int, bool);

    in property <FeatureValueView> value;
    in property <int> row-index;
    in property <int> value-index;
    in property <length> title-width;
    in property <length> value-right;
    in property <bool> enabled;
    in property <string> help;

    height: Math.max(Tokens.control-min-height, label.height);

    label := Text {
        x: Tokens.feature-nested-indent.left;
        y: (parent.height - self.height) / 2;
        width: root.title-width - self.x;
        height: self.preferred-height;
        text: root.value.label;
        color: Tokens.text-secondary-brush;
        wrap: word-wrap;
    }

    if !root.value.choice: ValueSlider {
        width: Tokens.feature-field-width;
        x: root.value-right - self.width;
        y: (parent.height - self.height) / 2;
        text: root.value.text;
        unit: root.value.unit;
        fraction: root.value.fraction;
        range: root.value.range;
        label: root.value.accessible-name;
        accessible-description: root.help;
        tip: root.value.step-tip;
        enabled: root.enabled;
        vertical-steps: true;
        scrubbed(delta) => { root.value-scrubbed(root.row-index, root.value-index, delta); }
        scrub-ended(cancelled) => { root.value-scrub-ended(root.row-index, root.value-index, cancelled); }
        stepped(steps) => { root.value-stepped(root.row-index, root.value-index, steps); }
        stepped-to-end(end) => { root.value-stepped-to-end(root.row-index, root.value-index, end); }
        committed(text) => { root.value-committed(root.row-index, root.value-index, text); }
        checked(text) => { return root.value-checked(root.row-index, root.value-index, text); }
    }

    if root.value.choice: ChoiceBox {
        width: self.natural-width;
        x: root.value-right - self.width;
        y: (parent.height - self.height) / 2;
        choices: root.value.choices;
        index: root.value.choice-index;
        label: root.value.accessible-name;
        accessible-description: root.help;
        enabled: root.enabled;
        chosen(choice) => { root.value-chosen(root.row-index, root.value-index, choice); }
    }
}

// An editor's field: [name over "In game: N" | box], indented under the title, under its group's name when it heads one.
component FieldLine inherits Rectangle {
    // From the page: what this shows and what it asks of it.
    callback field-committed(int, int, string);
    callback field-edited(int, int, string);
    callback field-stepped(int, int, int);

    in property <FeatureFieldView> field;
    in property <int> row-index;
    in property <int> field-index;
    in property <length> title-width;
    in property <length> value-x;
    in property <bool> enabled;
    in property <string> help;

    property <length> group-height: root.field.starts-group ? group.y + group.height + Tokens.space-6 : 0px;
    property <length> pair-height: label.height + Tokens.space-2 + game.height;
    property <length> grid-height: Math.max(Tokens.control-min-height, root.pair-height);

    height: root.group-height + root.grid-height;

    group := LabelText {
        visible: root.field.starts-group;
        x: Tokens.feature-nested-indent.left;
        y: root.field.first ? 0px : Tokens.feature-nested-group-margin.top;
        width: parent.width - self.x;
        height: root.field.starts-group ? self.preferred-height : 0px;
        text: root.field.group;
    }

    label := Text {
        x: Tokens.feature-nested-indent.left;
        y: root.group-height + (root.grid-height - root.pair-height) / 2;
        width: root.title-width - self.x;
        height: self.preferred-height;
        text: root.field.label;
        color: root.field.drafted ? Tokens.draft-brush : Tokens.text-secondary-brush;
        wrap: word-wrap;
    }

    game := Text {
        x: label.x;
        y: label.y + label.height + Tokens.space-2;
        width: label.width;
        height: self.preferred-height;
        text: root.field.game-text;
        font-size: Tokens.font-size-value;
        color: Tokens.text-muted-brush;
        wrap: word-wrap;
    }

    NumberBox {
        x: root.value-x;
        y: root.group-height + (root.grid-height - self.height) / 2;
        value: root.field.text;
        label: root.field.accessible-name;
        accessible-description: root.help;
        tip: root.field.step-tip;
        enabled: root.enabled;
        drafted: root.field.drafted;
        edited(text) => { root.field-edited(root.row-index, root.field-index, text); }
        committed(text) => { root.field-committed(root.row-index, root.field-index, text); }
        stepped(direction) => { root.field-stepped(root.row-index, root.field-index, direction); }
    }
}

// One row: [title (?) | value | switch], a hairline under it and the hover ground under the whole of it, outdented so its
// words keep the page's edge. Every height is worked out from texts given their width, so the column it sits in measures it
// right however its words wrap (crates/ui/README.md: wrapped text in `for` and `if`).
component FeatureRow inherits Rectangle {
    // From the page: what this shows and what it asks of it.
    callback apply(int);
    callback discard(int);
    callback field-committed(int, int, string);
    callback field-edited(int, int, string);
    callback field-stepped(int, int, int);
    callback hook-toggled(int, bool);
    callback read(int);
    callback row-measured(int, length);
    pure callback value-checked(int, int, string) -> string;
    callback value-chosen(int, int, int);
    callback value-committed(int, int, string);
    callback value-scrub-ended(int, int, bool);
    callback value-scrubbed(int, int, float);
    callback value-stepped(int, int, int);
    callback value-stepped-to-end(int, int, bool);

    in property <FeatureRowView> feature;
    in property <FeatureRowModels> models;
    in property <int> row-index;
    // It ends its column: the last row has no hairline.
    in property <bool> ends;

    property <bool> heading: root.feature.kind == FeatureRowKind.heading;
    property <bool> hook: root.feature.kind == FeatureRowKind.hook;
    property <bool> held: root.feature.kind == FeatureRowKind.held;
    property <bool> editor: root.feature.kind == FeatureRowKind.editor || root.held;
    property <bool> planned: root.feature.kind == FeatureRowKind.planned;

    // The three columns, 24 apart: the title's, the value's (a box, a choice growing left, or Apply) and the switch's.
    property <length> switch-x: root.width - Tokens.feature-switch-min-width;
    property <length> value-right: root.feature.choice-only ? root.width : root.switch-x - Tokens.space-24;
    property <length> value-x: root.value-right - Tokens.feature-value-column-width;
    property <length> title-width: root.value-x - Tokens.space-24;
    property <length> top: Tokens.feature-row-padding.top;

    // The title line holds the title and its controls, centred on each other.
    // The (?) follows the title's last word. A title with no room for it on its line keeps the line, and the (?) takes the
    // next one, as an inline button wraps; a title that wraps anyway puts it on a line of its own too (Slint cannot place
    // anything after a wrapped text's last word).
    property <length> help-room: Tokens.space-6 + help.width + Tokens.feature-title-help-margin.right;
    property <bool> help-below: measure.preferred-width + root.help-room > root.title-width;
    property <length> title-height: title.height + (root.help-below ? measure.preferred-height : 0px);
    // An editor's line is as tall as Read again (Fluent's icon button: its padding and frame round the icon).
    property <length> line: Math.max(root.title-height, root.planned ? mark.height
        : root.editor ? Math.max(Tokens.control-min-height, read.preferred-height) : Tokens.control-min-height);
    property <length> below-title: root.top + root.line;
    property <length> values-height: root.models.listed-values.length > 0 ? Tokens.feature-fields-margin.top + values.height : 0px;
    property <bool> fields-shown: root.editor && !(root.held && root.feature.unread);
    property <length> block-height: offline.height + unread.height + empty.height + (root.fields-shown ? Tokens.feature-fields-margin.top + fields.height : 0px);
    property <length> actions-y: root.below-title + root.block-height + Tokens.feature-action-margin.top;
    property <length> actions-height: root.editor ? Tokens.feature-action-margin.top + Tokens.control-min-height : 0px;
    property <length> details-height: root.planned && root.feature.details != "" ? Tokens.feature-status-margin.top + details.height : 0px;
    property <length> status-y: root.below-title + root.values-height + (root.editor ? root.block-height + root.actions-height : 0px) + Tokens.feature-status-margin.top;
    property <length> status-height: root.feature.status != "" ? Tokens.feature-status-margin.top + status.height : 0px;

    // Its own height, what the column split weighs; the section spacing above a heading is Rust's, in the row's place.
    out property <length> natural-height: root.heading ? heading-label.height + Tokens.feature-group-margin.bottom
        : root.below-title + root.values-height + (root.editor ? root.block-height + root.actions-height : 0px) + root.details-height + root.status-height
            + Tokens.feature-row-padding.bottom + 1px;

    height: root.natural-height;

    init => {
        root.row-measured(root.row-index, root.natural-height);
    }
    changed natural-height => {
        root.row-measured(root.row-index, root.natural-height);
    }

    accessible-role: groupbox;
    accessible-label: root.feature.title;
    accessible-description: root.feature.help;

    Rectangle {
        x: Tokens.feature-row-outdent.left;
        width: parent.width - Tokens.feature-row-outdent.left - Tokens.feature-row-outdent.right;
        background: !root.heading && hover.has-hover ? Tokens.hover-brush : transparent;
    }

    Rectangle {
        x: Tokens.feature-row-outdent.left;
        y: parent.height - 1px;
        width: parent.width - Tokens.feature-row-outdent.left - Tokens.feature-row-outdent.right;
        height: 1px;
        background: root.heading || root.ends ? transparent : Tokens.hairline-brush;
    }

    // The hover ground follows the pointer anywhere over the row, its controls included.
    hover := TouchArea {
        heading-label := LabelText {
            visible: root.heading;
            x: 0;
            y: 0;
            width: parent.width;
            height: self.preferred-height;
            text: root.feature.title;
        }

        // The title wraps in its column, its (?) after it.
        measure := Text {
            visible: false;
            text: root.feature.title;
        }

        title := Text {
            visible: !root.heading;
            x: 0;
            y: root.top + (root.line - root.title-height) / 2;
            width: Math.min(measure.preferred-width, root.title-width);
            height: self.preferred-height;
            text: root.feature.title;
            color: Tokens.text-brush;
            wrap: word-wrap;
        }

        help := HelpButton {
            visible: !root.heading;
            x: root.help-below ? Tokens.feature-title-help-margin.left : title.width + Tokens.space-6;
            y: title.y + root.title-height - measure.preferred-height / 2 - self.height / 2;
            help: root.feature.help;
            label: TrainerText.about(root.feature.title);
        }

        // A hook: its one value on the title line, named for the feature; its switch at the far right.
        if root.hook && root.feature.has-inline && !root.feature.inline-value.choice: ValueSlider {
            width: Tokens.feature-field-width;
            x: root.value-right - self.width;
            y: root.top + (root.line - self.height) / 2;
            text: root.feature.inline-value.text;
            unit: root.feature.inline-value.unit;
            fraction: root.feature.inline-value.fraction;
            range: root.feature.inline-value.range;
            label: root.feature.inline-value.accessible-name;
            accessible-description: root.feature.help;
            tip: root.feature.inline-value.step-tip;
            enabled: root.feature.can-use;
            vertical-steps: true;
            scrubbed(delta) => { root.value-scrubbed(root.row-index, 0, delta); }
            scrub-ended(cancelled) => { root.value-scrub-ended(root.row-index, 0, cancelled); }
            stepped(steps) => { root.value-stepped(root.row-index, 0, steps); }
            stepped-to-end(end) => { root.value-stepped-to-end(root.row-index, 0, end); }
            committed(text) => { root.value-committed(root.row-index, 0, text); }
            checked(text) => { return root.value-checked(root.row-index, 0, text); }
        }

        if root.hook && root.feature.has-inline && root.feature.inline-value.choice: ChoiceBox {
            width: self.natural-width;
            x: root.value-right - self.width;
            y: root.top + (root.line - self.height) / 2;
            choices: root.feature.inline-value.choices;
            index: root.feature.inline-value.choice-index;
            label: root.feature.inline-value.accessible-name;
            accessible-description: root.feature.help;
            enabled: root.feature.can-use;
            chosen(choice) => { root.value-chosen(root.row-index, 0, choice); }
        }

        if root.hook && !root.feature.choice-only: ToggleSwitch {
            x: root.switch-x;
            y: root.top + (root.line - self.height) / 2;
            width: Tokens.feature-switch-min-width;
            height: Tokens.control-min-height;
            label: root.feature.title;
            accessible-description: root.feature.help;
            checked: root.feature.on;
            enabled: root.feature.can-use;
            toggled(on) => { root.hook-toggled(root.row-index, on); }
        }

        // Several values are listed under the title by name.
        values := VerticalLayout {
            x: 0;
            y: root.below-title + Tokens.feature-fields-margin.top;
            width: parent.width;
            height: self.preferred-height;
            spacing: Tokens.space-6;

            for value[i] in root.models.listed-values: ValueLine {
                value-checked(a0, a1, a2) => { return root.value-checked(a0, a1, a2); }
                value-chosen(a0, a1, a2) => { root.value-chosen(a0, a1, a2); }
                value-committed(a0, a1, a2) => { root.value-committed(a0, a1, a2); }
                value-scrub-ended(a0, a1, a2) => { root.value-scrub-ended(a0, a1, a2); }
                value-scrubbed(a0, a1, a2) => { root.value-scrubbed(a0, a1, a2); }
                value-stepped(a0, a1, a2) => { root.value-stepped(a0, a1, a2); }
                value-stepped-to-end(a0, a1, a2) => { root.value-stepped-to-end(a0, a1, a2); }
                value: value;
                row-index: root.row-index;
                value-index: i;
                title-width: root.title-width;
                value-right: root.value-right;
                enabled: root.feature.can-use;
                help: root.feature.help;
            }
        }

        // An editor: Read again on the title line, at its own size; while it cannot be used, the reason under the title.
        // Kept on every row (hidden and disabled off editors, so it takes no focus) for the line to measure it.
        read := Button {
            visible: root.editor;
            x: root.switch-x;
            y: root.top + (root.line - self.height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            icon: Tokens.icon-refresh;
            kind: ButtonKind.subtle;
            enabled: root.editor && root.feature.can-use;
            tip: root.held ? TrainerText.read-stash-again : TrainerText.read-game-again;
            accessible-name: TrainerText.read-again;
            clicked => { root.read(root.row-index); }
        }

        offline := CaptionText {
            visible: root.editor && root.feature.reason != "";
            x: Tokens.feature-nested-indent.left;
            y: root.below-title;
            width: parent.width - self.x;
            height: self.visible ? self.preferred-height : 0px;
            text: root.feature.reason;
        }

        unread := CaptionText {
            visible: root.held && root.feature.unread;
            x: Tokens.feature-nested-indent.left;
            y: offline.y + offline.height;
            width: parent.width - self.x;
            height: self.visible ? self.preferred-height : 0px;
            text: TrainerText.not-read-yet;
        }

        empty := CaptionText {
            visible: root.held && root.feature.empty;
            x: Tokens.feature-nested-indent.left;
            y: unread.y + unread.height;
            width: parent.width - self.x;
            height: self.visible ? self.preferred-height : 0px;
            text: TrainerText.none-in-stash;
        }

        fields := VerticalLayout {
            visible: root.fields-shown;
            x: 0;
            y: empty.y + empty.height + Tokens.feature-fields-margin.top;
            width: parent.width;
            height: self.preferred-height;
            spacing: Tokens.space-6;

            for field[i] in root.models.fields: FieldLine {
                field-committed(a0, a1, a2) => { root.field-committed(a0, a1, a2); }
                field-edited(a0, a1, a2) => { root.field-edited(a0, a1, a2); }
                field-stepped(a0, a1, a2) => { root.field-stepped(a0, a1, a2); }
                field: field;
                row-index: root.row-index;
                field-index: i;
                title-width: root.title-width;
                value-x: root.value-x;
                enabled: root.feature.can-use;
                help: root.feature.help;
            }
        }

        // Discard (only with drafts) right of the titles' column, Apply in the value column, under the boxes.
        if root.editor && root.feature.has-drafts: Button {
            x: root.title-width - self.width;
            y: root.actions-y;
            width: self.preferred-width;
            height: Tokens.control-min-height;
            text: TrainerText.discard;
            kind: ButtonKind.subtle;
            enabled: root.feature.can-discard;
            tip: TrainerText.discard-tip;
            clicked => { root.discard(root.row-index); }
        }

        if root.editor: Button {
            x: root.value-x;
            y: root.actions-y;
            width: Math.max(Tokens.feature-field-width, self.preferred-width);
            height: Tokens.control-min-height;
            text: root.feature.apply-text;
            enabled: root.feature.can-apply;
            tip: TrainerText.apply-tip;
            clicked => { root.apply(root.row-index); }
        }

        // A planned feature: "Not ported yet" where its control will go, and what it will have under the title.
        mark := CaptionText {
            visible: root.planned;
            x: root.value-x;
            y: root.top + (root.line - self.height) / 2;
            width: parent.width - self.x;
            height: self.preferred-height;
            wrap: no-wrap;
            text: TrainerText.not-ported;
        }

        details := CaptionText {
            visible: root.planned && root.feature.details != "";
            // A planned row's details take the feature-status margin, not the nested indent.
            x: Tokens.feature-status-margin.left;
            y: root.below-title + Tokens.feature-status-margin.top;
            width: parent.width - self.x;
            height: self.visible ? self.preferred-height : 0px;
            text: root.feature.details;
        }

        // Where it stands: the check once the game holds it, the error mark with the reason.
        if root.feature.status != "" && root.feature.tone != FeatureTone.none: Image {
            x: 0;
            y: root.status-y + Tokens.feature-status-icon-margin.top;
            width: Tokens.icon-size-tiny;
            height: Tokens.icon-size-tiny;
            image-fit: contain;
            source: root.feature.tone == FeatureTone.confirmed ? Tokens.icon-confirmed : Tokens.icon-error;
            colorize: root.feature.tone == FeatureTone.confirmed ? Tokens.confirmed-brush : Tokens.error-brush;
        }

        status := CaptionText {
            visible: !root.heading && root.feature.status != "";
            x: root.feature.tone != FeatureTone.none ? Tokens.icon-size-tiny + Tokens.feature-status-icon-margin.right : 0px;
            y: root.status-y;
            width: parent.width - self.x;
            height: self.visible ? self.preferred-height : 0px;
            text: root.feature.status;
            accessible-role: text;
            // Announced as it changes.
            accessible-live-region: polite;
            tone: root.feature.tone == FeatureTone.confirmed ? CaptionTone.confirmed : root.feature.tone == FeatureTone.error ? CaptionTone.error : CaptionTone.muted;
        }
    }
}

// A section's rows: one width on every page (520–600), left beside the navigation; a page with room for two rows side by
// side takes them in two columns, split by Rust from the heights the rows report.
component FeatureList inherits Rectangle {
    // From the page: what this shows and what it asks of it.
    callback apply(int);
    in property <int> column-count;
    callback columns-changed(int);
    callback discard(int);
    callback field-committed(int, int, string);
    callback field-edited(int, int, string);
    callback field-stepped(int, int, int);
    callback hook-toggled(int, bool);
    callback read(int);
    callback row-measured(int, length);
    in property <[FeatureRowModels]> row-models;
    in property <[FeatureRowPlace]> row-places;
    in property <[FeatureRowView]> rows;
    in property <length> rows-height;
    in property <bool> rows-ready;
    in property <int> serial;
    pure callback value-checked(int, int, string) -> string;
    callback value-chosen(int, int, int);
    callback value-committed(int, int, string);
    callback value-scrub-ended(int, int, bool);
    callback value-scrubbed(int, int, float);
    callback value-stepped(int, int, int);
    callback value-stepped-to-end(int, int, bool);

    in property <bool> compact;

    property <length> margin-left: root.compact ? Tokens.trainer-body-compact-margin.left : Tokens.trainer-body-margin.left;
    property <length> margin-right: root.compact ? Tokens.trainer-body-compact-margin.right : Tokens.trainer-body-margin.right;
    property <length> available: root.width - root.margin-left - root.margin-right;
    property <int> columns: Math.max(1, Math.min(Tokens.feature-max-columns, root.rows.length,
        Math.floor((root.available + Tokens.feature-column-spacing) / (Tokens.feature-row-min-width + Tokens.feature-column-spacing))));
    property <length> column-width: Math.min(Tokens.feature-row-max-width,
        root.columns == 1 ? root.available : (root.available - Tokens.feature-column-spacing * (root.columns - 1)) / root.columns);

    init => {
        root.columns-changed(root.columns);
    }
    changed columns => {
        root.columns-changed(root.columns);
    }
    changed serial => {
        scroll.content-y = 0;
    }

    scroll := ScrollView {
        width: root.width;
        height: root.height;
        content-width: self.visible-width;
        content-height: Tokens.trainer-body-margin.top + body.height + Tokens.trainer-body-margin.bottom;

        // The rows' hover ground and hairlines reach past their words but stop at the body's edge.
        Rectangle {
            x: root.margin-left;
            y: Tokens.trainer-body-margin.top;
            width: root.column-count * root.column-width + Math.max(0, root.column-count - 1) * Tokens.feature-column-spacing;
            height: body.height;
            clip: true;

            // One repeater over every row, each at the place Rust gave it: a row the split moves to another column is the
            // same row, so it keeps its focus and a half-typed number (a repeater per column made it anew).
            body := Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: root.rows-height;

                for feature[index] in root.rows: FeatureRow {
                    apply(a0) => { root.apply(a0); }
                    discard(a0) => { root.discard(a0); }
                    field-committed(a0, a1, a2) => { root.field-committed(a0, a1, a2); }
                    field-edited(a0, a1, a2) => { root.field-edited(a0, a1, a2); }
                    field-stepped(a0, a1, a2) => { root.field-stepped(a0, a1, a2); }
                    hook-toggled(a0, a1) => { root.hook-toggled(a0, a1); }
                    read(a0) => { root.read(a0); }
                    row-measured(a0, a1) => { root.row-measured(a0, a1); }
                    value-checked(a0, a1, a2) => { return root.value-checked(a0, a1, a2); }
                    value-chosen(a0, a1, a2) => { root.value-chosen(a0, a1, a2); }
                    value-committed(a0, a1, a2) => { root.value-committed(a0, a1, a2); }
                    value-scrub-ended(a0, a1, a2) => { root.value-scrub-ended(a0, a1, a2); }
                    value-scrubbed(a0, a1, a2) => { root.value-scrubbed(a0, a1, a2); }
                    value-stepped(a0, a1, a2) => { root.value-stepped(a0, a1, a2); }
                    value-stepped-to-end(a0, a1, a2) => { root.value-stepped-to-end(a0, a1, a2); }
                    property <FeatureRowPlace> place: root.row-places[index];
                    x: self.place.column * (root.column-width + Tokens.feature-column-spacing);
                    y: self.place.y;
                    width: root.column-width;
                    // Hidden, not transparent, while the split is pending: a row not drawn takes no click or Tab. It still
                    // reports its height.
                    visible: root.rows-ready;
                    feature: feature;
                    models: root.row-models[index];
                    row-index: index;
                    ends: self.place.ends;
                }
            }
        }
    }
}

// Over the hooks: whose they are and when they apply. While no game runs another profile can be chosen, or the shown one
// deleted (asked first, in place of the caption). While its character is in play it is named, and its hooks are kept as
// its profile, or its profile deleted (asked first too). With no profile yet, only how one comes.
component ProfileBand inherits Rectangle {
    // From the page: what this shows and what it asks of it.
    in property <TrainerAccess> access;
    callback delete-profile();
    callback keep-profile();
    in property <string> profile-caption;
    in property <int> profile-index;
    in property <bool> profile-kept;
    in property <string> profile-label;
    in property <string> profile-name;
    in property <[string]> profiles;
    callback select-profile(int);

    in property <bool> compact;

    property <length> margin-left: root.compact ? Tokens.trainer-body-compact-margin.left : Tokens.trainer-body-margin.left;
    property <length> margin-right: root.compact ? Tokens.trainer-body-compact-margin.right : Tokens.trainer-body-margin.right;
    property <bool> setup: root.access == TrainerAccess.setup;
    property <bool> shown: root.profile-label != "";
    property <bool> kept: root.profile-kept;
    // Delete was pressed: the band asks before it deletes. Another profile shown, or the game seen, asks nothing.
    property <bool> confirming;
    property <int> index: root.profile-index;

    changed setup => {
        root.confirming = false;
    }
    changed index => {
        root.confirming = false;
    }
    changed kept => {
        root.confirming = false;
    }

    VerticalLayout {
        padding-left: root.margin-left;
        padding-right: root.margin-right;
        padding-top: Tokens.trainer-body-margin.top;
        spacing: Tokens.space-4;

        if root.shown: HorizontalLayout {
            spacing: Tokens.space-12;
            alignment: start;

            LabelText {
                text: TrainerText.profile;
                vertical-alignment: center;
            }

            if root.setup: ChoiceBox {
                width: self.natural-width;
                choices: root.profiles;
                index: root.profile-index;
                label: TrainerText.profile;
                enabled: !root.confirming;
                chosen(index) => {
                    root.select-profile(index);
                }
            }

            if root.setup: Button {
                text: TrainerText.delete-ellipsis;
                enabled: !root.confirming;
                tip: TrainerText.delete-profile-tip;
                clicked => {
                    root.confirming = true;
                }
            }

            if !root.setup: BodyText {
                text: root.profile-label;
                vertical-alignment: center;
            }

            if !root.setup && !root.kept: Button {
                text: TrainerText.keep-as-profile;
                tip: TrainerText.keep-for(root.profile-name);
                clicked => {
                    root.keep-profile();
                }
            }

            if !root.setup && root.kept: Button {
                text: TrainerText.delete-ellipsis;
                enabled: !root.confirming;
                tip: TrainerText.delete-profile-tip;
                clicked => {
                    root.confirming = true;
                }
            }
        }

        if root.confirming: HorizontalLayout {
            spacing: Tokens.space-12;
            alignment: start;

            CaptionText {
                text: root.setup
                    ? TrainerText.delete-profile-setup(root.profile-name)
                    : TrainerText.delete-profile-live(root.profile-name);
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Button {
                text: TrainerText.delete;
                kind: ButtonKind.primary;
                clicked => {
                    root.confirming = false;
                    root.delete-profile();
                }
            }

            Button {
                text: TrainerText.keep;
                clicked => {
                    root.confirming = false;
                }
            }
        }

        if !root.confirming: CaptionText {
            text: root.profile-caption;
            wrap: word-wrap;
        }
    }
}

// A page body that has nothing to work on yet, in words: the connection's state on
// every trainer page, or the connected forge with no item to show. A stop the user has to fix carries the warning mark
// beside its title; the connection's one next step (Connect, Retry) is the only button, and only the connection offers it.
// Ash drifts up during a real wait and lies still under the empty forge; it is gone on a stop (Rust says which, and drives
// the drift's frames).
component TrainerNotice inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> stopped;
    in property <bool> ash-shown;
    in property <bool> ash-still;
    in property <bool> action-shown;

    // The reading line height as a factor of the value size's own line (crates/ui/README.md: read on a probe, never on the
    // text that sets it).
    probe := Text {
        visible: false;
        font-size: Tokens.font-size-value;
        text: " ";
    }

    if root.ash-shown: AshField {
        width: root.width;
        height: root.height;
        still: root.ash-still;
    }

    if root.ash-shown && !root.ash-still: EterraFrames { }

    VerticalLayout {
        alignment: center;
        padding-left: Tokens.forge-empty-margin.left;
        padding-right: Tokens.forge-empty-margin.right;
        padding-top: Tokens.forge-empty-margin.top;
        padding-bottom: Tokens.forge-empty-margin.bottom;

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                max-width: Tokens.reading-max-width;
                spacing: Tokens.space-12;

                HorizontalLayout {
                    alignment: center;

                    if root.stopped: VerticalLayout {
                        alignment: center;
                        padding-right: Tokens.leading-mark-margin.right;

                        Image {
                            width: Tokens.icon-size;
                            height: Tokens.icon-size;
                            image-fit: contain;
                            source: Tokens.icon-warning;
                            colorize: Tokens.warning-brush;
                            accessible-role: image;
                            accessible-label: TrainerText.warning;
                        }
                    }

                    TitleText {
                        text: root.title;
                        horizontal-alignment: center;
                    }
                }

                Text {
                    text: root.detail;
                    font-size: Tokens.font-size-value;
                    line-height-factor: Tokens.line-height-reading / Math.max(1px, probe.font-metrics.ascent - probe.font-metrics.descent);
                    color: Tokens.text-secondary-brush;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if root.action-shown && Connection.show-action: HorizontalLayout {
                    alignment: center;
                    padding-top: Tokens.empty-action-margin.top;

                    Button {
                        text: Connection.action-text;
                        kind: ButtonKind.primary;
                        clicked => {
                            Connection.connect();
                        }
                    }
                }
            }
        }
    }
}

export component TrainerPage inherits Rectangle {
    in property <string> page-id;
    in property <string> page-title;
    in property <bool> compact;
    // The window classes, for the Item Forge's layout.
    in property <bool> narrow;
    in property <bool> wide;

    init => {
        TrainerState.open(root.page-id);
    }
    changed page-id => {
        TrainerState.open(root.page-id);
    }
    property <int> section: TrainerState.section;
    changed section => {
        TrainerState.select-section(root.section);
    }
    // The editor's controls go with its item, and a tip one of them opened goes with them.
    property <bool> has-item: ForgeState.has-item;
    changed has-item => {
        Tip.open = false;
    }

    VerticalLayout {
        if TrainerState.sections.length > 1: SectionBar {
            sections: TrainerState.sections;
            current <=> TrainerState.section;
            compact: root.compact;
            title: root.page-title;
        }

        // While the trainer waits on a game, every section of every trainer page shows the connection instead of its body;
        // the Item Forge needs the game itself, so it shows it in a setup too.
        if TrainerState.access == TrainerAccess.locked || (TrainerState.item-forge && TrainerState.access != TrainerAccess.live): TrainerNotice {
            vertical-stretch: 1;
            title: TrainerState.connection-title;
            detail: TrainerState.connection-detail;
            stopped: TrainerState.connection-stopped;
            ash-shown: TrainerState.connection-waiting;
            action-shown: true;
        }

        // The owned item observation, while the current session can display it.
        if TrainerState.access == TrainerAccess.live && TrainerState.item-forge && ForgeState.has-item: ItemForge {
            vertical-stretch: 1;
            compact: root.compact;
            narrow: root.narrow;
            wide: root.wide;
        }

        // Connected with nothing to show: the forge is empty, or its item could not be shown (a write's readback, or an
        // item the catalog cannot describe).
        if TrainerState.access == TrainerAccess.live && TrainerState.item-forge && !ForgeState.has-item: TrainerNotice {
            vertical-stretch: 1;
            title: ForgeState.write-recovery-required ? TrainerText.readback-unavailable
                : TrainerState.item-unavailable != "" ? TrainerText.item-unavailable : TrainerText.forge-empty;
            detail: ForgeState.write-recovery-required ? ForgeState.message
                : TrainerState.item-unavailable != "" ? TrainerState.item-unavailable : TrainerText.forge-empty-detail;
            stopped: ForgeState.write-recovery-required;
            ash-shown: !ForgeState.write-recovery-required;
            ash-still: true;
        }

        // No game: the hooks are the profile being set up, applied when its character enters play.
        if TrainerState.access != TrainerAccess.locked && !TrainerState.item-forge: ProfileBand {
            access: TrainerState.access;
            delete-profile() => { TrainerState.delete-profile(); }
            keep-profile() => { TrainerState.keep-profile(); }
            profile-caption: TrainerState.profile-caption;
            profile-index: TrainerState.profile-index;
            profile-kept: TrainerState.profile-kept;
            profile-label: TrainerState.profile-label;
            profile-name: TrainerState.profile-name;
            profiles: TrainerState.profiles;
            select-profile(a0) => { TrainerState.select-profile(a0); }
            compact: root.compact;
        }

        if TrainerState.access != TrainerAccess.locked && !TrainerState.item-forge: FeatureList {
            apply(a0) => { TrainerState.apply(a0); }
            column-count: TrainerState.column-count;
            columns-changed(a0) => { TrainerState.columns-changed(a0); }
            discard(a0) => { TrainerState.discard(a0); }
            field-committed(a0, a1, a2) => { TrainerState.field-committed(a0, a1, a2); }
            field-edited(a0, a1, a2) => { TrainerState.field-edited(a0, a1, a2); }
            field-stepped(a0, a1, a2) => { TrainerState.field-stepped(a0, a1, a2); }
            hook-toggled(a0, a1) => { TrainerState.hook-toggled(a0, a1); }
            read(a0) => { TrainerState.read(a0); }
            row-measured(a0, a1) => { TrainerState.row-measured(a0, a1); }
            row-models: TrainerState.row-models;
            row-places: TrainerState.row-places;
            rows: TrainerState.rows;
            rows-height: TrainerState.rows-height;
            rows-ready: TrainerState.rows-ready;
            serial: TrainerState.serial;
            value-checked(a0, a1, a2) => { return TrainerState.value-checked(a0, a1, a2); }
            value-chosen(a0, a1, a2) => { TrainerState.value-chosen(a0, a1, a2); }
            value-committed(a0, a1, a2) => { TrainerState.value-committed(a0, a1, a2); }
            value-scrub-ended(a0, a1, a2) => { TrainerState.value-scrub-ended(a0, a1, a2); }
            value-scrubbed(a0, a1, a2) => { TrainerState.value-scrubbed(a0, a1, a2); }
            value-stepped(a0, a1, a2) => { TrainerState.value-stepped(a0, a1, a2); }
            value-stepped-to-end(a0, a1, a2) => { TrainerState.value-stepped-to-end(a0, a1, a2); }
            vertical-stretch: 1;
            compact: root.compact;
        }
    }
}
