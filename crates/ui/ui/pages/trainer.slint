// Trainer pages. Until the trainer is ported each page shows its section bar (when it has one) and the connection's
// empty state (spec/trainer.md §3.10). TODO(trainer): the feature lists, the stash, and the Item Forge.

import { Tokens } from "../tokens.slint";
import { Connection, KeyboardFocus } from "../globals.slint";
import { Button, ButtonKind } from "../widgets/button.slint";
import { FocusRing } from "../widgets/focus.slint";
import { EmptyState } from "common.slint";
// TODO(forge) hook: the Item Forge in Forge › Item.
import { ItemForge } from "forge/editor.slint";
import { ForgeState } from "forge/state.slint";

export global TrainerState {
    // The forge's empty state for the current connection state.
    in property <string> empty-title: "Not connected";
    in property <string> empty-detail: "Connect, then place an item in the forge.";
}

// A page's section tabs, underlined in crimson like the game's active tab. One tab stop, as a Windows tab strip: Left and
// Right (Home and End) move between sections, and the section follows the keyboard.
component SectionBar inherits Rectangle {
    in property <[string]> sections;
    in-out property <int> current;
    in property <bool> compact;

    accessible-role: tab-list;
    height: layout.preferred-height;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Tokens.hairline-brush;
    }

    strip := FocusScope {
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) {
                KeyboardFocus.visible = true;
            }
        }
        key-pressed(event) => {
            if (event.modifiers.alt || event.modifiers.control || event.modifiers.meta) {
                return reject;
            }
            if (event.text == Key.LeftArrow && root.current > 0) {
                root.current -= 1;
                return accept;
            }
            if (event.text == Key.RightArrow && root.current < root.sections.length - 1) {
                root.current += 1;
                return accept;
            }
            if (event.text == Key.Home) {
                root.current = 0;
                return accept;
            }
            if (event.text == Key.End) {
                root.current = root.sections.length - 1;
                return accept;
            }
            reject
        }

        layout := HorizontalLayout {
            padding-left: root.compact ? Tokens.section-bar-compact-padding.left : Tokens.section-bar-padding.left;
            padding-top: Tokens.section-bar-padding.top;
            spacing: Tokens.space-24;
            alignment: start;

            for section[i] in root.sections: Rectangle {
                width: label.preferred-width;
                height: tab-layout.preferred-height;
                accessible-role: tab;
                accessible-label: section;
                accessible-item-selected: root.current == i;

                tab-layout := VerticalLayout {
                    padding-top: Tokens.section-tab-padding.top;
                    padding-bottom: Tokens.section-tab-padding.bottom;

                    label := Text {
                        text: section;
                        font-size: Tokens.font-size-value;
                        font-weight: root.current == i ? Tokens.emphasis-weight : 400;
                        color: root.current == i ? Tokens.text-brush : touch.has-hover ? Tokens.text-brush : Tokens.text-secondary-brush;
                    }
                }

                Rectangle {
                    y: parent.height - self.height;
                    height: Tokens.section-tab-indicator.bottom;
                    background: root.current == i ? Tokens.primary-hover-brush : transparent;
                }

                touch := TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            KeyboardFocus.visible = false;
                        }
                    }
                    clicked => {
                        root.current = i;
                        strip.focus();
                    }
                }

                // The ring marks the current section while the keyboard is on the strip, with room beside the words.
                Rectangle {
                    x: -Tokens.space-6;
                    width: parent.width + Tokens.space-6 * 2;

                    FocusRing {
                        focused: strip.has-focus && root.current == i;
                    }
                }
            }
        }
    }
}

export component TrainerPage inherits Rectangle {
    in property <string> page-id;
    in property <string> page-title;
    in property <bool> compact;
    // TODO(forge) hook: the window classes and the current section, for the Item Forge below.
    in property <bool> narrow;
    in property <bool> wide;

    property <bool> forge: root.page-id == "forge";
    property <[string]> sections: root.forge ? ["Item", "Crafting rules"] : [];
    property <int> section;

    VerticalLayout {
        if root.sections.length > 0: SectionBar {
            sections: root.sections;
            current <=> root.section;
            compact: root.compact;
        }

        // TODO(forge) hook: Forge › Item is the Item Forge while the session holds an item (never yet in the real app).
        if root.forge && root.section == 0 && ForgeState.has-item: ItemForge {
            vertical-stretch: 1;
            compact: root.compact;
            narrow: root.narrow;
            wide: root.wide;
        }

        if !(root.forge && root.section == 0 && ForgeState.has-item): EmptyState {
            vertical-stretch: 1;
            title: root.forge ? TrainerState.empty-title : root.page-title;
            detail: root.forge ? TrainerState.empty-detail : "Not ported yet.";

            if root.forge && Connection.show-action: Button {
                text: Connection.action-text;
                kind: ButtonKind.primary;
                clicked => {
                    Connection.connect();
                }
            }
        }
    }
}
