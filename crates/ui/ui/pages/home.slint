// Home: starting the game, and how far it has come.

import { Tokens } from "../tokens.slint";
import { TitleText, SecondaryText, CaptionText, CaptionTone } from "../widgets/text.slint";
import { Button } from "../widgets/button.slint";
import { EterraBand, AshField, EterraFrames } from "../decorations.slint";

export enum LaunchMode { online, offline, with-mods }

// Eterra's tree in its four keyframes; Home follows the game: none running, found, a character loading, in game.
export enum BloomPhase { wilted, budding, opening, bloom }

export global HomeState {
    // False only in a run without the launcher (tests): Home then shows the companion's own title.
    in property <bool> has-launcher: true;
    in property <BloomPhase> phase: BloomPhase.wilted;
    // The game is on its way in (found, not yet in play): ash drifts up the page.
    in property <bool> game-starting;
    in property <bool> can-start: true;
    in property <bool> can-start-with-mods: true;
    // Why the buttons are disabled, or what each does (the tooltips, shown on disabled buttons too).
    in property <string> online-tip: "Start the game through Steam. MelonLoader is set aside first, so no mod loads online";
    in property <string> offline-tip: "Start the game in offline mode. MelonLoader is set aside first, so no mod loads";
    in property <string> with-mods-tip: "Start the game in offline mode with MelonLoader and the mods that are on; needs MelonLoader in the game folder";
    // The last start's message, about this one game.
    in property <string> message;
    in property <bool> message-is-error;

    callback start(LaunchMode);
}

export component HomePage inherits Rectangle {
    // Eterra's tree crowns Home and follows the game (Rust heads it for HomeState.phase); ash drifts only while the game is
    // on its way in.
    band := EterraBand {
        x: 0;
        y: 0;
        width: root.width;
        visible: HomeState.has-launcher;
    }

    if HomeState.has-launcher && HomeState.game-starting: AshField {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    EterraFrames { }

    // One centred column under the eye, pushed below the twigs.
    VerticalLayout {
        x: (root.width - self.width) / 2;
        y: 0;
        width: Math.min(Tokens.reading-max-width, Math.max(0px, root.width - Tokens.empty-state-margin.left - Tokens.empty-state-margin.right));
        height: root.height;
        padding-top: HomeState.has-launcher ? band.content-top : Tokens.empty-state-margin.top;
        alignment: start;
        spacing: HomeState.has-launcher ? Tokens.space-12 : Tokens.space-8;

        TitleText {
            text: HomeState.has-launcher ? "Last Epoch" : "Home";
            horizontal-alignment: center;
        }

        if !HomeState.has-launcher: SecondaryText {
            text: "Companion tools for Last Epoch. New ones appear here as they are added.";
            horizontal-alignment: center;
        }

        // Three ways in, in the order of how much they change: online as the game ships, offline, offline with mods.
        if HomeState.has-launcher: HorizontalLayout {
            alignment: center;
            padding-top: Tokens.empty-action-margin.top;
            spacing: Tokens.space-8;

            Button {
                text: "Play online";
                enabled: HomeState.can-start;
                tip: HomeState.online-tip;
                clicked => {
                    HomeState.start(LaunchMode.online);
                }
            }

            Button {
                text: "Play offline";
                enabled: HomeState.can-start;
                tip: HomeState.offline-tip;
                clicked => {
                    HomeState.start(LaunchMode.offline);
                }
            }

            Button {
                text: "Play offline with mods";
                enabled: HomeState.can-start && HomeState.can-start-with-mods;
                tip: HomeState.with-mods-tip;
                clicked => {
                    HomeState.start(LaunchMode.with-mods);
                }
            }
        }

        if HomeState.has-launcher && HomeState.message != "": HorizontalLayout {
            alignment: center;
            spacing: Tokens.space-6;

            // Top-aligned with the first line.
            VerticalLayout {
                alignment: start;
                padding-top: Tokens.icon-baseline-nudge.top;

                Image {
                    image-fit: contain;
                    source: HomeState.message-is-error ? Tokens.icon-error : Tokens.icon-info;
                    width: Tokens.icon-size-small;
                    height: Tokens.icon-size-small;
                    colorize: HomeState.message-is-error ? Tokens.error-brush : Tokens.text-muted-brush;
                }
            }

            CaptionText {
                text: HomeState.message;
                tone: HomeState.message-is-error ? CaptionTone.error : CaptionTone.secondary;
                max-width: Tokens.reading-max-width;
                accessible-role: text;
                // Announced as it changes.
                accessible-live-region: polite;
            }
        }
    }
}
