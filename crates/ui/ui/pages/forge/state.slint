// The Item Forge's state, shared with Rust (crates/ui/src/forge). Rust owns the item and its drafts; these carry them to
// the view and carry commands back. Writes run on the trainer worker; snapshots
// and typed outcomes return without blocking the event loop.

import { MessageTone } from "../common.slint";
import { ForgeText } from "../../strings/forge.slint";
import { PillView } from "../../widgets/pill.slint";

// Which value editor a cell edits: an affix row's value, a roll of a unique or implicit line, or a numeric item field.
export enum CellKind { affix, unique, implicit, field }
export struct CellRef { kind: CellKind, row: int, roll: int }

// What a value cell asks of its value: a press (focus or a click), a drag by `amount` of its span, the drag's end or its
// cancel, `amount` steps, either end, and leaving the popover with Escape or by a click away.
export enum CellAction { press, scrub, end-scrub, cancel-scrub, step, to-start, to-end, cancel-input, finish-input }

// The value popover, for the one cell typing: what its box starts with (typing goes to Rust as it is typed), the label,
// the range, and why the text is no value (empty while it is one).
export struct CellInput { typing: bool, cell: CellRef, label: string, text: string, range: string, error: string }

// A cell Rust asks to take keyboard focus (a ledger entry for a value, Up/Down between rows), and a serial that moves with
// each ask. Parts of an affix row: 0 value, 1 name, 2 tier, 3 seal. A field (kind field): 0 its value, 1 its flag toggle;
// with row -1, 4 the base and 5 the identity in the header.
export struct CellFocus { cell: CellRef, part: int, serial: int }

// The game-owned colour a name takes.
export enum ItemRarity { normal, magic, rare, exalted, unique, set, legendary }

// A value cell: the value, the "was" caption while drafted, and where the value sits in the game's range.
export struct ValueCell {
    cell: CellRef,
    // The value's own identity (its row's uid and roll): another value in the same place ends a drag on the old one.
    uid: int,
    label: string,
    display: string,
    was: string,
    draft: bool,
    // A usable table is known: the range bar shows (otherwise the tiny lock does).
    mapped: bool,
    // Every roll gives the same value: no value, bar or lock.
    fixed: bool,
    // The value can change now; otherwise the cursor is the arrow and hover shows nothing.
    editable: bool,
    fraction: float,
    game-fraction: float,
    game-tick: bool,
    tip: string,
}

export struct TierOption { label: string, range: string, in-game: bool }

export struct AffixRowView {
    value: ValueCell,
    name: string,
    replaced: bool,
    // Apply adds this affix, which the game does not hold yet; or removes it.
    added: bool,
    removed: bool,
    detail: string,
    reforged: bool,
    name-tip: string,
    range: string,
    tier: string,
    tier-drafted: bool,
    exalted: bool,
    tier-index: int,
    seal: string,
    sealed: bool,
    seal-drafted: bool,
    seal-index: int,
    // Tier and seal can be drafted now.
    can-edit: bool,
    dirty: bool,
    pending: bool,
    stale: bool,
    draft-tip: string,
    confirmed: bool,
    tiers: [TierOption],
}

// A unique modifier or an implicit: its rolls scrub in place; the line itself never changes.
export struct ModifierRowView {
    rolls: [ValueCell],
    editable: bool,
    fixed-text: string,
    text: string,
    drafted: bool,
    range: string,
    confirmed: bool,
    stale: bool,
    pending: bool,
    draft-tip: string,
    linked: string,
}

// An item-level value in the status strip: a number scrubbed in place, or a flag named by its state.
export struct FieldView {
    name: string,
    numeric: bool,
    value: ValueCell,
    tip: string,
    // The tip's bold first line on a numeric field (why it is read-only), or empty.
    tip-heading: string,
    confirmed: bool,
    stale: bool,
    editable: bool,
    can-edit: bool,
    on-name: string,
    off-name: string,
    checked: bool,
    drafted: bool,
}

export struct DraftEntryView { name: string, summary: string, effect: string, stale: bool }
export struct AppliedEntryView { name: string, time: string, summary: string, effect: string, outcome: string }
export struct MenuOptionView {
    rarity: ItemRarity,
    name: string,
    // Short facts side by side, each its own text, then what stands in the way, as sentences.
    facts: [string],
    note: string,
    implicits: string,
    in-game: bool,
    available: bool,
    current: bool
}
// An affix picker's row: its name, its facts as pills, all the rest for its tip, one fact a line, and pills and tip together
// for a screen reader.
export struct PickerRowView { name: string, pills: [PillView], detail: string, spoken: string }

// Which of the affix picker's filters changed: a choice box (its `index`), a stat tag (`index` and `on`), "Allow
// incompatible affixes" (`on`), a chip removed (its `index`), every filter cleared, or the unique modifiers the default
// Source holds back listed.
export enum PickerFilter { side, category, class, slot, level, source, tag, allow, chip, clear, uniques }

// The affix picker: whether it is open, and what it shows.
export struct PickerView {
    open: bool,
    title: string,
    subtitle: string,
    search: string,
    // The filters: each one's choices and the chosen one; a choice its list no longer holds shows its `-text`.
    sides: [string],
    side: int,
    categories: [string],
    category: int,
    classes: [string],
    class: int,
    slots: [string],
    slot: int,
    slot-text: string,
    slot-active: bool,
    levels: [string],
    level: int,
    sources: [string],
    source: int,
    source-text: string,
    source-active: bool,
    tags: [string],
    tags-on: [bool],
    tags-text: string,
    tags-active: bool,
    allow: bool,
    allow-enabled: bool,
    // The filters in force, off their defaults, each with what it takes to clear it.
    chips: [string],
    count: string,
    // The offer to list the unique modifiers the default Source holds back; empty when none are.
    hidden: string,
    // Why the list is empty, and which ways out it offers.
    empty-reason: string,
    empty-clear-search: bool,
    empty-clear-filters: bool,
    empty-allow: bool,
    rows: [PickerRowView],
    selected: int,
    status: string,
    action: string,
    can-use: bool,
}

// A saved item template: its name, what it holds, and both in one line for screen readers.
export struct TemplateRowView { name: string, facts: [string], label: string }

// A cell Rust brought into focus (Show draft, Up/Down) asks the lists to scroll it into view: its top and height in window
// coordinates. Only the forge's own views read it.
export global ForgeReveal {
    out property <length> top;
    out property <length> height;
    out property <int> serial;

    public function show(top: length, height: length) {
        self.top = top;
        self.height = height;
        self.serial += 1;
    }
}

// In a narrow window the open changes pane lies over the table's right side: its area in window coordinates, so the cells
// under it leave the Tab order (focus would land out of sight). Only the forge's own views read it.
export global ForgeCover {
    out property <bool> active;
    out property <length> left;
    out property <length> top;

    public function set(active: bool, left: length, top: length) {
        self.active = active;
        self.left = left;
        self.top = top;
    }

    // Whether a cell at (x, y) of this size, in window coordinates, lies under the pane.
    public pure function covers(x: length, y: length, width: length, height: length) -> bool {
        return self.active && x + width > self.left && y + height > self.top;
    }
}

export global ForgeState {
    in property <bool> has-item;
    // Connected, but the item could not be shown: why (empty when it can, or the forge is empty).
    in property <string> item-unavailable;
    in property <bool> write-recovery-required;

    // The header.
    in property <string> item-name;
    // The name opens the identity picker on a unique, set or legendary item.
    in property <bool> has-identity;
    in property <bool> identity-drafted;
    in property <bool> can-change-identity;
    in property <string> identity-tip;
    in property <string> identity-search;
    in property <[MenuOptionView]> identity-options;
    in property <ItemRarity> name-rarity;
    in property <string> rarity-text;
    in property <bool> rarity-drafted;
    in property <bool> can-change-rarity;
    in property <string> rarity-tip;
    in property <[MenuOptionView]> rarity-options;
    in property <string> base-text;
    in property <bool> base-drafted;
    in property <bool> can-change-base;
    in property <string> base-tip;
    in property <[MenuOptionView]> base-options;
    // The rarity menu's caption lines, for its flyout's height (a PopupWindow needs one).
    in property <int> rarity-caption-lines;
    in property <bool> base-allow-incompatible;
    // The base field itself can be edited now (its "Allow incompatible affixes" box).
    in property <bool> base-can-edit;
    in property <[string]> summary;
    in property <[FieldView]> fields;

    // Implicits.
    in property <bool> has-implicits;
    in property <bool> implicit-rows-shown;
    in property <string> implicit-note;
    in property <[ModifierRowView]> implicits;
    in property <[string]> implicit-preview;
    in property <bool> implicit-preview-draft;

    // The affix table.
    in property <[AffixRowView]> affixes;
    in property <int> selected-affix: -1;
    in property <bool> can-change-affix-list;
    in property <string> add-affix-tip;
    in property <bool> can-max-tiers;
    in property <string> max-tiers-tip;
    in property <bool> can-max-rolls;
    // Item templates: whether this run keeps them, the kept ones (read when the flyout opens) and the last action's word.
    in property <bool> has-templates;
    in property <[TemplateRowView]> template-rows;
    in property <string> template-message;
    // The name typed for a new template (Rust clears it once saved), and the kept template a save under it would replace.
    in property <string> template-name;
    in property <string> template-replaces;
    in property <string> max-rolls-tip;
    in property <string> affix-list-note;
    in property <string> ladder-note;

    // Unique modifiers.
    in property <bool> has-unique;
    in property <[ModifierRowView]> unique-modifiers;
    in property <int> selected-unique: -1;
    in property <string> preview-status;
    in property <bool> preview-failed;
    in property <bool> preview-stale;
    in property <string> formatting-error;
    in property <bool> formatting-loading;

    // The changes pane: open or closed is the view's (it follows the window class); the entries are Rust's. The window
    // class it last followed lives here too, so an item swap that rebuilds the forge keeps the user's choice.
    in-out property <bool> pane-open: true;
    in-out property <bool> pane-class-known;
    in-out property <bool> pane-narrow;
    in property <[DraftEntryView]> drafts;
    in property <string> draft-count-text;
    in property <[AppliedEntryView]> history;

    // The action bar.
    in property <string> message;
    in property <MessageTone> message-tone;
    in property <string> changes-text;
    in property <string> undo-text;
    in property <string> undo-tip;
    in property <bool> can-undo;
    in property <string> discard-text;
    in property <bool> can-discard;
    in property <string> apply-text;
    in property <bool> can-apply;

    // The value popover, for the one cell typing; typing ended elsewhere (Undo, an item change) closes it.
    in property <CellInput> cell-input: { cell: { kind: CellKind.affix, row: -1, roll: -1 } };
    // The affix picker, for an addition or a replacement.
    in property <PickerView> picker: { selected: -1 };
    // The cell Rust asks to take keyboard focus.
    in property <CellFocus> focus-target: { cell: { kind: CellKind.affix, row: -1, roll: -1 } };

    callback select-affix(int);
    callback select-unique(int);
    // Up / Down from a cell of row `int` in part `int`.
    callback move-row(int, int, int);
    // Up / Down from roll `int` of unique modifier row `int`.
    callback move-unique(int, int, int);
    callback move-implicit(int, int, int);
    // A menu's keyboard highlight: where it starts (the held entry, else the first available), and the next available entry
    // from one in a direction (the same one when there is none).
    pure callback option-start([MenuOptionView]) -> int;
    pure callback option-step([MenuOptionView], int, int) -> int;
    callback cell-acted(CellRef, CellAction, float);
    callback begin-input(CellRef) -> bool;
    callback input-edited(CellRef, string);
    callback commit-input(CellRef) -> bool;
    callback pick-tier(int, int);
    callback pick-seal(int, int);
    callback toggle-flag(int, bool);
    callback pick-rarity(int);
    callback pick-base(int);
    callback pick-identity(int);
    callback identity-search-edited(string);
    callback base-allow(bool);
    callback open-replace(int) -> bool;
    callback open-add() -> bool;
    callback max-tiers();
    callback max-rolls();
    callback templates-opened();
    callback template-name-edited(string);
    callback template-save(string, bool);
    callback template-apply(int);
    callback template-delete(int);
    callback picker-search-edited(string);
    callback picker-filter-changed(PickerFilter, int, bool);
    callback picker-select(int);
    callback use-picker();
    callback cancel-picker();
    callback discard-row(int);
    callback remove-affix(int);
    callback show-draft(int);
    callback discard-entry(int);
    callback discard-all();
    callback apply();
    callback undo();
    callback undo-draft();
}
