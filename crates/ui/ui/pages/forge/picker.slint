// The affix picker (DESIGN.md "Menus and Affix Picker"): replaces a row's affix as a draft, or adds
// one, which is written at once. The title and caption, the search, All / Prefixes / Suffixes, the incompatible toggle
// with its caption, the list, the status, then Cancel and the primary in equal halves.

import { ListView } from "../../widgets/scroll-view.slint";
import { Tokens } from "../../tokens.slint";
import { FieldFrame } from "../../widgets/text-field.slint";
import { KeyboardFocus, Tip } from "../../globals.slint";
import { Button, ButtonKind } from "../../widgets/button.slint";
import { FocusRing, TipBubble } from "../../widgets/focus.slint";
import { FlyoutSurface } from "../../widgets/menu.slint";
import { ChoiceBox } from "../../widgets/choice-box.slint";
import { ForgeState } from "state.slint";
import { CheckBox, RadioButton } from "cells.slint";

export global PickerMetrics {
    // A list row: the name over its kind, 7px above and below.
    out property <length> row: Tokens.catalog-entry-margin.top + Tokens.catalog-entry-margin.bottom + Tokens.font-size-body * 4 / 3
        + Tokens.space-1 + Tokens.font-size-caption * 4 / 3 + Tokens.row-padding.top + 2px;
    out property <length> caption-line: Tokens.font-size-caption * 4 / 3;

    public pure function list-height(rows: int) -> length {
        return rows == 0 ? Tokens.font-size-body * 4 / 3 + Tokens.empty-list-margin.top + Tokens.empty-list-margin.bottom
            : Math.min(Tokens.replace-list-max-height, rows * self.row + Math.max(0, rows - 1) * Tokens.space-2);
    }

    // The whole flyout for a list of `rows`.
    public pure function height(rows: int) -> length {
        return Tokens.flyout-padding.top + Tokens.flyout-padding.bottom
            + Tokens.font-size-section * 4 / 3 + Tokens.space-2 + self.caption-line
            + Tokens.control-min-height
            + Tokens.control-min-height + Tokens.space-4 + Tokens.control-min-height + Tokens.space-4 + Tokens.control-min-height
            + Tokens.space-2 + self.caption-line * 2
            + self.list-height(rows)
            + self.caption-line
            + Tokens.control-min-height
            + Tokens.space-10 * 5;
    }
}

// The picker's wrapped caption lines, measured at the flyout's width: what they add over one line each, for the flyout's
// height (a PopupWindow needs one, and can't be measured from outside).
export component PickerMeasure inherits Rectangle {
    out property <length> extra: Math.max(0px, subtitle.preferred-height - PickerMetrics.caption-line)
        + Math.max(0px, status.preferred-height - PickerMetrics.caption-line);

    width: 0;
    height: 0;
    visible: false;

    subtitle := Text {
        x: 0;
        y: 0;
        width: Tokens.replace-flyout-width;
        text: ForgeState.picker-subtitle;
        font-size: Tokens.font-size-caption;
        wrap: word-wrap;
    }

    status := Text {
        x: 0;
        y: 0;
        width: Tokens.replace-flyout-width;
        text: ForgeState.picker-status;
        font-size: Tokens.font-size-caption;
        wrap: word-wrap;
    }
}

// The search box: a muted search icon inside its left edge and a placeholder naming what it searches.
export component SearchBox inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <string> label;
    callback edited(string);
    callback down();
    callback accepted();

    public function focus-input() {
        input.focus();
    }

    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;

    height: Tokens.control-min-height;
    border-radius: Tokens.control-radius;
    border-width: 1px;
    background: FieldFrame.background(true, input.has-focus, touch.has-hover);
    border-color: FieldFrame.border(true, input.has-focus, touch.has-hover);

    // The whole box takes the pointer, as a text box does: a click anywhere in it types into the search.
    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                KeyboardFocus.visible = false;
            }
        }
        clicked => {
            input.focus();
        }
    }

    Image {
        x: Tokens.search-icon-margin.left;
        y: (parent.height - self.height) / 2;
        width: Tokens.icon-size;
        height: Tokens.icon-size;
        image-fit: contain;
        source: Tokens.icon-search;
        colorize: Tokens.text-muted-brush;
    }

    Rectangle {
        x: Tokens.search-icon-margin.left + Tokens.icon-size + Tokens.search-icon-margin.right + Tokens.space-4;
        width: parent.width - self.x - Tokens.space-10;
        clip: true;

        if root.text == "": Text {
            x: 0;
            width: parent.width;
            text: root.placeholder;
            color: Tokens.text-muted-brush;
            vertical-alignment: center;
            overflow: elide;
        }

        FocusScope {
            capture-key-pressed(event) => {
                if (event.text == Key.DownArrow) {
                    root.down();
                    return accept;
                }
                reject
            }

            input := TextInput {
                text: root.text;
                single-line: true;
                color: Tokens.text-brush;
                selection-background-color: Tokens.accent-pressed-color;
                selection-foreground-color: Tokens.on-accent-color;
                vertical-alignment: center;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted();
                }
            }
        }
    }

    FocusRing {
        focused: input.has-focus;
    }
}

export component AffixPickerPanel inherits FlyoutSurface {
    // The picker closed itself (used, cancelled or dismissed with Escape).
    callback done();

    function cancel() {
        ForgeState.cancel-picker();
        root.done();
    }

    function use-entry() {
        if (ForgeState.can-use-picker) {
            ForgeState.use-picker();
            root.done();
        }
    }

    // Left / Right (or Up / Down) on a kind filter moves to its neighbour, as a radio group does.
    function move-filter(delta: int) {
        let next = Math.clamp(ForgeState.picker-filter + delta, 0, 2);
        ForgeState.picker-filter-changed(next);
        if (next == 0) {
            all-kinds.focus-button();
        } else if (next == 1) {
            prefixes.focus-button();
        } else {
            suffixes.focus-button();
        }
    }

    // The entry last brought into view exactly, by the entry itself.
    property <int> revealed: -1;
    property <int> selected: ForgeState.picker-selected;

    // Keeps the selected entry in view as the keyboard moves it: exactly, from an entry the list has built.
    function reveal-entry(index: int, top: length, height: length) {
        root.revealed = index;
        if (top + list-scroll.content-y < 0) {
            list-scroll.content-y = -top;
        } else if (top + height + list-scroll.content-y > list-scroll.visible-height) {
            list-scroll.content-y = list-scroll.visible-height - top - height;
        }
    }

    // The list builds only the entries in view, so a selection outside them is first scrolled to where the average entry
    // puts it (as the standard ListView does); the entry, built there, then brings itself in exactly.
    changed selected => {
        if (root.selected >= 0 && root.selected != root.revealed && ForgeState.picker-rows.length > 0) {
            let average = list-scroll.content-height / ForgeState.picker-rows.length;
            let top = root.selected * average;
            if (top + list-scroll.content-y < 0) {
                list-scroll.content-y = -top;
            } else if (top + average + list-scroll.content-y > list-scroll.visible-height) {
                list-scroll.content-y = list-scroll.visible-height - top - average;
            }
        }
    }

    keys := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding-left: Tokens.flyout-padding.left;
            padding-right: Tokens.flyout-padding.right;
            padding-top: Tokens.flyout-padding.top;
            padding-bottom: Tokens.flyout-padding.bottom;
            spacing: Tokens.space-10;
            alignment: start;

            VerticalLayout {
                spacing: Tokens.space-2;

                Text {
                    text: ForgeState.picker-title;
                    font-size: Tokens.font-size-section;
                    font-weight: Tokens.emphasis-weight;
                    color: Tokens.text-brush;
                }

                Text {
                    text: ForgeState.picker-subtitle;
                    font-size: Tokens.font-size-caption;
                    color: Tokens.text-muted-brush;
                    wrap: word-wrap;
                }
            }

            search := SearchBox {
                text: ForgeState.picker-search;
                placeholder: "Name, category or ID";
                label: "Search affixes";
                init => {
                    self.focus-input();
                }
                edited(text) => {
                    ForgeState.picker-search-edited(text);
                }
                // Down leaves the search for the list; Enter in the search does nothing, so typing never picks.
                down => {
                    if (ForgeState.picker-rows.length > 0) {
                        if (ForgeState.picker-selected < 0) {
                            ForgeState.picker-select(0);
                        }
                        KeyboardFocus.visible = true;
                        list-focus.focus();
                    }
                }
            }

            VerticalLayout {
                spacing: Tokens.space-4;

                HorizontalLayout {
                    spacing: Tokens.space-12;
                    alignment: start;

                    all-kinds := RadioButton {
                        text: "All";
                        checked: ForgeState.picker-filter == 0;
                        chosen => {
                            ForgeState.picker-filter-changed(0);
                        }
                        arrow(delta) => {
                            root.move-filter(delta);
                        }
                    }

                    prefixes := RadioButton {
                        text: "Prefixes";
                        checked: ForgeState.picker-filter == 1;
                        chosen => {
                            ForgeState.picker-filter-changed(1);
                        }
                        arrow(delta) => {
                            root.move-filter(delta);
                        }
                    }

                    suffixes := RadioButton {
                        text: "Suffixes";
                        checked: ForgeState.picker-filter == 2;
                        chosen => {
                            ForgeState.picker-filter-changed(2);
                        }
                        arrow(delta) => {
                            root.move-filter(delta);
                        }
                    }
                }

                // The game's affix types and the classes, as two choices side by side.
                HorizontalLayout {
                    spacing: Tokens.space-8;

                    ChoiceBox {
                        label: "Affix kind";
                        choices: ForgeState.picker-categories;
                        index: ForgeState.picker-category;
                        chosen(index) => {
                            ForgeState.picker-category-changed(index);
                        }
                    }

                    ChoiceBox {
                        label: "Class";
                        choices: ForgeState.picker-classes;
                        index: ForgeState.picker-class;
                        chosen(index) => {
                            ForgeState.picker-class-changed(index);
                        }
                    }
                }

                VerticalLayout {
                    spacing: Tokens.space-2;

                    CheckBox {
                        text: "Allow incompatible affixes";
                        checked: ForgeState.picker-allow;
                        enabled: ForgeState.picker-allow-enabled;
                        toggled(on) => {
                            ForgeState.picker-allow-changed(on);
                        }
                    }

                    HorizontalLayout {
                        padding-left: Tokens.check-box-caption-margin.left;

                        Text {
                            text: "Also lists affixes this item or slot can't normally roll. Writing one needs \"I know what I'm doing\" in Settings.";
                            font-size: Tokens.font-size-caption;
                            color: Tokens.text-muted-brush;
                            wrap: word-wrap;
                            height: PickerMetrics.caption-line * 2;
                        }
                    }
                }
            }

            Rectangle {
                height: PickerMetrics.list-height(ForgeState.picker-rows.length);

                if ForgeState.picker-rows.length == 0: Text {
                    x: Tokens.empty-list-margin.left;
                    y: Tokens.empty-list-margin.top;
                    width: parent.width - Tokens.empty-list-margin.left - Tokens.empty-list-margin.right;
                    text: "No affixes match this search.";
                    color: Tokens.text-muted-brush;
                    wrap: word-wrap;
                }

                list-focus := FocusScope {
                    accessible-role: list;
                    accessible-label: "Replacement affixes";
                    focus-gained(reason) => {
                        if (reason == FocusReason.tab-navigation) {
                            KeyboardFocus.visible = true;
                        }
                    }
                    key-pressed(event) => {
                        if (event.text == Key.DownArrow) {
                            ForgeState.picker-select(Math.min(ForgeState.picker-rows.length - 1, ForgeState.picker-selected + 1));
                            return accept;
                        }
                        if (event.text == Key.UpArrow) {
                            if (ForgeState.picker-selected <= 0) {
                                search.focus-input();
                            } else {
                                ForgeState.picker-select(ForgeState.picker-selected - 1);
                            }
                            return accept;
                        }
                        if (event.text == Key.Return) {
                            root.use-entry();
                            return accept;
                        }
                        reject
                    }

                    // A ListView builds only the entries in view, so a search over the whole catalogue rebuilds a screenful
                    // rather than every affix. Each entry carries the 2px gap under it, as a ListView has no spacing.
                    list-scroll := ListView {
                        // The focus scope around it is the named list.
                        accessible-role: none;

                        for entry[index] in ForgeState.picker-rows: Rectangle {
                            property <bool> chosen: ForgeState.picker-selected == index;
                            property <length> entry-height: Math.max(PickerMetrics.row, entry-layout.preferred-height);
                            // An entry built or chosen while selected scrolls itself into view exactly, after the list's
                            // estimate brought it near (`reveal-index`).
                            init => {
                                if (self.chosen) {
                                    root.reveal-entry(index, self.y, self.entry-height);
                                }
                            }
                            changed chosen => {
                                if (self.chosen) {
                                    root.reveal-entry(index, self.y, self.entry-height);
                                }
                            }
                            height: self.entry-height + (index < ForgeState.picker-rows.length - 1 ? Tokens.space-2 : 0px);

                            Rectangle {
                                y: 0;
                                height: parent.entry-height;
                                border-radius: Tokens.control-radius;
                                border-width: 1px;
                                border-color: parent.chosen ? Tokens.accent-brush : transparent;
                                // The flyout's ground is the hover colour, so the entry under the pointer takes Wine-Stained
                                // Brown, as menu rows do; the chosen one adds the brass frame.
                                background: parent.chosen || entry-touch.has-hover ? Tokens.selected-brush : transparent;
                                accessible-role: list-item;
                                accessible-label: entry.name;
                                accessible-item-selected: parent.chosen;

                                entry-layout := VerticalLayout {
                                    padding-left: Tokens.row-padding.left;
                                    padding-right: Tokens.row-padding.right;
                                    padding-top: Tokens.catalog-entry-margin.top;
                                    padding-bottom: Tokens.catalog-entry-margin.bottom;
                                    spacing: Tokens.space-1;
                                    alignment: center;

                                    Text {
                                        text: entry.name;
                                        color: Tokens.text-brush;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: entry.detail;
                                        font-size: Tokens.font-size-caption;
                                        color: entry.reforged ? Tokens.reforged-affix-brush : Tokens.text-muted-brush;
                                        overflow: elide;
                                    }
                                }

                                entry-touch := TouchArea {
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            KeyboardFocus.visible = false;
                                        }
                                    }
                                    clicked => {
                                        ForgeState.picker-select(index);
                                        list-focus.focus();
                                    }
                                    double-clicked => {
                                        ForgeState.picker-select(index);
                                        root.use-entry();
                                    }
                                }

                                FocusRing {
                                    focused: list-focus.has-focus && ForgeState.picker-selected == index;
                                }
                            }
                        }
                    }
                }
            }

            Text {
                text: ForgeState.picker-status;
                font-size: Tokens.font-size-caption;
                color: Tokens.text-secondary-brush;
                wrap: word-wrap;
            }

            // Two equal halves: stretch alone shares only the space left after each button's own width.
            footer := HorizontalLayout {
                spacing: Tokens.space-8;

                Button {
                    in-flyout: true;
                    text: "Cancel";
                    tip: "Keep the current draft (Esc)";
                    width: (footer.width - footer.spacing) / 2;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    text: ForgeState.picker-action;
                    kind: ButtonKind.primary;
                    enabled: ForgeState.can-use-picker;
                    width: (footer.width - footer.spacing) / 2;
                    clicked => {
                        root.use-entry();
                    }
                }
            }
        }
    }

    // Tips raised in here, drawn over the flyout: the window's own bubble would lie under the popup.
    if Tip.open && Tip.in-flyout: TipBubble {
        window-width: root.width;
        window-height: root.height;
    }
}
