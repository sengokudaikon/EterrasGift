// The affix picker (DESIGN.md "Menus and Affix Picker"): replaces a row's affix as a draft, or adds one. The title and
// caption, the search, the filters with the ones in force as chips, the list, then the status, "Allow incompatible affixes"
// and Cancel and the primary in equal halves. The flyout keeps one size as it filters: the list takes what the rest
// leaves, and its rows are one fixed height, so a list of thousands scrolls without measuring them.
//
// A row's name and pills are all it shows; the rest is its tip. The pointer raises the tip by resting on the row (on its
// (?) in a narrow window, where a tip would hide the short list), and the keyboard by moving the selection to it.

import { ListView } from "../../widgets/scroll-view.slint";
import { Tokens } from "../../tokens.slint";
import { KeyboardFocus, Tip, WindowSize } from "../../globals.slint";
import { Button, ButtonKind } from "../../widgets/button.slint";
import { FocusRing, TipBubble, TipTrigger } from "../../widgets/focus.slint";
import { FlyoutSurface } from "../../widgets/menu.slint";
import { ChoiceBox } from "../../widgets/choice-box.slint";
import { MultiChoiceBox } from "../../widgets/multi-choice-box.slint";
import { ForgeState } from "state.slint";
import { ForgeText } from "../../strings/forge.slint";
import { CheckBox } from "../../widgets/check-box.slint";
import { HelpButton } from "../../widgets/help-button.slint";
import { FilterChip, Pill } from "../../widgets/pill.slint";
import { SearchBox } from "../../widgets/search-box.slint";

export global PickerMetrics {
    out property <length> caption-line: Tokens.font-size-caption * 4 / 3;
    // A narrow window gets the short flyout: its filters folded and its rows' tips behind a (?).
    out property <bool> narrow: WindowSize.width < Tokens.narrow-window-width;
    out property <length> width: (self.narrow ? Tokens.replace-flyout-width : Tokens.affix-picker-width) + Tokens.flyout-padding.left + Tokens.flyout-padding.right;
    // A PopupWindow needs a size and is clipped to the window, so this keeps it inside.
    out property <length> height: WindowSize.height > 0 ? Math.min(Tokens.affix-picker-height, WindowSize.height - 2 * Tokens.affix-picker-window-margin) : Tokens.affix-picker-height;
}

export component AffixPickerPanel inherits FlyoutSurface {
    // The picker closed itself (used, cancelled or dismissed with Escape).
    callback done();

    // A tip left from the last time the picker was open has no row to answer to.
    init => {
        Tip.open = false;
    }

    function close-tip() {
        if (Tip.in-flyout) {
            Tip.open = false;
        }
    }

    function cancel() {
        root.close-tip();
        ForgeState.cancel-picker();
        root.done();
    }

    function use-entry() {
        if (ForgeState.can-use-picker) {
            root.close-tip();
            ForgeState.use-picker();
            root.done();
        }
    }

    // The filter grid: folded behind Filters in a narrow window, unfolded otherwise.
    property <bool> filters-open: !PickerMetrics.narrow;

    // The entry last brought into view exactly, by the entry itself.
    property <int> revealed: -1;
    property <int> selected: ForgeState.picker-selected;
    property <int> row-count: ForgeState.picker-rows.length;

    // Keeps the selected entry in view as the keyboard moves it: exactly, from an entry the list has built.
    function reveal-entry(index: int, top: length, height: length) {
        root.revealed = index;
        if (top + list-scroll.content-y < 0) {
            list-scroll.content-y = -top;
        } else if (top + height + list-scroll.content-y > list-scroll.visible-height) {
            list-scroll.content-y = list-scroll.visible-height - top - height;
        }
    }

    // The list builds only the entries in view, so a selection outside them is first scrolled to where its row lies; the
    // entry, built there, then brings itself in exactly.
    function reveal-selected() {
        if (root.selected >= 0 && root.row-count > 0) {
            let row = list-scroll.content-height / root.row-count;
            let top = root.selected * row;
            if (top + list-scroll.content-y < 0) {
                list-scroll.content-y = -top;
            } else if (top + row + list-scroll.content-y > list-scroll.visible-height) {
                list-scroll.content-y = list-scroll.visible-height - top - row;
            }
        }
    }

    changed selected => {
        if (root.selected != root.revealed) {
            root.reveal-selected();
        }
    }
    // Another list starts from its top, or from what stays selected in it.
    changed row-count => {
        root.close-tip();
        list-scroll.content-y = 0;
        root.reveal-selected();
    }

    keys := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding-left: Tokens.flyout-padding.left;
            padding-right: Tokens.flyout-padding.right;
            padding-top: Tokens.flyout-padding.top;
            padding-bottom: Tokens.flyout-padding.bottom;
            spacing: Tokens.space-8;

            VerticalLayout {
                spacing: Tokens.space-2;

                Text {
                    text: ForgeState.picker-title;
                    font-size: Tokens.font-size-section;
                    font-weight: Tokens.emphasis-weight;
                    color: Tokens.text-brush;
                }

                Text {
                    text: ForgeState.picker-subtitle;
                    font-size: Tokens.font-size-caption;
                    color: Tokens.text-muted-brush;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: Tokens.space-8;

                search := SearchBox {
                    text: ForgeState.picker-search;
                    placeholder: ForgeText.affix-search-placeholder;
                    label: ForgeText.affix-search;
                    horizontal-stretch: 1;
                    init => {
                        self.focus-input();
                    }
                    edited(text) => {
                        ForgeState.picker-search-edited(text);
                    }
                    // Down leaves the search for the list; Enter in the search does nothing, so typing never picks.
                    down => {
                        if (ForgeState.picker-rows.length > 0) {
                            if (ForgeState.picker-selected < 0) {
                                ForgeState.picker-select(0);
                            }
                            KeyboardFocus.visible = true;
                            list-focus.focus();
                        }
                    }
                }

                if PickerMetrics.narrow: Button {
                    in-flyout: true;
                    text: ForgeText.filters;
                    tip: ForgeText.filters-tip;
                    horizontal-stretch: 0;
                    clicked => {
                        root.close-tip();
                        root.filters-open = !root.filters-open;
                    }
                }
            }

            // The filters on a grid of equal cells, so each sits where it did as their words change. Its choices say what
            // they filter when they hold no choice ("Any slot"); one off its default takes the selected ground in its brass frame.
            if root.filters-open: Rectangle {
                property <int> columns: PickerMetrics.narrow ? 2 : 4;
                property <length> gap: Tokens.space-4;
                property <length> cell: (self.width - (self.columns - 1) * self.gap) / self.columns;
                pure function at-x(index: int) -> length {
                    return Math.mod(index, self.columns) * (self.cell + self.gap);
                }
                pure function at-y(index: int) -> length {
                    return Math.floor(index / self.columns) * (Tokens.control-min-height + self.gap);
                }

                height: self.at-y(6) + Tokens.control-min-height;

                ChoiceBox {
                    x: parent.at-x(0);
                    y: parent.at-y(0);
                    width: parent.cell;
                    label: ForgeText.slot;
                    choices: ForgeState.picker-slots;
                    index: ForgeState.picker-slot;
                    fallback-text: ForgeState.picker-slot-text;
                    active: ForgeState.picker-slot-active;
                    chosen(index) => {
                        ForgeState.picker-slot-changed(index);
                    }
                }

                ChoiceBox {
                    x: parent.at-x(1);
                    y: parent.at-y(1);
                    width: parent.cell;
                    label: ForgeText.level;
                    choices: ForgeState.picker-levels;
                    index: ForgeState.picker-level;
                    active: ForgeState.picker-level > 0;
                    chosen(index) => {
                        ForgeState.picker-level-changed(index);
                    }
                }

                ChoiceBox {
                    x: parent.at-x(2);
                    y: parent.at-y(2);
                    width: parent.cell;
                    label: ForgeText.source;
                    choices: ForgeState.picker-sources;
                    index: ForgeState.picker-source;
                    fallback-text: ForgeState.picker-source-text;
                    active: ForgeState.picker-source-active;
                    chosen(index) => {
                        ForgeState.picker-source-changed(index);
                    }
                }

                MultiChoiceBox {
                    x: parent.at-x(3);
                    y: parent.at-y(3);
                    width: parent.cell;
                    label: ForgeText.stat-tags;
                    choices: ForgeState.picker-tags;
                    checked: ForgeState.picker-tags-on;
                    summary: ForgeState.picker-tags-text;
                    active: ForgeState.picker-tags-active;
                    toggled(index, on) => {
                        ForgeState.picker-tag-toggled(index, on);
                    }
                }

                ChoiceBox {
                    x: parent.at-x(4);
                    y: parent.at-y(4);
                    width: parent.cell;
                    label: ForgeText.side;
                    choices: ForgeState.picker-sides;
                    index: ForgeState.picker-filter;
                    active: ForgeState.picker-filter > 0;
                    chosen(index) => {
                        ForgeState.picker-filter-changed(index);
                    }
                }

                ChoiceBox {
                    x: parent.at-x(5);
                    y: parent.at-y(5);
                    width: parent.cell;
                    label: ForgeText.affix-kind;
                    choices: ForgeState.picker-categories;
                    index: ForgeState.picker-category;
                    active: ForgeState.picker-category > 0;
                    chosen(index) => {
                        ForgeState.picker-category-changed(index);
                    }
                }

                ChoiceBox {
                    x: parent.at-x(6);
                    y: parent.at-y(6);
                    width: parent.cell;
                    label: ForgeText.class;
                    choices: ForgeState.picker-classes;
                    index: ForgeState.picker-class;
                    active: ForgeState.picker-class > 0;
                    chosen(index) => {
                        ForgeState.picker-class-changed(index);
                    }
                }
            }

            // The filters in force: each chip clears its own. One line; a row out of room shrinks them, their words in the tip.
            if ForgeState.picker-chips.length > 0: HorizontalLayout {
                spacing: Tokens.space-4;
                alignment: start;

                for chip[index] in ForgeState.picker-chips: FilterChip {
                    text: chip;
                    tip: ForgeText.remove-filter(chip);
                    removable: true;
                    in-flyout: true;
                    clicked => {
                        ForgeState.picker-chip-removed(index);
                        if (index >= ForgeState.picker-chips.length) {
                            search.focus-input();
                        }
                    }
                }
            }

            // How many are listed, the offer of what the default Source holds back, and the way back to the defaults.
            HorizontalLayout {
                spacing: Tokens.space-8;
                height: Tokens.pill-chip-height;

                Text {
                    text: ForgeState.picker-count;
                    font-size: Tokens.font-size-caption;
                    color: Tokens.text-secondary-brush;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                if ForgeState.picker-hidden != "": FilterChip {
                    text: ForgeState.picker-hidden;
                    tip: ForgeText.show-uniques-tip;
                    in-flyout: true;
                    clicked => {
                        ForgeState.picker-show-uniques();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if ForgeState.picker-chips.length > 0 && ForgeState.picker-rows.length > 0: FilterChip {
                    text: ForgeText.clear-filters;
                    in-flyout: true;
                    clicked => {
                        ForgeState.picker-clear-filters();
                        search.focus-input();
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: Tokens.affix-picker-list-min-height;

                list-focus := FocusScope {
                    accessible-role: list;
                    accessible-label: ForgeText.replacement-affixes;
                    focus-gained(reason) => {
                        if (reason == FocusReason.tab-navigation) {
                            KeyboardFocus.visible = true;
                        }
                    }
                    key-pressed(event) => {
                        if (event.text == Key.DownArrow) {
                            ForgeState.picker-select(Math.min(ForgeState.picker-rows.length - 1, ForgeState.picker-selected + 1));
                            return accept;
                        }
                        if (event.text == Key.UpArrow) {
                            if (ForgeState.picker-selected <= 0) {
                                search.focus-input();
                            } else {
                                ForgeState.picker-select(ForgeState.picker-selected - 1);
                            }
                            return accept;
                        }
                        if (event.text == Key.Return) {
                            root.use-entry();
                            return accept;
                        }
                        reject
                    }

                    // A ListView builds only the entries in view, so a search over the whole catalogue rebuilds a screenful
                    // rather than every affix. Each entry carries the gap under it, as a ListView has no spacing.
                    list-scroll := ListView {
                        // The focus scope around it is the named list.
                        accessible-role: none;

                        for entry[index] in ForgeState.picker-rows: Rectangle {
                            property <bool> chosen: ForgeState.picker-selected == index;
                            // An entry built or chosen while selected scrolls itself into view exactly, after the list's
                            // estimate brought it near (`reveal-selected`).
                            init => {
                                if (self.chosen) {
                                    root.reveal-entry(index, self.y, Tokens.affix-picker-row-height);
                                }
                            }
                            changed chosen => {
                                if (self.chosen) {
                                    root.reveal-entry(index, self.y, Tokens.affix-picker-row-height);
                                }
                            }
                            height: Tokens.affix-picker-row-height + (index < ForgeState.picker-rows.length - 1 ? Tokens.space-2 : 0px);

                            Rectangle {
                                y: 0;
                                height: Tokens.affix-picker-row-height;
                                border-radius: Tokens.control-radius;
                                border-width: 1px;
                                border-color: parent.chosen ? Tokens.accent-brush : transparent;
                                // The flyout's ground is the hover colour, so the entry under the pointer takes Wine-Stained
                                // Brown, as menu rows do; the chosen one adds the brass frame.
                                background: parent.chosen || entry-touch.has-hover ? Tokens.selected-brush : transparent;
                                accessible-role: list-item;
                                accessible-label: entry.name;
                                accessible-description: entry.spoken;
                                accessible-item-selected: parent.chosen;

                                // A (?) keeps this much of a narrow row's right end, clear of the scroll bar that opens over it.
                                property <length> help-room: PickerMetrics.narrow ? Tokens.icon-size-small + Tokens.compact-icon-button-padding.left + Tokens.compact-icon-button-padding.right + Tokens.scroll-bar-size : 0px;

                                Text {
                                    x: Tokens.row-padding.left;
                                    y: Tokens.space-6;
                                    width: parent.width - Tokens.row-padding.left - Tokens.row-padding.right - parent.help-room;
                                    height: Tokens.affix-picker-name-height;
                                    text: entry.name;
                                    color: Tokens.text-brush;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    x: Tokens.row-padding.left;
                                    y: Tokens.space-6 + Tokens.affix-picker-name-height + Tokens.space-4;
                                    width: parent.width - Tokens.row-padding.left - Tokens.row-padding.right - parent.help-room;
                                    height: Tokens.pill-height;
                                    spacing: Tokens.space-4;
                                    alignment: start;

                                    for pill in entry.pills: Pill {
                                        text: pill.text;
                                        tone: pill.tone;
                                    }
                                }

                                entry-touch := TouchArea {
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            KeyboardFocus.visible = false;
                                        }
                                    }
                                    clicked => {
                                        ForgeState.picker-select(index);
                                        list-focus.focus();
                                    }
                                    double-clicked => {
                                        ForgeState.picker-select(index);
                                        root.use-entry();
                                    }
                                }

                                if PickerMetrics.narrow: HelpButton {
                                    x: parent.width - self.width - Tokens.scroll-bar-size;
                                    y: (parent.height - self.height) / 2;
                                    help: entry.detail;
                                    label: ForgeText.about-affix(entry.name);
                                    in-flyout: true;
                                    tab-stop: false;
                                }

                                // Over the row's right part, so its tip hangs clear of the names the pointer runs down.
                                TipTrigger {
                                    x: parent.width * 0.4;
                                    width: parent.width * 0.6;
                                    text: entry.detail;
                                    hovered: !PickerMetrics.narrow && entry-touch.has-hover;
                                    focused: list-focus.has-focus && ForgeState.picker-selected == index;
                                    in-flyout: true;
                                }

                                FocusRing {
                                    focused: list-focus.has-focus && ForgeState.picker-selected == index;
                                }
                            }
                        }
                    }
                }

                // Why the list is empty, and the ways out it has.
                if ForgeState.picker-rows.length == 0: VerticalLayout {
                    x: Tokens.empty-list-margin.left;
                    y: Tokens.empty-list-margin.top;
                    width: parent.width - Tokens.empty-list-margin.left - Tokens.empty-list-margin.right;
                    alignment: start;
                    spacing: Tokens.space-8;

                    Text {
                        text: ForgeState.picker-empty-reason;
                        color: Tokens.text-secondary-brush;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-8;

                        if ForgeState.picker-empty-clear-search: Button {
                            in-flyout: true;
                            text: ForgeText.clear-search;
                            clicked => {
                                search.clear();
                            }
                        }

                        if ForgeState.picker-empty-clear-filters: Button {
                            in-flyout: true;
                            text: ForgeText.clear-filters;
                            clicked => {
                                ForgeState.picker-clear-filters();
                                search.focus-input();
                            }
                        }
                    }

                    if ForgeState.picker-empty-allow: HorizontalLayout {
                        alignment: start;

                        Button {
                            in-flyout: true;
                            text: ForgeText.list-incompatible;
                            tip: ForgeText.picker-allow-note;
                            clicked => {
                                ForgeState.picker-allow-changed(true);
                                search.focus-input();
                            }
                        }
                    }
                }
            }

            Text {
                text: ForgeState.picker-status;
                font-size: Tokens.font-size-caption;
                color: Tokens.text-secondary-brush;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Tokens.space-6;
                alignment: start;

                CheckBox {
                    text: ForgeText.allow-incompatible;
                    checked: ForgeState.picker-allow;
                    enabled: ForgeState.picker-allow-enabled;
                    toggled(on) => {
                        ForgeState.picker-allow-changed(on);
                    }
                }

                HelpButton {
                    y: (parent.height - self.height) / 2;
                    help: ForgeText.picker-allow-note;
                    label: ForgeText.about-allow-incompatible;
                    in-flyout: true;
                }
            }

            // Two equal halves: stretch alone shares only the space left after each button's own width.
            footer := HorizontalLayout {
                spacing: Tokens.space-8;

                Button {
                    in-flyout: true;
                    text: ForgeText.cancel;
                    tip: ForgeText.keep-draft-tip;
                    width: (footer.width - footer.spacing) / 2;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    text: ForgeState.picker-action;
                    kind: ButtonKind.primary;
                    enabled: ForgeState.can-use-picker;
                    width: (footer.width - footer.spacing) / 2;
                    clicked => {
                        root.use-entry();
                    }
                }
            }
        }
    }

    // Tips raised in here, drawn over the flyout: the window's own bubble would lie under the popup.
    if Tip.open && Tip.in-flyout: TipBubble {
        window-width: root.width;
        window-height: root.height;
    }
}
