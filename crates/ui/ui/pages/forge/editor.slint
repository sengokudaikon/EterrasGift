// The Item Forge, the Forge page's Item section: the item header, the
// implicits, the affix table, the unique modifiers, the changes pane and the action bar. Window classes restructure it:
// narrow lays the pane over the table, wide adds the Range column and caps the table at 1000px, and from 1180px of lists
// the column beside the table holds the unique modifiers or the selected affix's tier ladder.

import { Tokens } from "../../tokens.slint";
import { KeyboardFocus } from "../../globals.slint";
import { CellKind, ForgeCover, ForgeState } from "state.slint";
import { ForgeText } from "../../strings/forge.slint";
import { ChangesPane } from "pane.slint";
import { ForgeHeader } from "header.slint";
import { ForgeLists } from "lists.slint";
import { ForgeBar } from "bar.slint";

export component ItemForge inherits Rectangle {
    in property <bool> compact;
    in property <bool> narrow;
    in property <bool> wide;

    // The forge keeps the 24px gutter at every class, compact included.
    property <length> gutter: Tokens.page-gutter.left;
    property <length> pane-width: root.wide ? Tokens.changes-pane-wide-width : root.compact ? Tokens.changes-pane-compact-width : Tokens.changes-pane-width;
    // A narrow window has no column for the pane: the table takes the whole width and the pane lies over it.
    property <length> lists-column: root.narrow ? root.width : root.width - root.pane-width;
    property <length> lists-width: Math.max(0px, root.lists-column - 2 * root.gutter);
    // Rust asks for a header cell (Show draft on the identity), or a row asks to be scrolled into view.
    property <int> serial: ForgeState.focus-target.serial;

    // The pane starts closed in a narrow window, closes on the way into narrow and opens again on the way out. The class it
    // last followed lives in ForgeState, so an item swap that rebuilds this view keeps the user's choice.
    function follow-class() {
        if (!ForgeState.pane-class-known || ForgeState.pane-narrow != root.narrow) {
            if (ForgeState.pane-class-known || root.narrow) {
                ForgeState.pane-open = !root.narrow;
            }
            ForgeState.pane-class-known = true;
            ForgeState.pane-narrow = root.narrow;
        }
    }

    // While the pane lies over the table, the cells under it leave the Tab order (ForgeCover).
    property <bool> covering: root.narrow && ForgeState.pane-open;
    property <length> cover-left: root.absolute-position.x + root.width - root.pane-width;
    property <length> cover-top: root.absolute-position.y + header.height;

    function follow-cover() {
        ForgeCover.set(root.covering, root.cover-left, root.cover-top);
    }

    init => {
        root.follow-class();
        root.follow-cover();
    }
    changed narrow => {
        root.follow-class();
    }
    changed covering => {
        root.follow-cover();
    }
    changed cover-left => {
        root.follow-cover();
    }
    changed cover-top => {
        root.follow-cover();
    }

    changed serial => {
        if (ForgeState.focus-target.cell.kind == CellKind.field && ForgeState.focus-target.cell.row == -1 && ForgeState.focus-target.part == 5) {
            KeyboardFocus.visible = true;
            header.focus-identity();
        }
    }

    // Hidden measures, in a box of no size so their sizes never reach the page's own layout.
    Rectangle {
        width: 0;
        height: 0;
        visible: false;

        // The status strip on one line, measured: the wrapping layout reports the height of more lines than it lays out.
        strip-measure := HorizontalLayout {
            spacing: Tokens.space-24;

            for field in ForgeState.fields: Rectangle {
                preferred-width: field.numeric ? Tokens.status-cell-width
                    : Math.max(measured-off.preferred-width, measured-on.preferred-width) + Tokens.flag-padding.left + Tokens.flag-padding.right + 2px;
                preferred-height: field.numeric
                    ? measured-label.preferred-height + Tokens.space-2 + measured-number.preferred-height + Tokens.space-4 + Tokens.range-bar-height
                    : measured-on.preferred-height + Tokens.flag-padding.top + Tokens.flag-padding.bottom + 2px;

                measured-label := Text {
                    text: field.name;
                }

                measured-number := Text {
                    text: field.value.display;
                    font-size: Tokens.font-size-value;
                }

                measured-off := Text {
                    text: field.off-name;
                }

                measured-on := Text {
                    text: field.on-name;
                }
            }
        }


        // The Range column takes the widest range of the rows, as a shared size group does.
        range-measure := VerticalLayout {

            Text {
                text: ForgeText.range;
            }

            for affix in ForgeState.affixes: Text {
                text: affix.range;
                font-size: Tokens.font-size-caption;
            }
        }
    }
    property <bool> strip-one-line: strip-measure.preferred-width <= root.width - 2 * root.gutter;

    page-keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                ForgeState.undo-draft();
                return accept;
            }
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                ForgeState.apply();
                return accept;
            }
            reject
        }

        // The header: the name in its rarity colour, the facts line, then the status strip.
        header := ForgeHeader {
            x: root.gutter;
            y: 0;
            width: root.width - 2 * root.gutter;
            height: self.preferred-height;
            strip-one-line: root.strip-one-line;
            strip-height: strip-measure.preferred-height;
            cell-input: ForgeState.cell-input;
            focus-target: ForgeState.focus-target;
            cell-acted(a0, a1, a2) => { ForgeState.cell-acted(a0, a1, a2); }
            begin-input(a0) => { return ForgeState.begin-input(a0); }
            input-edited(a0, a1) => { ForgeState.input-edited(a0, a1); }
            commit-input(a0) => { return ForgeState.commit-input(a0); }
            base-allow(a0) => { ForgeState.base-allow(a0); }
            base-allow-incompatible: ForgeState.base-allow-incompatible;
            base-can-edit: ForgeState.base-can-edit;
            base-drafted: ForgeState.base-drafted;
            base-options: ForgeState.base-options;
            base-text: ForgeState.base-text;
            base-tip: ForgeState.base-tip;
            can-change-base: ForgeState.can-change-base;
            can-change-identity: ForgeState.can-change-identity;
            can-change-rarity: ForgeState.can-change-rarity;
            fields: ForgeState.fields;
            has-identity: ForgeState.has-identity;
            identity-drafted: ForgeState.identity-drafted;
            identity-options: ForgeState.identity-options;
            identity-search: ForgeState.identity-search;
            identity-search-edited(a0) => { ForgeState.identity-search-edited(a0); }
            identity-tip: ForgeState.identity-tip;
            item-name: ForgeState.item-name;
            name-rarity: ForgeState.name-rarity;
            option-start(a0) => { return ForgeState.option-start(a0); }
            option-step(a0, a1, a2) => { return ForgeState.option-step(a0, a1, a2); }
            pick-base(a0) => { ForgeState.pick-base(a0); }
            pick-identity(a0) => { ForgeState.pick-identity(a0); }
            pick-rarity(a0) => { ForgeState.pick-rarity(a0); }
            rarity-caption-lines: ForgeState.rarity-caption-lines;
            rarity-drafted: ForgeState.rarity-drafted;
            rarity-options: ForgeState.rarity-options;
            rarity-text: ForgeState.rarity-text;
            rarity-tip: ForgeState.rarity-tip;
            summary: ForgeState.summary;
            toggle-flag(a0, a1) => { ForgeState.toggle-flag(a0, a1); }
        }

        lists := ForgeLists {
            x: root.gutter;
            y: header.height;
            width: root.lists-width;
            height: bar.y - header.height;
            wide: root.wide;
            lists-width: root.lists-width;
            range-width: range-measure.preferred-width;
            page-bottom: root.absolute-position.y + root.height;
            cell-input: ForgeState.cell-input;
            focus-target: ForgeState.focus-target;
            cell-acted(a0, a1, a2) => { ForgeState.cell-acted(a0, a1, a2); }
            begin-input(a0) => { return ForgeState.begin-input(a0); }
            input-edited(a0, a1) => { ForgeState.input-edited(a0, a1); }
            commit-input(a0) => { return ForgeState.commit-input(a0); }
            picker: ForgeState.picker;
            open-add() => { return ForgeState.open-add(); }
            open-replace(a0) => { return ForgeState.open-replace(a0); }
            picker-search-edited(a0) => { ForgeState.picker-search-edited(a0); }
            picker-filter-changed(a0, a1, a2) => { ForgeState.picker-filter-changed(a0, a1, a2); }
            picker-select(a0) => { ForgeState.picker-select(a0); }
            use-picker() => { ForgeState.use-picker(); }
            cancel-picker() => { ForgeState.cancel-picker(); }
            add-affix-tip: ForgeState.add-affix-tip;
            affix-list-note: ForgeState.affix-list-note;
            affixes: ForgeState.affixes;
            can-change-affix-list: ForgeState.can-change-affix-list;
            can-max-rolls: ForgeState.can-max-rolls;
            can-max-tiers: ForgeState.can-max-tiers;
            discard-row(a0) => { ForgeState.discard-row(a0); }
            formatting-error: ForgeState.formatting-error;
            formatting-loading: ForgeState.formatting-loading;
            has-implicits: ForgeState.has-implicits;
            has-item: ForgeState.has-item;
            has-templates: ForgeState.has-templates;
            has-unique: ForgeState.has-unique;
            implicit-note: ForgeState.implicit-note;
            implicit-preview: ForgeState.implicit-preview;
            implicit-preview-draft: ForgeState.implicit-preview-draft;
            implicit-rows-shown: ForgeState.implicit-rows-shown;
            implicits: ForgeState.implicits;
            ladder-note: ForgeState.ladder-note;
            max-rolls() => { ForgeState.max-rolls(); }
            max-rolls-tip: ForgeState.max-rolls-tip;
            max-tiers() => { ForgeState.max-tiers(); }
            max-tiers-tip: ForgeState.max-tiers-tip;
            move-implicit(a0, a1, a2) => { ForgeState.move-implicit(a0, a1, a2); }
            move-row(a0, a1, a2) => { ForgeState.move-row(a0, a1, a2); }
            move-unique(a0, a1, a2) => { ForgeState.move-unique(a0, a1, a2); }
            pick-seal(a0, a1) => { ForgeState.pick-seal(a0, a1); }
            pick-tier(a0, a1) => { ForgeState.pick-tier(a0, a1); }
            preview-failed: ForgeState.preview-failed;
            preview-stale: ForgeState.preview-stale;
            preview-status: ForgeState.preview-status;
            remove-affix(a0) => { ForgeState.remove-affix(a0); }
            select-affix(a0) => { ForgeState.select-affix(a0); }
            select-unique(a0) => { ForgeState.select-unique(a0); }
            selected-affix: ForgeState.selected-affix;
            selected-unique: ForgeState.selected-unique;
            template-apply(a0) => { ForgeState.template-apply(a0); }
            template-delete(a0) => { ForgeState.template-delete(a0); }
            template-name: ForgeState.template-name;
            template-name-edited(a0) => { ForgeState.template-name-edited(a0); }
            template-message: ForgeState.template-message;
            template-replaces: ForgeState.template-replaces;
            template-rows: ForgeState.template-rows;
            template-save(a0, a1) => { ForgeState.template-save(a0, a1); }
            templates-opened() => { ForgeState.templates-opened(); }
            unique-modifiers: ForgeState.unique-modifiers;
        }

        // The changes pane: beside the table, keeping its column when hidden; in a narrow window over the table's right side,
        // where Escape closes it and gives focus back to the Changes toggle.
        if ForgeState.pane-open: ChangesPane {
            discard-entry(a0) => { ForgeState.discard-entry(a0); }
            draft-count-text: ForgeState.draft-count-text;
            drafts: ForgeState.drafts;
            history: ForgeState.history;
            show-draft(a0) => { ForgeState.show-draft(a0); }
            x: root.width - root.pane-width;
            y: header.height;
            width: root.pane-width;
            height: bar.y - header.height;
            overlay: root.narrow;
            dismissed => {
                KeyboardFocus.visible = true;
                bar.focus-changes();
                ForgeState.pane-open = false;
            }
        }

        // The action bar: the message with one icon for its kind, then Changes, Undo, Discard and Apply.
        bar := ForgeBar {
            x: 0;
            y: root.height - self.height;
            width: root.width;
            apply() => { ForgeState.apply(); }
            apply-text: ForgeState.apply-text;
            can-apply: ForgeState.can-apply;
            can-discard: ForgeState.can-discard;
            can-undo: ForgeState.can-undo;
            changes-text: ForgeState.changes-text;
            discard-all() => { ForgeState.discard-all(); }
            discard-text: ForgeState.discard-text;
            drafts: ForgeState.drafts;
            message: ForgeState.message;
            message-tone: ForgeState.message-tone;
            pane-open <=> ForgeState.pane-open;
            undo() => { ForgeState.undo(); }
            undo-text: ForgeState.undo-text;
            undo-tip: ForgeState.undo-tip;
        }
    }
}
