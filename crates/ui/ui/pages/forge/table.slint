// The affix table's rows, the tier and seal menus, and the modifier rows shared by implicits and unique modifiers
// (DESIGN.md "Rows", "In-place Cells", "Implicits", "Unique Modifiers").

import { Tokens } from "../../tokens.slint";
import { KeyboardFocus } from "../../globals.slint";
import { FocusRing, TipTrigger } from "../../widgets/focus.slint";
import { FlyoutSurface, PopupMenu } from "../../widgets/menu.slint";
import { AffixRowView, CellKind, CellRef, ForgeReveal, ModifierRowView, PickerRowView, TierOption } from "state.slint";
import { ValueScrubber } from "scrubber.slint";
import { ForgeText } from "../../strings/forge.slint";

// The confirm settle's curve, in one place: Fluent's decelerate (cubic out). An easing can't be a public property in
// Slint 1.18, so it lives in this file's own global rather than in the generated Tokens.
global Settle {
    out property <easing> curve: cubic-bezier(0.215, 0.61, 0.355, 1);
}
import { CellButton, MenuRow } from "cells.slint";
import { AffixPickerPanel, PickerMetrics } from "picker.slint";

// The tiers as menu rows: "T5", its range in the game's format, "in game" on the tier the game holds.
export component TierList inherits VerticalLayout {
    in property <[TierOption]> tiers;
    in property <int> held: -1;
    in property <int> highlighted: -1;
    in property <bool> enabled: true;
    in property <bool> on-flyout: true;
    callback picked(int);

    spacing: Tokens.space-2;

    for tier[index] in root.tiers: MenuRow {
        held: root.held == index;
        highlighted: root.highlighted == index;
        enabled: root.enabled;
        on-flyout: root.on-flyout;
        picked => {
            root.picked(index);
        }

        Text {
            text: tier.label;
            font-size: Tokens.font-size-value;
            color: Tokens.text-brush;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }

        Text {
            text: tier.range;
            font-size: Tokens.font-size-body;
            color: Tokens.text-muted-brush;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if tier.in-game: Text {
            text: ForgeText.in-game;
            font-size: Tokens.font-size-caption;
            color: Tokens.text-secondary-brush;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
}

// The tier ladder beside the table: the tiers as a list that takes the keyboard, Up and Down drafting the neighbouring
// tier as a press does.
export component TierLadder inherits Rectangle {
    in property <[TierOption]> tiers;
    in property <int> held: -1;
    in property <bool> enabled: true;
    in property <string> label;
    callback picked(int);

    accessible-role: AccessibleRole.list;
    accessible-label: root.label;

    height: ladder-list.preferred-height;

    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) {
                KeyboardFocus.visible = true;
            }
        }
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                return reject;
            }
            if (event.text == Key.UpArrow) {
                if (root.held > 0) {
                    root.picked(root.held - 1);
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.held < root.tiers.length - 1) {
                    root.picked(Math.max(0, root.held + 1));
                }
                return accept;
            }
            reject
        }

        ladder-list := TierList {
            tiers: root.tiers;
            held: root.held;
            enabled: root.enabled;
            on-flyout: false;
            picked(index) => {
                focus.focus();
                root.picked(index);
            }
        }
    }

    FocusRing {
        focused: focus.has-focus;
    }
}

// A menu flyout's frame: the flyout surface, the app's padding, keyboard Up/Down/Enter/Escape.
export component MenuFrame inherits FlyoutSurface {
    in property <int> count;
    in-out property <int> highlighted;
    callback chosen(int);
    callback dismissed();

    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                KeyboardFocus.visible = true;
                root.highlighted = Math.max(0, root.highlighted - 1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                KeyboardFocus.visible = true;
                root.highlighted = Math.min(root.count - 1, root.highlighted + 1);
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") {
                root.chosen(root.highlighted);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding-left: Tokens.flyout-padding.left;
            padding-right: Tokens.flyout-padding.right;
            padding-top: Tokens.flyout-padding.top;
            padding-bottom: Tokens.flyout-padding.bottom;

            @children
        }
    }
}

// The height of a flyout of `rows` menu rows: 30px rows 2px apart inside the flyout padding.
export global MenuMetrics {
    out property <length> row: Tokens.font-size-value * 4 / 3 + Tokens.cell-padding.top + Tokens.cell-padding.bottom + 2px;

    public pure function height(rows: int) -> length {
        return rows * self.row + Math.max(0, rows - 1) * Tokens.space-2 + Tokens.flyout-padding.top + Tokens.flyout-padding.bottom + 2px;
    }
}

// One affix: [value | name over type | range at wide | tier | seal | status]. Touching any cell selects the row.
export component AffixRowItem inherits Rectangle {
    // From the page: what this shows and what it asks of it.
    callback begin-input(CellRef) -> bool;
    in property <bool> can-change-affix-list;
    in property <bool> can-use-picker;
    callback cancel-input(CellRef);
    callback cancel-picker();
    callback commit-input(CellRef) -> bool;
    callback discard-row(int);
    callback end-scrub(CellRef, bool);
    callback finish-input(CellRef);
    in property <CellRef> focus-cell;
    in property <int> focus-part;
    in property <int> focus-serial;
    callback input-edited(CellRef, string);
    in property <string> input-error;
    in property <string> input-label;
    in property <string> input-range;
    in-out property <string> input-text;
    callback move-row(int, int, int);
    callback open-replace(int) -> bool;
    callback pick-seal(int, int);
    callback pick-tier(int, int);
    in property <string> picker-action;
    in property <bool> picker-allow;
    callback picker-allow-changed(bool);
    in property <bool> picker-allow-enabled;
    in property <[string]> picker-categories;
    in property <int> picker-category;
    callback picker-category-changed(int);
    callback picker-chip-removed(int);
    in property <[string]> picker-chips;
    in property <int> picker-class;
    callback picker-class-changed(int);
    in property <[string]> picker-classes;
    callback picker-clear-filters();
    in property <string> picker-count;
    in property <bool> picker-empty-allow;
    in property <bool> picker-empty-clear-filters;
    in property <bool> picker-empty-clear-search;
    in property <string> picker-empty-reason;
    in property <int> picker-filter;
    callback picker-filter-changed(int);
    in property <string> picker-hidden;
    in property <int> picker-level;
    callback picker-level-changed(int);
    in property <[string]> picker-levels;
    in property <bool> picker-open;
    in property <[PickerRowView]> picker-rows;
    in property <string> picker-search;
    callback picker-search-edited(string);
    callback picker-select(int);
    in property <int> picker-selected;
    callback picker-show-uniques();
    in property <[string]> picker-sides;
    in property <int> picker-slot;
    in property <bool> picker-slot-active;
    callback picker-slot-changed(int);
    in property <string> picker-slot-text;
    in property <[string]> picker-slots;
    in property <int> picker-source;
    in property <bool> picker-source-active;
    callback picker-source-changed(int);
    in property <string> picker-source-text;
    in property <[string]> picker-sources;
    in property <string> picker-status;
    in property <string> picker-subtitle;
    callback picker-tag-toggled(int, bool);
    in property <[string]> picker-tags;
    in property <bool> picker-tags-active;
    in property <[bool]> picker-tags-on;
    in property <string> picker-tags-text;
    in property <string> picker-title;
    callback press(CellRef);
    callback remove-affix(int);
    callback scrub(CellRef, float);
    callback select-affix(int);
    callback step(CellRef, int);
    callback step-to-end(CellRef, bool);
    in property <bool> typing;
    in property <CellRef> typing-cell;
    callback use-picker();

    in property <AffixRowView> affix;
    in property <int> index;
    in property <bool> selected;
    in property <bool> wide;
    in property <length> range-width;

    property <int> serial: root.focus-serial;
    property <int> tier-highlight;
    property <int> seal-highlight;
    property <length> content-height: Math.max(Tokens.row-min-height, name-cell.height);
    // The replace picker's flyout: closing it any way but Use or Cancel (a click outside) cancels the replacement, and Rust
    // dropping the picker closes it.
    property <bool> picker-shown: picker-popup.is-open;
    property <bool> picker-live: root.picker-open;

    changed serial => {
        if (root.focus-cell.kind == CellKind.affix && root.focus-cell.row == root.index) {
            if (root.focus-part == 1) {
                name-cell.focus-cell();
            } else if (root.focus-part == 2) {
                tier-cell.focus-cell();
            } else if (root.focus-part == 3) {
                seal-cell.focus-cell();
            }
            ForgeReveal.show(root.absolute-position.y, root.height);
        }
    }

    // A selected row scrolls into view, however it was selected (Show draft, Up/Down, a click).
    changed selected => {
        if (root.selected) {
            ForgeReveal.show(root.absolute-position.y, root.height);
        }
    }

    changed picker-shown => {
        if (!root.picker-shown && root.picker-open) {
            root.cancel-picker();
        }
    }

    changed picker-live => {
        if (!root.picker-live) {
            picker-popup.close();
        }
    }

    function open-tiers() {
        root.select-affix(root.index);
        root.tier-highlight = root.affix.tier-index;
        tier-popup.show();
    }

    function open-seals() {
        root.select-affix(root.index);
        root.seal-highlight = root.affix.seal-index;
        seal-popup.show();
    }

    function open-picker() {
        if (root.open-replace(root.index)) {
            picker-popup.show();
        }
    }

    function show-menu(at-x: length) {
        menu.open-at(at-x, root.height - Tokens.space-8, true);
    }

    // Del on any of the row's cells drafts the affix's removal, as the menu's Remove affix does; on a row already removed
    // it does nothing, where the menu's entry keeps the affix.
    function remove() {
        if (root.can-change-affix-list && !root.affix.removed) {
            root.remove-affix(root.index);
        }
    }

    // A right-click opens the row menu at the pointer.
    function menu-at(x: length, y: length) {
        root.select-affix(root.index);
        menu.open-at(x - root.absolute-position.x, y - root.absolute-position.y, false);
    }

    accessible-role: list-item;
    accessible-label: root.affix.name;
    accessible-item-selected: root.selected;

    height: root.content-height + 2px;
    border-radius: Tokens.control-radius;
    border-width: 1px;
    border-color: root.selected ? Tokens.accent-brush : transparent;
    background: root.selected ? Tokens.selected-brush : hover.has-hover ? Tokens.hover-brush : transparent;

    // The row's context menu, drawn in the app's look (widgets/menu.slint) rather than as a native menu.
    menu := PopupMenu {
        entries: [
            { title: ForgeText.replace-affix, icon: Tokens.icon-replace, disabled: root.affix.added || root.affix.removed },
            { title: ForgeText.discard-draft, icon: Tokens.icon-close, disabled: !root.affix.dirty },
            { separator: true },
            root.affix.removed
                ? { title: ForgeText.keep-affix, icon: Tokens.icon-undo, disabled: !root.can-change-affix-list }
                : { title: ForgeText.remove-affix, icon: Tokens.icon-remove, gesture: ForgeText.delete-key, disabled: !root.can-change-affix-list },
        ];
        activated(index) => {
            if (index == 0) {
                root.open-picker();
            } else if (index == 1) {
                root.discard-row(root.index);
            } else if (index == 3 && root.can-change-affix-list) {
                root.remove-affix(root.index);
            }
        }
    }

    Rectangle {
        hover := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    KeyboardFocus.visible = false;
                    root.select-affix(root.index);
                }
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    root.menu-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }

            // The cells lie inside the row's touch area, so the row keeps its hover ground while the pointer is over them.
            HorizontalLayout {
                padding-left: Tokens.row-padding.left + 1px;
                padding-right: Tokens.row-padding.right + 1px;
                padding-top: 1px;
                padding-bottom: 1px;
                spacing: Tokens.space-12;

                Rectangle {
                    width: Tokens.affix-value-column-width;

                    ValueScrubber {
                        begin-input(a0) => { return root.begin-input(a0); }
                        cancel-input(a0) => { root.cancel-input(a0); }
                        commit-input(a0) => { return root.commit-input(a0); }
                        end-scrub(a0, a1) => { root.end-scrub(a0, a1); }
                        finish-input(a0) => { root.finish-input(a0); }
                        focus-cell: root.focus-cell;
                        focus-part: root.focus-part;
                        focus-serial: root.focus-serial;
                        input-edited(a0, a1) => { root.input-edited(a0, a1); }
                        input-error: root.input-error;
                        input-label: root.input-label;
                        input-range: root.input-range;
                        input-text <=> root.input-text;
                        press(a0) => { root.press(a0); }
                        scrub(a0, a1) => { root.scrub(a0, a1); }
                        step(a0, a1) => { root.step(a0, a1); }
                        step-to-end(a0, a1) => { root.step-to-end(a0, a1); }
                        typing: root.typing;
                        typing-cell: root.typing-cell;
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        cell: root.affix.value;
                        vertical(delta) => {
                            root.move-row(root.index, delta, 0);
                        }
                        menu-requested => {
                            root.show-menu(0);
                        }
                        context-menu(x, y) => {
                            root.menu-at(x, y);
                        }
                        revealed => {
                            ForgeReveal.show(root.absolute-position.y, root.height);
                        }
                        deletable: true;
                        delete-pressed => {
                            root.remove();
                        }
                        muted: root.affix.removed;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;

                    name-cell := CellButton {
                        x: Tokens.cell-outdent.left;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - Tokens.cell-outdent.left - Tokens.cell-outdent.right;
                        tip: root.affix.name-tip;
                        label: ForgeText.replace-named(root.affix.name);
                        clicked => {
                            root.open-picker();
                        }
                        vertical(delta) => {
                            root.move-row(root.index, delta, 1);
                        }
                        menu-requested => {
                            root.show-menu(parent.x);
                        }
                        context-menu(x, y) => {
                            root.menu-at(x, y);
                        }
                        deletable: true;
                        delete-pressed => {
                            root.remove();
                        }

                        VerticalLayout {
                            spacing: Tokens.space-1;
                            alignment: center;

                            Text {
                                text: root.affix.name;
                                font-size: Tokens.font-size-value;
                                color: root.affix.removed ? Tokens.text-muted-brush : root.affix.replaced || root.affix.added ? Tokens.draft-brush : Tokens.text-brush;
                                overflow: elide;
                            }

                            Text {
                                text: root.affix.detail;
                                font-size: Tokens.font-size-caption;
                                color: root.affix.reforged ? Tokens.reforged-affix-brush : Tokens.text-muted-brush;
                                overflow: elide;
                            }

                            // The confirm settle: the mark arrives as ash and settles into sage.
                            if root.affix.confirmed: HorizontalLayout {
                                property <bool> settled;
                                init => {
                                    self.settled = true;
                                }
                                spacing: Tokens.space-4;
                                alignment: start;
                                opacity: self.settled ? 1 : 0;
                                animate opacity {
                                    duration: Tokens.settle-duration;
                                    easing: Settle.curve;
                                    enabled: Tokens.motion;
                                }

                                Image {
                                    width: Tokens.icon-size-tiny;
                                    height: Tokens.icon-size-tiny;
                                    y: (parent.height - self.height) / 2;
                                    image-fit: contain;
                                    source: Tokens.icon-confirmed;
                                    colorize: parent.settled ? Tokens.confirmed-brush : Tokens.ash-brush;
                                }

                                Text {
                                    text: ForgeText.confirmed;
                                    font-size: Tokens.font-size-caption;
                                    color: parent.settled ? Tokens.confirmed-brush : Tokens.ash-brush;
                                    animate color {
                                        duration: Tokens.settle-duration;
                                        easing: Settle.curve;
                                        enabled: Tokens.motion;
                                    }
                                }
                            }

                            // An addition or a removal waits for Apply like any draft; the row says which, in words.
                            if root.affix.added || root.affix.removed: HorizontalLayout {
                                spacing: Tokens.space-4;
                                alignment: start;

                                Image {
                                    width: Tokens.icon-size-tiny;
                                    height: Tokens.icon-size-tiny;
                                    y: (parent.height - self.height) / 2;
                                    image-fit: contain;
                                    source: root.affix.added ? Tokens.icon-add : Tokens.icon-remove;
                                    colorize: Tokens.draft-brush;
                                }

                                Text {
                                    text: root.affix.added ? ForgeText.to-be-added : ForgeText.to-be-removed;
                                    font-size: Tokens.font-size-caption;
                                    color: Tokens.draft-brush;
                                    overflow: elide;
                                }
                            }

                            // In words in the row too: the changes pane can be closed, and the status icon's tip is hover-only.
                            if root.affix.stale: HorizontalLayout {
                                spacing: Tokens.space-4;
                                alignment: start;

                                Image {
                                    width: Tokens.icon-size-tiny;
                                    height: Tokens.icon-size-tiny;
                                    y: (parent.height - self.height) / 2;
                                    image-fit: contain;
                                    source: Tokens.icon-warning;
                                    colorize: Tokens.warning-brush;
                                }

                                Text {
                                    text: ForgeText.changed-in-game;
                                    font-size: Tokens.font-size-caption;
                                    color: Tokens.warning-brush;
                                    overflow: elide;
                                }
                            }
                        }
                    }


                    picker-popup := PopupWindow {
                        x: Tokens.cell-outdent.left;
                        y: (parent.height + name-cell.height) / 2 + Tokens.space-4;
                        width: PickerMetrics.width;
                        height: PickerMetrics.height;
                        close-policy: PopupClosePolicy.close-on-click-outside;

                        AffixPickerPanel {
                            can-use-picker: root.can-use-picker;
                            cancel-picker() => { root.cancel-picker(); }
                            picker-action: root.picker-action;
                            picker-allow: root.picker-allow;
                            picker-allow-changed(a0) => { root.picker-allow-changed(a0); }
                            picker-allow-enabled: root.picker-allow-enabled;
                            picker-categories: root.picker-categories;
                            picker-category: root.picker-category;
                            picker-category-changed(a0) => { root.picker-category-changed(a0); }
                            picker-chip-removed(a0) => { root.picker-chip-removed(a0); }
                            picker-chips: root.picker-chips;
                            picker-class: root.picker-class;
                            picker-class-changed(a0) => { root.picker-class-changed(a0); }
                            picker-classes: root.picker-classes;
                            picker-clear-filters() => { root.picker-clear-filters(); }
                            picker-count: root.picker-count;
                            picker-empty-allow: root.picker-empty-allow;
                            picker-empty-clear-filters: root.picker-empty-clear-filters;
                            picker-empty-clear-search: root.picker-empty-clear-search;
                            picker-empty-reason: root.picker-empty-reason;
                            picker-filter: root.picker-filter;
                            picker-filter-changed(a0) => { root.picker-filter-changed(a0); }
                            picker-hidden: root.picker-hidden;
                            picker-level: root.picker-level;
                            picker-level-changed(a0) => { root.picker-level-changed(a0); }
                            picker-levels: root.picker-levels;
                            picker-rows: root.picker-rows;
                            picker-search: root.picker-search;
                            picker-search-edited(a0) => { root.picker-search-edited(a0); }
                            picker-select(a0) => { root.picker-select(a0); }
                            picker-selected: root.picker-selected;
                            picker-show-uniques() => { root.picker-show-uniques(); }
                            picker-sides: root.picker-sides;
                            picker-slot: root.picker-slot;
                            picker-slot-active: root.picker-slot-active;
                            picker-slot-changed(a0) => { root.picker-slot-changed(a0); }
                            picker-slot-text: root.picker-slot-text;
                            picker-slots: root.picker-slots;
                            picker-source: root.picker-source;
                            picker-source-active: root.picker-source-active;
                            picker-source-changed(a0) => { root.picker-source-changed(a0); }
                            picker-source-text: root.picker-source-text;
                            picker-sources: root.picker-sources;
                            picker-status: root.picker-status;
                            picker-subtitle: root.picker-subtitle;
                            picker-tag-toggled(a0, a1) => { root.picker-tag-toggled(a0, a1); }
                            picker-tags: root.picker-tags;
                            picker-tags-active: root.picker-tags-active;
                            picker-tags-on: root.picker-tags-on;
                            picker-tags-text: root.picker-tags-text;
                            picker-title: root.picker-title;
                            use-picker() => { root.use-picker(); }
                            done => {
                                picker-popup.close();
                                name-cell.focus-cell();
                            }
                        }
                    }
                }

                if root.wide: Text {
                    width: root.range-width;
                    text: root.affix.range;
                    font-size: Tokens.font-size-caption;
                    color: Tokens.text-muted-brush;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: Tokens.affix-tier-column-width;

                    tier-cell := CellButton {
                        x: Tokens.cell-outdent.left;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - Tokens.cell-outdent.left - Tokens.cell-outdent.right;
                        enabled: root.affix.can-edit;
                        tip: ForgeText.change-tier;
                        label: ForgeText.tier-for(root.affix.name);
                        clicked => {
                            root.open-tiers();
                        }
                        vertical(delta) => {
                            root.move-row(root.index, delta, 2);
                        }
                        menu-requested => {
                            root.show-menu(parent.x);
                        }
                        context-menu(x, y) => {
                            root.menu-at(x, y);
                        }
                        deletable: true;
                        delete-pressed => {
                            root.remove();
                        }

                        Text {
                            text: root.affix.tier;
                            font-size: Tokens.font-size-value;
                            // An exalted tier keeps the rarity's colour even drafted.
                            color: root.affix.removed ? Tokens.text-muted-brush
                                : root.affix.exalted ? Tokens.rarity-exalted-brush : root.affix.tier-drafted ? Tokens.draft-brush : Tokens.text-brush;
                        }
                    }

                    tier-popup := PopupWindow {
                        x: Tokens.cell-outdent.left;
                        y: (parent.height + tier-cell.height) / 2 + Tokens.space-4;
                        width: Tokens.menu-flyout-width + Tokens.flyout-padding.left + Tokens.flyout-padding.right;
                        height: MenuMetrics.height(root.affix.tiers.length);
                        close-policy: PopupClosePolicy.close-on-click-outside;

                        MenuFrame {
                            count: root.affix.tiers.length;
                            highlighted <=> root.tier-highlight;
                            chosen(index) => {
                                root.pick-tier(root.index, index);
                                tier-popup.close();
                                tier-cell.focus-cell();
                            }
                            dismissed => {
                                tier-popup.close();
                                tier-cell.focus-cell();
                            }

                            TierList {
                                tiers: root.affix.tiers;
                                held: root.affix.tier-index;
                                highlighted: root.tier-highlight;
                                picked(index) => {
                                    root.pick-tier(root.index, index);
                                    tier-popup.close();
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: Tokens.affix-seal-column-width;

                    seal-cell := CellButton {
                        x: Tokens.cell-outdent.left;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - Tokens.cell-outdent.left - Tokens.cell-outdent.right;
                        enabled: root.affix.can-edit;
                        tip: ForgeText.change-seal-state;
                        hover-tip: root.affix.seal;
                        label: ForgeText.seal-state-for(root.affix.name);
                        clicked => {
                            root.open-seals();
                        }
                        vertical(delta) => {
                            root.move-row(root.index, delta, 3);
                        }
                        menu-requested => {
                            root.show-menu(parent.x);
                        }
                        context-menu(x, y) => {
                            root.menu-at(x, y);
                        }
                        deletable: true;
                        delete-pressed => {
                            root.remove();
                        }

                        Text {
                            text: root.affix.seal;
                            color: root.affix.removed ? Tokens.text-muted-brush
                                : root.affix.seal-drafted ? Tokens.draft-brush : root.affix.sealed ? Tokens.text-secondary-brush : Tokens.text-muted-brush;
                            overflow: elide;
                        }
                    }

                    seal-popup := PopupWindow {
                        x: Tokens.cell-outdent.left;
                        y: (parent.height + seal-cell.height) / 2 + Tokens.space-4;
                        width: Tokens.menu-flyout-width + Tokens.flyout-padding.left + Tokens.flyout-padding.right;
                        height: MenuMetrics.height(4);
                        close-policy: PopupClosePolicy.close-on-click-outside;

                        MenuFrame {
                            count: 4;
                            highlighted <=> root.seal-highlight;
                            chosen(index) => {
                                root.pick-seal(root.index, index);
                                seal-popup.close();
                                seal-cell.focus-cell();
                            }
                            dismissed => {
                                seal-popup.close();
                                seal-cell.focus-cell();
                            }

                            VerticalLayout {
                                spacing: Tokens.space-2;

                                for seal[index] in [ForgeText.seal-normal, ForgeText.seal-sealed, ForgeText.seal-primordial, ForgeText.seal-corrupted]: MenuRow {
                                    held: root.affix.seal-index == index;
                                    highlighted: root.seal-highlight == index;
                                    picked => {
                                        root.pick-seal(root.index, index);
                                        seal-popup.close();
                                    }

                                    Text {
                                        text: seal;
                                        color: Tokens.text-brush;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // The draft pencil or the stale triangle, each with its tip.
                Rectangle {
                    width: Tokens.affix-status-column-width;

                    if root.affix.pending || root.affix.stale: Image {
                        width: Tokens.icon-size;
                        height: Tokens.icon-size;
                        y: (parent.height - self.height) / 2;
                        image-fit: contain;
                        source: root.affix.stale ? Tokens.icon-warning : Tokens.icon-draft;
                        colorize: root.affix.stale ? Tokens.warning-brush : Tokens.draft-brush;
                        accessible-role: image;
                        accessible-label: root.affix.stale ? ForgeText.stale-draft : ForgeText.draft;

                        status-touch := TouchArea { }

                        TipTrigger {
                            text: root.affix.stale ? ForgeText.affix-changed-in-game : ForgeText.draft-of(root.affix.draft-tip);
                            hovered: status-touch.has-hover;
                        }
                    }
                }
            }
        }
    }
}

// One implicit or unique modifier on the table's columns: its rolls scrub in the value column, the game's line beside them.
export component ModifierRowItem inherits Rectangle {
    // From the page: what this shows and what it asks of it.
    callback begin-input(CellRef) -> bool;
    callback cancel-input(CellRef);
    callback commit-input(CellRef) -> bool;
    callback end-scrub(CellRef, bool);
    callback finish-input(CellRef);
    in property <CellRef> focus-cell;
    in property <int> focus-part;
    in property <int> focus-serial;
    callback input-edited(CellRef, string);
    in property <string> input-error;
    in property <string> input-label;
    in property <string> input-range;
    in-out property <string> input-text;
    callback move-implicit(int, int, int);
    callback move-unique(int, int, int);
    callback press(CellRef);
    callback scrub(CellRef, float);
    callback select-unique(int);
    callback step(CellRef, int);
    callback step-to-end(CellRef, bool);
    in property <bool> typing;
    in property <CellRef> typing-cell;

    in property <ModifierRowView> line;
    in property <int> index;
    in property <CellKind> kind;
    // Unique modifiers are a list on the tooltip ground; implicits are plain rows.
    in property <bool> on-unique;
    in property <bool> selected;

    property <length> padding-x: root.on-unique ? Tokens.row-padding.left : Tokens.implicit-row-margin.left;
    property <length> padding-y: root.on-unique ? Tokens.unique-row-margin.top : Tokens.implicit-row-margin.top;

    // A selected unique modifier scrolls into view.
    changed selected => {
        if (root.selected) {
            ForgeReveal.show(root.absolute-position.y, root.height);
        }
    }

    accessible-role: list-item;
    accessible-label: root.line.text;
    accessible-item-selected: root.selected;

    height: layout.preferred-height;
    border-radius: Tokens.control-radius;
    border-width: root.on-unique ? 1px : 0px;
    // The game's tooltip has no hover or selection, so unique rows take the table's.
    border-color: root.on-unique && root.selected ? Tokens.accent-brush : transparent;
    background: !root.on-unique ? transparent
        : root.selected ? Tokens.selected-brush
        : touch.has-hover ? Tokens.hover-brush : transparent;

    touch := TouchArea {
        enabled: root.on-unique;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                KeyboardFocus.visible = false;
                root.select-unique(root.index);
            }
        }
    }

    layout := HorizontalLayout {
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        padding-top: root.padding-y;
        padding-bottom: root.padding-y;
        spacing: Tokens.space-12;

        VerticalLayout {
            width: Tokens.affix-value-column-width;
            spacing: Tokens.space-2;
            alignment: root.on-unique ? start : center;

            if root.line.editable: VerticalLayout {
                spacing: Tokens.space-2;

                for cell[roll] in root.line.rolls: ValueScrubber {
                    begin-input(a0) => { return root.begin-input(a0); }
                    cancel-input(a0) => { root.cancel-input(a0); }
                    commit-input(a0) => { return root.commit-input(a0); }
                    end-scrub(a0, a1) => { root.end-scrub(a0, a1); }
                    finish-input(a0) => { root.finish-input(a0); }
                    focus-cell: root.focus-cell;
                    focus-part: root.focus-part;
                    focus-serial: root.focus-serial;
                    input-edited(a0, a1) => { root.input-edited(a0, a1); }
                    input-error: root.input-error;
                    input-label: root.input-label;
                    input-range: root.input-range;
                    input-text <=> root.input-text;
                    press(a0) => { root.press(a0); }
                    scrub(a0, a1) => { root.scrub(a0, a1); }
                    step(a0, a1) => { root.step(a0, a1); }
                    step-to-end(a0, a1) => { root.step-to-end(a0, a1); }
                    typing: root.typing;
                    typing-cell: root.typing-cell;
                    cell: cell;
                    on-unique: root.on-unique;
                    vertical(delta) => {
                        if (root.on-unique) {
                            root.move-unique(root.index, delta, roll);
                        } else {
                            root.move-implicit(root.index, delta, roll);
                        }
                    }
                    revealed => {
                        ForgeReveal.show(root.absolute-position.y, root.height);
                    }
                }
            }

            if !root.line.editable: HorizontalLayout {
                spacing: Tokens.space-6;
                alignment: start;

                Image {
                    width: Tokens.icon-size-small;
                    height: Tokens.icon-size-small;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                    source: Tokens.icon-locked;
                    colorize: root.on-unique ? Tokens.unique-caption-brush : Tokens.text-muted-brush;
                }

                fixed := Text {
                    text: root.line.fixed-text;
                    font-size: Tokens.font-size-caption;
                    color: root.on-unique ? Tokens.unique-caption-brush : Tokens.text-muted-brush;
                    vertical-alignment: center;

                    fixed-touch := TouchArea { }

                    TipTrigger {
                        text: root.line.fixed-text;
                        hovered: fixed-touch.has-hover;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: root.on-unique ? Tokens.space-2 : Tokens.space-1;
            alignment: center;

            Text {
                text: root.line.text;
                font-size: Tokens.font-size-value;
                // A unique modifier line in the game's own line colour; teal while drafted.
                color: root.line.drafted ? Tokens.draft-brush : root.on-unique ? Tokens.unique-text-brush : Tokens.text-brush;
                wrap: word-wrap;
            }

            if root.line.range != "" || root.line.confirmed: HorizontalLayout {
                spacing: Tokens.space-8;
                alignment: start;

                if root.line.range != "": Text {
                    text: root.line.range;
                    font-size: Tokens.font-size-caption;
                    color: root.on-unique ? Tokens.unique-caption-brush : Tokens.text-muted-brush;
                }

                if root.line.confirmed: HorizontalLayout {
                    property <bool> settled;
                    init => {
                        self.settled = true;
                    }
                    spacing: Tokens.space-4;
                    opacity: self.settled ? 1 : 0;
                    animate opacity {
                        duration: Tokens.settle-duration;
                        easing: Settle.curve;
                        enabled: Tokens.motion;
                    }

                    Image {
                        width: Tokens.icon-size-tiny;
                        height: Tokens.icon-size-tiny;
                        y: (parent.height - self.height) / 2;
                        image-fit: contain;
                        source: Tokens.icon-confirmed;
                        colorize: parent.settled ? Tokens.confirmed-brush : Tokens.ash-brush;
                    }

                    Text {
                        text: ForgeText.confirmed;
                        font-size: Tokens.font-size-caption;
                        color: parent.settled ? Tokens.confirmed-brush : Tokens.ash-brush;
                    }
                }
            }

            if root.line.stale: HorizontalLayout {
                spacing: Tokens.space-4;
                alignment: start;

                Image {
                    width: Tokens.icon-size-tiny;
                    height: Tokens.icon-size-tiny;
                    y: Tokens.space-2;
                    image-fit: contain;
                    source: Tokens.icon-warning;
                    colorize: Tokens.warning-brush;
                }

                Text {
                    text: ForgeText.changed-in-game;
                    font-size: Tokens.font-size-caption;
                    color: Tokens.warning-brush;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            if root.line.linked != "": Text {
                text: root.line.linked;
                font-size: Tokens.font-size-caption;
                color: Tokens.unique-caption-brush;
                wrap: word-wrap;

                linked-touch := TouchArea { }

                TipTrigger {
                    text: ForgeText.shared-roll;
                    hovered: linked-touch.has-hover;
                }
            }
        }

        Rectangle {
            width: Tokens.affix-status-column-width;

            if root.line.pending || root.line.stale: Image {
                y: root.on-unique ? 0 : (parent.height - self.height) / 2;
                width: root.on-unique ? Tokens.icon-size-small : Tokens.icon-size;
                height: self.width;
                image-fit: contain;
                source: root.line.stale ? Tokens.icon-warning : Tokens.icon-draft;
                colorize: root.line.stale ? Tokens.warning-brush : Tokens.draft-brush;
                accessible-role: image;
                accessible-label: root.line.stale ? ForgeText.stale-draft : ForgeText.draft;

                icon-touch := TouchArea { }

                TipTrigger {
                    text: root.line.stale
                        ? (root.on-unique ? ForgeText.rolls-changed-in-game : ForgeText.roll-changed-in-game)
                        : (root.on-unique ? ForgeText.draft : ForgeText.draft-of(root.line.draft-tip));
                    hovered: icon-touch.has-hover;
                }
            }
        }
    }
}
