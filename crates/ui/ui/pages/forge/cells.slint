// The forge's in-place cells and the small controls of its flyouts. Each follows the one widget pattern: a FocusScope
// that shows keyboard focus on tab arrival, a TouchArea that hides it on a press, then the tip trigger and the focus ring.

import { Tokens } from "../../tokens.slint";
import { KeyboardFocus, TipPlacement } from "../../globals.slint";
import { FocusRing, TipTrigger } from "../../widgets/focus.slint";
import { ForgeCover } from "state.slint";
import { ForgeText } from "../../strings/forge.slint";

// A cell button: plain text until hovered (Dusk Brown in a Weathered Taupe frame). Disabled, it keeps its own colours and
// only stops answering. Place it outdented by the cell padding so its hover frame reaches past the column.
export component CellButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> tip;
    in property <string> label;
    // Inline cells in the facts line answer like a cell only where they can change.
    in property <bool> changeable: true;
    // A Tab stop: by default where the cell can change; the facts line's cells always are, so their reasons show by keyboard.
    in property <bool> tab-stop: root.changeable;
    // The tip while the pointer is over the cell, when it differs from the keyboard's (the seal's full name).
    in property <string> hover-tip;
    callback clicked();
    callback vertical(int);
    callback menu-requested();
    // A right-click, at the pointer in window coordinates.
    callback context-menu(length, length);
    // Del on a cell that removes what it belongs to (an affix row's cells).
    in property <bool> deletable;
    callback delete-pressed();
    out property <bool> has-focus: focus.has-focus;
    out property <bool> hovered: touch.has-hover;

    public function focus-cell() {
        focus.focus();
    }

    property <bool> live: root.enabled && root.changeable;
    // Under the changes pane in a narrow window: out of the Tab order, as focus there would be out of sight.
    property <bool> covered: ForgeCover.covers(root.absolute-position.x, root.absolute-position.y, root.width, root.height);

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    border-radius: Tokens.control-radius;
    border-width: 1px;
    background: root.live && touch.has-hover ? Tokens.hover-brush : transparent;
    border-color: root.live && touch.has-hover ? Tokens.strong-line-brush : transparent;
    height: layout.preferred-height;

    layout := HorizontalLayout {
        padding-left: Tokens.cell-padding.left;
        padding-right: Tokens.cell-padding.right;
        padding-top: Tokens.cell-padding.top;
        padding-bottom: Tokens.cell-padding.bottom;

        @children
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-tab-navigation: root.tab-stop && !root.covered;
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) {
                KeyboardFocus.visible = true;
            }
        }
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                return reject;
            }
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.vertical(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.vertical(1);
                return accept;
            }
            if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                root.menu-requested();
                return accept;
            }
            if (event.text == Key.Delete && root.deletable) {
                root.delete-pressed();
                return accept;
            }
            reject
        }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.live ? MouseCursor.pointer : MouseCursor.default;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    KeyboardFocus.visible = false;
                }
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            clicked => {
                if (root.changeable) {
                    focus.focus();
                }
                root.clicked();
            }
        }
    }

    TipTrigger {
        text: touch.has-hover && root.hover-tip != "" ? root.hover-tip : root.tip;
        hovered: touch.has-hover;
        focused: focus.has-focus;
    }

    FocusRing {
        focused: focus.has-focus;
    }
}

// One entry of a flyout menu: the held one on Wine-Stained Brown in a brass frame, the keyboard's framed in the focus
// colour, disabled dimmed. Hover is Wine-Stained Brown on a flyout, whose own ground is the hover colour (as the rail's
// flyout and the context menus have it), and Dusk Brown where the rows lie on the page (the tier ladder).
export component MenuRow inherits Rectangle {
    in property <bool> held;
    in property <bool> highlighted;
    in property <bool> enabled: true;
    in property <bool> on-flyout: true;
    callback picked();
    out property <bool> hovered: touch.has-hover;

    border-radius: Tokens.control-radius;
    border-width: 1px;
    border-color: root.held ? Tokens.accent-brush : root.highlighted && KeyboardFocus.visible ? Tokens.focus-brush : transparent;
    background: root.held ? Tokens.selected-brush
        : touch.has-hover && root.enabled ? (root.on-flyout ? Tokens.selected-brush : Tokens.hover-brush) : transparent;
    height: layout.preferred-height;

    layout := HorizontalLayout {
        padding-left: Tokens.cell-padding.left;
        padding-right: Tokens.cell-padding.right;
        padding-top: Tokens.cell-padding.top;
        padding-bottom: Tokens.cell-padding.bottom;
        spacing: Tokens.space-12;

        @children
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.picked();
        }
    }
}

// A status flag: labelled with its state in the game's words, both states laid out so it never resizes as it toggles.
export component FlagToggle inherits Rectangle {
    in property <string> on-name;
    in property <string> off-name;
    in property <bool> checked;
    in property <bool> drafted;
    in property <bool> enabled: true;
    in property <bool> confirmed;
    in property <bool> stale;
    in property <string> tip;
    callback toggled(bool);

    property <bool> hovered: touch.has-hover && root.enabled;

    public function focus-cell() {
        focus.focus();
    }

    accessible-role: switch;
    accessible-label: root.on-name;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(!root.checked); }

    border-radius: Tokens.control-radius;
    border-width: 1px;
    background: !root.enabled ? transparent
        : root.hovered ? Tokens.hover-brush
        : root.drafted && root.checked ? Tokens.draft-surface-brush : transparent;
    // A disabled flag keeps the frame its state gives it when checked (trim gold, teal while drafted) and has none when
    // not, so a disabled flag still says whether it is set.
    border-color: !root.enabled ? (root.checked ? (root.drafted ? Tokens.draft-brush : Tokens.accent-trim-brush) : transparent)
        : root.drafted && root.checked && !root.hovered ? Tokens.draft-brush
        : root.checked ? (root.hovered ? Tokens.accent-brush : Tokens.accent-trim-brush)
        : root.hovered ? Tokens.strong-line-brush : Tokens.hairline-brush;
    property <brush> ink: !root.enabled ? Tokens.text-disabled-brush
        : root.drafted ? Tokens.draft-brush
        : root.checked ? Tokens.text-brush
        : root.hovered ? Tokens.text-secondary-brush : Tokens.text-muted-brush;
    width: layout.preferred-width;
    height: layout.preferred-height;

    layout := HorizontalLayout {
        padding-left: Tokens.flag-padding.left;
        padding-right: Tokens.flag-padding.right;
        padding-top: Tokens.flag-padding.top;
        padding-bottom: Tokens.flag-padding.bottom;
        spacing: Tokens.space-4;

        Rectangle {
            width: Math.max(off.preferred-width, on.preferred-width);
            height: Math.max(off.preferred-height, on.preferred-height);

            off := Text {
                text: root.off-name;
                color: root.ink;
                opacity: root.checked ? 0 : 1;
                horizontal-alignment: center;
            }

            on := Text {
                text: root.on-name;
                color: root.ink;
                opacity: root.checked ? 1 : 0;
                horizontal-alignment: center;
            }
        }

        if root.confirmed: Image {
            width: Tokens.icon-size-tiny;
            height: Tokens.icon-size-tiny;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            source: Tokens.icon-confirmed;
            colorize: Tokens.confirmed-brush;
            accessible-label: ForgeText.confirmed;
        }

        if root.stale: Image {
            width: Tokens.icon-size-tiny;
            height: Tokens.icon-size-tiny;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            source: Tokens.icon-warning;
            colorize: Tokens.warning-brush;
            accessible-label: ForgeText.stale-draft;
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) {
                KeyboardFocus.visible = true;
            }
        }
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggled(!root.checked);
                return accept;
            }
            reject
        }

        touch := TouchArea {
            enabled: root.enabled;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    KeyboardFocus.visible = false;
                }
            }
            clicked => {
                focus.focus();
                root.toggled(!root.checked);
            }
        }
    }

    TipTrigger {
        text: root.tip;
        hovered: touch.has-hover;
        focused: focus.has-focus;
    }

    FocusRing {
        focused: focus.has-focus;
    }
}

