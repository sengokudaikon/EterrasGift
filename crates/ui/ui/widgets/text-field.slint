// A single-line text box. Placeholders carry real defaults (the detected game, the default data folder), so they read as
// notes in the muted colour at full strength, not as disabled text.

import { Tokens } from "../tokens.slint";
import { KeyboardFocus } from "../globals.slint";
import { FocusRing } from "focus.slint";

export component TextField inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);
    // TextInput replaces its own binding on edit; later model updates still reach it.
    changed text => {
        if (input.text != root.text) { input.text = root.text; }
    }

    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;

    min-height: Tokens.control-min-height;
    horizontal-stretch: 1;
    border-radius: Tokens.control-radius;
    border-width: 1px;
    // Fluent's text box on the retinted palette (Theme.axaml): AltMediumLow at rest in a BaseMedium frame, AltMedium and
    // BaseMediumHigh under the pointer, the ground in the accent frame while focused; frames step up under high contrast.
    background: input.has-focus ? Tokens.ground-brush : touch.has-hover ? Tokens.raised-brush : Tokens.hover-brush;
    border-color: input.has-focus ? Tokens.accent-brush : touch.has-hover ? Tokens.fluent-base-medium-high-color : (Tokens.high-contrast ? Tokens.text-secondary-brush : Tokens.fluent-base-medium-color);
    forward-focus: input;

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                KeyboardFocus.visible = false;
            }
        }
        clicked => {
            input.focus();
        }
    }

    // Fluent's compact text box: the text sits at the top-left of its padding, as the C# TextBox's does.
    HorizontalLayout {
        padding-left: Tokens.text-control-padding.left + root.border-width;
        padding-right: Tokens.text-control-padding.right + root.border-width;
        padding-top: Tokens.text-control-padding.top + root.border-width;
        padding-bottom: Tokens.text-control-padding.bottom + root.border-width;

        Rectangle {
            clip: true;

            // Pinned to the top: an element without a `y` is centred in its parent.
            if root.text == "": Text {
                x: 0;
                y: 0;
                width: parent.width;
                text: root.placeholder;
                color: Tokens.text-muted-brush;
                vertical-alignment: top;
                // Avalonia cuts a long placeholder at the box's edge rather than ending it in "…".
                overflow: clip;
            }

            input := TextInput {
                y: 0;
                text: root.text;
                enabled: root.enabled;
                single-line: true;
                color: root.enabled ? Tokens.text-brush : Tokens.text-disabled-brush;
                selection-background-color: Tokens.accent-pressed-color;
                selection-foreground-color: Tokens.on-accent-color;
                vertical-alignment: top;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted(self.text);
                }
            }
        }
    }

    // A text box shows its own focus by its accent frame; the ring is for keyboard arrivals only.
    FocusRing {
        focused: input.has-focus;
    }
}
