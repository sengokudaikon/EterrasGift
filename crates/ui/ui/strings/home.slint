// Home's words. Every view word is an `@tr` here, never a literal in a view; its English is the gettext msgid,
// shared with any phrase that reads the same. A context only tells apart English that means two things
// (see shell.slint).

export global HomeText {
    out property <string> last-epoch: @tr("Last Epoch");
    out property <string> home: @tr("Home");
    out property <string> companion: @tr("Companion tools for Last Epoch.");
    out property <string> play-online: @tr("Play online");
    out property <string> play-offline: @tr("Play offline");
    out property <string> play-offline-with-mods: @tr("Play offline with mods");
}
