// The design values every view takes: colours, type, sizes, insets, motion and icons. This file is their source;
// edit it here. Rust reads a few (the decorations', the ash's) through Slint's getters, `Tokens::get_ash_climb` and so on.
// A colour is a `-brush` unless something needs it as a colour (a text selection, a shadow, a tint, Rust).

import "fonts/Cinzel-SemiBold.ttf";
import "fonts/NotoSans-Regular.ttf";
import "fonts/NotoSans-SemiBold.ttf";

// One inset per side.
export struct Inset { left: length, top: length, right: length, bottom: length }

export global Tokens {
    // Set from Rust: Windows high contrast and the "Animation effects" setting.
    in-out property <bool> high-contrast: false;
    in-out property <bool> motion: true;

    // Faces. Cinzel SemiBold, Roman capitals, only for the large text that says little: titles and the wordmark. Noto Sans, the game's own UI fallback face, for everything else: reading text, values, labels, navigation and buttons. Both OFL, in fonts/ with their licences.
    out property <string> display-font: "Cinzel";
    out property <string> body-font: "Noto Sans";

    // Weights: SemiBold for emphasis and for titles
    out property <int> emphasis-weight: 600;
    out property <int> display-weight: 600;

    // Grounds: the game's warm near-black, sampled from its inventory panel (#0E0E0B), stepped up for hierarchy
    out property <brush> ground-brush: #0E0E0B;
    out property <brush> surface-brush: #141310;
    out property <brush> raised-brush: #1A1915;
    out property <brush> hover-brush: #23211C;
    out property <brush> selected-brush: #2A1714;

    // Frames: the game's bronze-brown grid lines and warm grey panel frames
    out property <color> strong-line-color: #4A4036;
    out property <brush> hairline-brush: high-contrast ? high-contrast-hairline-brush : #2B2418;
    out property <brush> strong-line-brush: high-contrast ? high-contrast-strong-line-brush : strong-line-color;

    // Text: the game's tooltip parchment (#E8DDC8) and muted note colour (#9F9783), from its own rich-text strings
    out property <color> text-secondary-color: #BDB29E;
    out property <color> text-muted-color: #9F9783;
    out property <brush> text-brush: #E8DDC8;
    out property <brush> text-secondary-brush: text-secondary-color;
    out property <brush> text-muted-brush: high-contrast ? high-contrast-text-muted-brush : text-muted-color;
    out property <brush> text-disabled-brush: #5F594E;

    // Rose-white of the game's tab and button labels
    out property <brush> label-brush: #E4D2D2;

    // Windows contrast themes: hairlines, frames and muted text step up one tone so every boundary and note clears 3:1 / 4.5:1. The role brushes above swap to these.
    out property <brush> high-contrast-hairline-brush: text-muted-color;
    out property <brush> high-contrast-strong-line-brush: text-secondary-color;
    out property <brush> high-contrast-text-muted-brush: text-secondary-color;

    // Interface accents. Crimson: the game's active tab; primary action and the active navigation item. Bronze-gold: the game's trim; selection frames, links and focus. Text selections take the pressed bronze with dark text.
    out property <brush> primary-brush: #6E1212;
    out property <brush> primary-hover-brush: #851A17;
    out property <brush> primary-pressed-brush: #560B0B;
    out property <brush> on-primary-brush: #F2E4E4;
    out property <color> accent-pressed-color: #B18D4A;
    out property <color> on-accent-color: #17130B;
    out property <brush> accent-brush: #C9A45C;
    out property <brush> accent-pressed-brush: accent-pressed-color;
    out property <brush> accent-trim-brush: #8C6A3A;
    out property <brush> on-accent-brush: on-accent-color;
    out property <brush> focus-brush: #E6C885;

    // State: draft is rift teal; confirmed is Eterra's sage (a change the game holds is alive; after her concept art, not game-owned); warning and error each carry an icon and words as well. Warning (#F1B367) and error (#FB6565) are the game's own "shattered" and "cannot equip" colours.
    out property <brush> draft-brush: #74C9C1;
    out property <brush> draft-surface-brush: #12201E;
    out property <brush> draft-hover-brush: #1C3331;
    out property <brush> confirmed-brush: #A7B79A;
    out property <brush> warning-brush: #F1B367;
    out property <brush> error-brush: #FB6565;

    // Waiting: ash drifting up the empty editor with an occasional ember, faint enough to read past
    out property <color> ash-color: #8A8272;
    out property <color> ember-color: #D9853F;
    out property <brush> ash-brush: ash-color;

    // Game-owned item colours: content only, never interface accent. Extracted from the game's EpochColor MasterColorList (tooltipName).
    out property <brush> rarity-normal-brush: #FFFFFF;
    out property <brush> rarity-magic-brush: #36A3E2;
    out property <brush> rarity-rare-brush: #E3D157;
    out property <brush> rarity-exalted-brush: #C184FF;
    out property <brush> rarity-unique-brush: #EB730A;
    out property <brush> rarity-set-brush: #71E87D;
    out property <brush> rarity-legendary-brush: #E80B58;
    out property <brush> reforged-affix-brush: #DAE871;

    // The game's unique item tooltip (LE.UI.Tooltips.ItemTooltip), from its own assets: the median copper of its T_UI_Tooltip_Background_Unique frame; the ItemTooltipModifier prefab's line colour and its roll-range colour
    out property <brush> unique-border-brush: #894A1B;
    out property <brush> unique-text-brush: #B7AA90;
    out property <brush> unique-caption-brush: #8498DD;

    // The tooltip's ground (T_UI_Modal_Background) with its header glow in the top-left corner, as wide and deep as the game's header shows it: T_UI_ItemTooltip_RarityBackground_Default tinted with MasterItemTooltipAssetList's unique background #865328, its stops (#2C1F17, #231A15, #1A1412 into the ground) sampled from the composite along the glow. Slint's radial gradients are centred circles, so the elliptical glow is gradients/unique-surface-brush.svg, placed by these bounds over the ground.
    out property <image> unique-surface-brush-image: @image-url("gradients/unique-surface-brush.svg");
    out property <length> unique-surface-brush-x: -330px;
    out property <length> unique-surface-brush-y: -50px;
    out property <length> unique-surface-brush-width: 660px;
    out property <length> unique-surface-brush-height: 100px;
    out property <brush> unique-surface-brush-ground: #0E0F13;

    // Range bar: the game's bronze grid line lifted until the bar's extent and the value's position both read at 3:1 (track on the ground, fill and draft fill on the track)
    out property <brush> range-track-brush: #6D5C44;
    out property <brush> range-fill-brush: text-secondary-color;

    // The scrub band: the bar's strip tints under the pointer instead of the cell getting a box; flat, no glow
    out property <brush> aura-brush: #C9A45C26;

    // Fluent's ramp steps, derived from the text colour, for the controls drawn as Fluent draws them (boxes, menus, scroll bars)
    out property <color> fluent-base-medium-high-color: #CFC4AF;
    out property <color> fluent-base-medium-color: #A39985;
    out property <color> fluent-base-medium-low-color: #746D60;

    // The drop shadow under menus and flyouts, so they lift off the near-black ground. The software renderer (captures) draws no shadows; FemtoVG does.
    out property <color> flyout-shadow-color: #00000099;

    // Fluent's ScrollBarTrackFill: the raised ground at 0.9 opacity, behind an expanded scroll bar
    out property <brush> scroll-bar-track-brush: #1A1915E6;

    // Type scale: a dense expert tool one step under the Windows ramp; nothing read drops below 12
    out property <length> font-size-caption: 12px;
    out property <length> font-size-body: 13px;
    out property <length> font-size-value: 14px;
    out property <length> font-size-subheading: 15px;
    out property <length> font-size-section: 17px;
    out property <length> font-size-title: 28px;
    out property <length> line-height-title: 34px;
    out property <length> line-height-reading: 21px;

    // Letter spacing in device-independent pixels: the titles' capitals open slightly
    out property <length> tracking-title: 0.6px;
    out property <int> title-max-lines: 2;

    // A one-line note beside a control (the Forge's affix-list note) wraps to this many lines rather than cutting, so the keyboard reaches all of it
    out property <int> note-max-lines: 2;

    // Spacing scale (4 px grid, with 2/6/10 for optical nudges)
    out property <length> space-0: 0px;
    out property <length> space-1: 1px;
    out property <length> space-2: 2px;
    out property <length> space-4: 4px;
    out property <length> space-6: 6px;
    out property <length> space-8: 8px;
    out property <length> space-10: 10px;
    out property <length> space-12: 12px;
    out property <length> space-16: 16px;
    out property <length> space-18: 18px;
    out property <length> space-20: 20px;
    out property <length> space-24: 24px;

    // Maximized without unique modifiers: the selected affix's tier ladder beside the table, its label on the table's label row
    out property <length> tier-ladder-width: 260px;

    // Window and size classes
    out property <length> window-default-width: 1100px;
    out property <length> window-default-height: 700px;

    // The smallest window: a trainer row beside the icon rail. Below the narrow width the forge's changes pane opens over the table instead of beside it
    out property <length> window-min-width: 680px;
    out property <length> narrow-window-width: 940px;
    out property <length> window-min-height: 580px;
    out property <length> compact-window-width: 1024px;
    out property <length> wide-window-width: 1600px;

    // The Item Forge's lists width from which the tier ladder or the unique's panel stands beside the affix table
    out property <length> side-by-side-body-width: 1180px;

    // Component sizes
    out property <length> nav-pane-width: 212px;
    out property <length> nav-rail-width: 56px;
    out property <length> nav-item-min-height: 40px;
    out property <length> changes-pane-width: 340px;
    out property <length> changes-pane-compact-width: 304px;
    out property <length> changes-pane-wide-width: 420px;
    out property <length> row-min-height: 50px;
    out property <length> control-min-height: 32px;
    out property <length> icon-button-size: 32px;
    out property <length> compact-icon-button-size: 24px;
    out property <length> icon-size: 16px;
    out property <length> icon-size-small: 14px;
    out property <length> icon-size-tiny: 12px;
    out property <length> icon-size-nav: 20px;
    out property <length> range-bar-height: 10px;
    out property <length> range-bar-track-thickness: 3px;
    out property <length> range-bar-track-thickness-active: 5px;
    out property <length> range-bar-tick-width: 2px;
    out property <length> reading-max-width: 560px;
    out property <length> status-message-max-width: 640px;
    out property <length> settings-max-width: 760px;
    out property <length> preview-status-max-width: 260px;

    // The Mods list stops growing here, like the affix table; a maximized window fills it with Version and Source columns
    out property <length> mods-content-max-width: 1000px;

    // The action bar's status keeps room for its two lines, so the bar does not change height as they come and go
    out property <length> action-bar-status-min-height: 36px;

    // A mod setting's box: room for a float as the mod reads it ("1.3333334") in tabular figures, or a short word
    out property <length> mod-setting-field-width: 96px;

    // A trainer feature's row: [title (?) | value | switch], one width on every page: at least 520 (a title of ~37 characters on one line), at most 600, so a name never sits far from its control; a window with room for two rows takes two columns 48 apart. Its padding is outdented, so the hover ground runs past its words and they keep the page's edge.
    out property <length> feature-row-min-width: 520px;
    out property <length> feature-row-max-width: 600px;
    out property <int> feature-max-columns: 2;
    out property <length> feature-column-spacing: 48px;

    // The value column holds a box (a currency in the millions with its unit, no spinner) or a choice, which may grow left; the switch column holds the switch (as wide as the page's widest, at least 72) or an editor's Read again
    out property <length> feature-switch-min-width: 72px;
    out property <length> feature-field-width: 112px;

    // The unit after a value box's number, in a slot every box keeps
    out property <length> feature-unit-width: 10px;

    // A stacked page's section heading: 24 below the group before (the rows' panel keeps it, none above the first in a column), 4 above its rows
    out property <length> feature-section-spacing: 24px;

    // The trainer connection's text scrolls past this height; the affix table stops growing at this width
    out property <length> connection-text-max-height: 64px;
    out property <length> affix-table-max-width: 1000px;

    // Item status cells in the header take the affix value column's width, so their scrubbers read alike
    out property <length> status-cell-width: 150px;

    // Scrubbing: dragging this many pixels crosses the whole range; Shift divides the speed
    out property <length> scrub-span: 160px;
    out property <length> scrub-threshold: 4px;
    out property <float> scrub-fine-factor: 4;
    out property <float> scrub-large-step: 5;

    // A tip opened by keyboard focus or a help button hangs this far under its control
    out property <length> keyboard-tip-offset: 4px;

    // Fluent's FocusVisualPrimaryThickness, the keyboard focus ring's stroke
    out property <length> focus-ring-width: 2px;

    // The focus ring sits this far outside its control (Fluent's FocusVisualMargin -2)
    out property <length> focus-ring-offset: 2px;

    // Flyout and menu widths
    out property <length> value-flyout-width: 160px;
    out property <length> menu-flyout-width: 240px;
    out property <length> base-menu-width: 300px;

    // The Forge's Replace flyout and its list
    out property <length> replace-flyout-width: 380px;
    out property <length> replace-list-max-height: 300px;

    // Waiting: ash drifting up the empty editor. A low frame rate beside the game; one mote per this many square pixels, capped; about a fifth are embers, brighter and with a faint glow this many radii wide
    out property <int> ash-frames-per-second: 24;
    out property <float> ash-mote-area: 11000;
    out property <int> ash-mote-limit: 64;
    out property <float> ash-ember-share: 0.22;
    out property <float> ash-opacity: 0.42;
    out property <float> ember-opacity: 0.75;
    out property <float> ember-glow-scale: 3.5;
    out property <float> ember-glow-opacity: 0.18;

    // Still ash (an empty page): the bloom level it is held at, so this share of the ash is cleared
    out property <float> ash-still-level: 0.4;

    // Drift: a field starts this many seconds into its drift, so the first frame (and every capture) is already full, and motes rise from this far below the bottom edge. Each mote's own constants are a base plus a random share of a spread: how long one rise takes, how much of the height it climbs, how far and how slowly it sways, and its radius (embers and ash apart). Once the bloom passes a mote's threshold it fades out over this much of the bloom range.
    out property <float> ash-warm-up-seconds: 40;
    out property <length> ash-start-below: 4px;
    out property <float> ash-rise-seconds: 9;
    out property <float> ash-rise-seconds-spread: 9;
    out property <float> ash-climb: 0.35;
    out property <float> ash-climb-spread: 0.4;
    out property <length> ash-sway: 4px;
    out property <length> ash-sway-spread: 10px;
    out property <float> ash-sway-seconds: 5;
    out property <float> ash-sway-seconds-spread: 4;
    out property <length> ember-radius: 1px;
    out property <length> ember-radius-spread: 0.8px;
    out property <length> ash-radius: 0.7px;
    out property <length> ash-radius-spread: 1.2px;
    out property <float> ash-clear-band: 0.12;

    // Bloom: how far Eterra's band has bloomed (and the ash cleared) by how far the wait has come: no game, the game found, a character loading, only an item missing; each is one painted keyframe. It eases there over these many seconds, withering faster.
    out property <float> bloom-level-wilted: 0;
    out property <float> bloom-level-budding: 0.3;
    out property <float> bloom-level-opening: 0.6;
    out property <float> bloom-level-bloom: 1;
    out property <float> bloom-in-seconds: 2.4;
    out property <float> bloom-out-seconds: 0.8;

    // Eterra's band: this many image pixels of wood sit above the window's top edge; a keyframe spreads in with an edge this soft; the launch text keeps this gap below the lowest twig over its column. The band is centred on the eye and never hangs deeper than MaxDepth, so it crowns the launch text instead of outweighing it; where that leaves it narrower than the window, its cut ends dissolve over SideFeather.
    out property <length> eterra-band-cut: 80px;
    out property <length> eterra-band-feather: 140px;
    out property <length> eterra-band-gap: 16px;
    out property <length> eterra-band-max-depth: 150px;
    out property <length> eterra-band-side-feather: 160px;

    // The earlier keyframe holds until the later one has spread this far across, then fades out under it
    out property <float> eterra-band-handover: 0.7;

    // Fluent's compact menu item: MenuFlyoutItemThemePaddingNarrow 4 + the 14px title's 20px line + 4, measured on the C# app's row menu (design/captures/row-menu.png)
    out property <length> menu-item-height: 28px;

    // Fluent's choice box: the chevron's column at a choice box's right, after its 12px ComboBoxPadding and the choice
    out property <length> combo-box-glyph-column-width: 32px;

    // How far the menus' and flyouts' drop shadow spreads
    out property <length> flyout-shadow-blur: 12px;

    // The menus' and flyouts' drop shadow falls this far below them
    out property <length> flyout-shadow-offset-y: 4px;

    // Fluent's ScrollBarSize: an expanded scroll bar's width, its line buttons' height and its thumb's least length
    out property <length> scroll-bar-size: 16px;

    // Fluent's collapsed scroll bar (an eighth of its size): the resting thumb's width, measured at W-4..W-3 in design/captures/settings-680.png
    out property <length> scroll-bar-collapsed-size: 2px;

    // Fluent's collapsed scroll bar: the resting thumb's gap from the bar's outer edge
    out property <length> scroll-bar-collapsed-inset: 2px;

    // Fluent's ScrollBarButtonArrowIconFontSize: the line buttons' arrows on an expanded scroll bar
    out property <length> scroll-bar-arrow-size: 8px;

    // Avalonia's ScrollViewer.DefaultSmallChange: how far a line button scrolls
    out property <length> scroll-bar-small-change: 16px;

    // Fluent's toggle switch track (SwitchAreaGrid, 40 by 20)
    out property <length> toggle-track-width: 40px;

    // The toggle switch track's height; its ends are round, so its radius is half of this
    out property <length> toggle-track-height: 20px;

    // The toggle switch's knob at rest (Fluent's SwitchKnob, 10 by 10)
    out property <length> toggle-knob-size: 10px;

    // The toggle switch's knob under the pointer, as Fluent grows it
    out property <length> toggle-knob-hover-size: 12px;

    // The toggle switch's knob stretches to this width while pressed, as Fluent's does
    out property <length> toggle-knob-pressed-width: 14px;

    // The dot that marks the page now shown in the rail's Trainer flyout, as a radio menu item marks its choice
    out property <length> radio-mark-size: 6px;

    // The stroke of the tick drawn in the Mods list's check boxes
    out property <length> check-glyph-stroke-width: 1.5px;

    // Named insets, one per role
    out property <Inset> page-gutter: { left: 24px, top: 0px, right: 24px, bottom: 0px };
    out property <Inset> header-padding: { left: 0px, top: 20px, right: 0px, bottom: 14px };
    out property <Inset> status-strip-margin: { left: 0px, top: 10px, right: 0px, bottom: 0px };
    out property <Inset> pane-content-margin: { left: 20px, top: 18px, right: 20px, bottom: 20px };
    out property <Inset> notice-padding: { left: 12px, top: 10px, right: 12px, bottom: 10px };

    // Fluent's compact TextControlThemePadding, inside the text box's 1px frame
    out property <Inset> text-control-padding: { left: 4px, top: 2px, right: 4px, bottom: 2px };

    // A bordered summary on a page (Home): room for a heading, a paragraph and an action
    out property <Inset> ledger-entry-padding: { left: 8px, top: 6px, right: 8px, bottom: 6px };

    // Companion pages (Mods): title and list share one page inset; their lists run to the window's foot
    out property <Inset> preview-page-margin: { left: 24px, top: 20px, right: 24px, bottom: 0px };
    out property <Inset> preview-page-compact-margin: { left: 16px, top: 20px, right: 16px, bottom: 0px };
    out property <Inset> preview-header-margin: { left: 0px, top: 0px, right: 0px, bottom: 18px };

    // One line of an item's record (implicit, affix, unique modifier)
    out property <Inset> detail-row-margin: { left: 0px, top: 3px, right: 0px, bottom: 3px };

    // Mods: the list starts a step under its header; each setting in the pane is one row
    out property <Inset> mod-list-margin: { left: 0px, top: 4px, right: 0px, bottom: 0px };
    out property <Inset> setting-row-margin: { left: 0px, top: 6px, right: 0px, bottom: 6px };
    out property <Inset> unique-section-padding: { left: 12px, top: 14px, right: 12px, bottom: 10px };
    out property <Inset> unique-section-margin: { left: 0px, top: 24px, right: 0px, bottom: 0px };
    out property <Inset> unique-section-beside-margin: { left: 24px, top: 26px, right: 0px, bottom: 0px };

    // Maximized without unique modifiers: the selected affix's tier ladder beside the table, its label on the table's label row
    out property <Inset> tier-ladder-beside-margin: { left: 24px, top: 0px, right: 0px, bottom: 0px };
    out property <Inset> unique-row-margin: { left: 0px, top: 8px, right: 0px, bottom: 8px };

    // Implicits sit above the affix table, their cells on the table's columns
    out property <Inset> implicit-section-margin: { left: 0px, top: 0px, right: 0px, bottom: 18px };
    out property <Inset> implicit-row-margin: { left: 13px, top: 6px, right: 13px, bottom: 6px };
    out property <Inset> lists-bottom-margin: { left: 0px, top: 0px, right: 0px, bottom: 20px };
    out property <Inset> table-header-inset: { left: 13px, top: 0px, right: 13px, bottom: 0px };
    out property <Inset> row-gap: { left: 0px, top: 0px, right: 0px, bottom: 2px };
    out property <Inset> row-padding: { left: 12px, top: 0px, right: 12px, bottom: 0px };
    out property <Inset> action-bar-padding: { left: 24px, top: 12px, right: 24px, bottom: 12px };

    // Launch text: the side gutters and the least room above and below it when no twig hangs over it
    out property <Inset> empty-state-margin: { left: 40px, top: 48px, right: 40px, bottom: 48px };

    // The empty forge sits a little above the middle of the page; its own art will take the space above the title
    out property <Inset> forge-empty-margin: { left: 40px, top: 24px, right: 40px, bottom: 72px };
    out property <Inset> empty-action-margin: { left: 0px, top: 8px, right: 0px, bottom: 0px };
    out property <Inset> nav-brand-margin: { left: 12px, top: 12px, right: 8px, bottom: 16px };
    out property <Inset> nav-brand-collapsed-margin: { left: 8px, top: 12px, right: 8px, bottom: 16px };
    out property <Inset> nav-brand-text-margin: { left: 6px, top: 0px, right: 0px, bottom: 0px };
    out property <Inset> nav-list-margin: { left: 8px, top: 0px, right: 8px, bottom: 0px };
    out property <Inset> nav-item-padding: { left: 10px, top: 0px, right: 10px, bottom: 0px };

    // A page under the Trainer item: its icon sits under the item's label (10 + 20 icon + 12 gap, less the 10 padding)
    out property <Inset> nav-child-indent: { left: 32px, top: 0px, right: 0px, bottom: 0px };
    out property <Inset> nav-footer-margin: { left: 8px, top: 8px, right: 8px, bottom: 8px };
    out property <Inset> nav-status-padding: { left: 16px, top: 12px, right: 16px, bottom: 12px };
    out property <Inset> nav-status-collapsed-padding: { left: 8px, top: 12px, right: 8px, bottom: 12px };
    out property <Inset> nav-status-icon-collapsed-margin: { left: 12px, top: 0px, right: 0px, bottom: 0px };
    out property <Inset> settings-body-margin: { left: 24px, top: 20px, right: 24px, bottom: 24px };
    out property <Inset> settings-body-compact-margin: { left: 16px, top: 20px, right: 16px, bottom: 24px };
    out property <Inset> settings-title-margin: { left: 0px, top: 0px, right: 0px, bottom: 24px };
    out property <Inset> setting-group-padding: { left: 0px, top: 0px, right: 0px, bottom: 24px };
    out property <Inset> setting-group-margin: { left: 0px, top: 0px, right: 0px, bottom: 24px };

    // Trainer pages: a strip of sections along the top, then rows on the Settings grid
    out property <Inset> section-bar-padding: { left: 24px, top: 4px, right: 24px, bottom: 0px };
    out property <Inset> section-bar-compact-padding: { left: 16px, top: 4px, right: 16px, bottom: 0px };
    out property <Inset> section-tab-padding: { left: 0px, top: 12px, right: 0px, bottom: 10px };
    out property <Inset> section-tab-indicator: { left: 0px, top: 0px, right: 0px, bottom: 2px };
    out property <Inset> trainer-body-margin: { left: 24px, top: 20px, right: 24px, bottom: 24px };
    out property <Inset> trainer-body-compact-margin: { left: 16px, top: 20px, right: 16px, bottom: 24px };
    out property <Inset> search-icon-margin: { left: 10px, top: 0px, right: 2px, bottom: 0px };
    out property <Inset> empty-list-margin: { left: 4px, top: 8px, right: 4px, bottom: 8px };
    out property <Inset> catalog-entry-margin: { left: 0px, top: 7px, right: 0px, bottom: 7px };
    out property <Inset> icon-baseline-nudge: { left: 0px, top: 1px, right: 0px, bottom: 0px };

    // A mark that comes and goes before centred words: its gap travels with it, so hidden it leaves the words centred
    out property <Inset> leading-mark-margin: { left: 0px, top: 0px, right: 8px, bottom: 0px };
    out property <Inset> button-padding: { left: 12px, top: 6px, right: 12px, bottom: 6px };
    out property <Inset> primary-button-padding: { left: 16px, top: 6px, right: 16px, bottom: 6px };
    out property <Inset> icon-button-padding: { left: 8px, top: 8px, right: 8px, bottom: 8px };
    out property <Inset> compact-icon-button-padding: { left: 4px, top: 4px, right: 4px, bottom: 4px };

    // A (?) help button: its padding taken back, so the line keeps the bare icon's height and gap
    out property <Inset> help-button-outdent: { left: -4px, top: -4px, right: -4px, bottom: -4px };

    // A check box's caption starts under its label, past the box
    out property <Inset> check-box-caption-margin: { left: 28px, top: 0px, right: 0px, bottom: 0px };
    out property <Inset> border-all: { left: 1px, top: 1px, right: 1px, bottom: 1px };
    out property <Inset> border-top: { left: 0px, top: 1px, right: 0px, bottom: 0px };
    out property <Inset> border-right: { left: 0px, top: 0px, right: 1px, bottom: 0px };
    out property <Inset> border-bottom: { left: 0px, top: 0px, right: 0px, bottom: 1px };
    out property <Inset> aura-outdent: { left: -4px, top: -3px, right: -4px, bottom: -3px };

    // "No mods yet" sits where the first row would, under the list's header
    out property <Inset> mods-empty-margin: { left: 13px, top: 12px, right: 13px, bottom: 0px };

    // Mod projects not installed sit a section under the installed list; a row's content keeps a list row's inset (padding + border)
    out property <Inset> mod-sources-margin: { left: 0px, top: 24px, right: 0px, bottom: 0px };
    out property <Inset> mod-source-row-padding: { left: 13px, top: 0px, right: 13px, bottom: 0px };

    // A trainer feature's row: its padding is outdented, so the hover ground runs past its words and they keep the page's edge
    out property <Inset> feature-row-padding: { left: 8px, top: 10px, right: 8px, bottom: 10px };
    out property <Inset> feature-row-outdent: { left: -8px, top: 0px, right: -8px, bottom: 0px };

    // The unit after a value box's number, in a slot every box keeps
    out property <Inset> feature-unit-margin: { left: 2px, top: 0px, right: 8px, bottom: 0px };

    // What a title holds (values, fields, a faction's heading) sits this far in under it
    out property <Inset> feature-nested-indent: { left: 24px, top: 0px, right: 0px, bottom: 0px };
    out property <Inset> feature-nested-group-margin: { left: 24px, top: 12px, right: 0px, bottom: 0px };

    // A title's (?) after its last word: the help button's outdent, less the gap before it
    out property <Inset> feature-title-help-margin: { left: 2px, top: -4px, right: -4px, bottom: -4px };

    // The check or error mark before a status line, on its first line's baseline
    out property <Inset> feature-status-icon-margin: { left: 0px, top: 2px, right: 6px, bottom: 0px };
    out property <Inset> feature-fields-margin: { left: 0px, top: 6px, right: 0px, bottom: 0px };

    // Where it stands in the game, under its title or its values
    out property <Inset> feature-status-margin: { left: 0px, top: 4px, right: 0px, bottom: 0px };

    // An editor's Apply under its fields, and its status beside it
    out property <Inset> feature-action-margin: { left: 0px, top: 8px, right: 0px, bottom: 0px };

    // A stacked page's section heading: 24 below the group before (the rows' panel keeps it, none above the first in a column), 4 above its rows
    out property <Inset> feature-group-margin: { left: 0px, top: 0px, right: 0px, bottom: 4px };

    // A mod's settings group heads its rows as "Settings" does (6 + the row's 6), 18 below the group before like the pane's sections (12 + the row's 6)
    out property <Inset> mod-setting-group-margin: { left: 0px, top: 12px, right: 0px, bottom: 6px };
    out property <Inset> mod-setting-first-group-margin: { left: 0px, top: 0px, right: 0px, bottom: 6px };

    // A unit inside a setting's box, after the number
    out property <Inset> mod-setting-unit-margin: { left: 0px, top: 0px, right: 8px, bottom: 0px };

    // A value cell's padding, and the outdent that takes it back so the cell's words keep the column's edge
    out property <Inset> cell-padding: { left: 6px, top: 4px, right: 6px, bottom: 4px };
    out property <Inset> cell-outdent: { left: -6px, top: 0px, right: -6px, bottom: 0px };

    // A cell inside a line of text: outdented both ways, so hovering it never moves the line
    out property <Inset> inline-cell-outdent: { left: -6px, top: -4px, right: -6px, bottom: -4px };
    out property <Inset> flyout-padding: { left: 16px, top: 14px, right: 16px, bottom: 14px };

    // Status flags (corrupted, ruined) are toggles: muted when off, outlined when on
    out property <Inset> flag-padding: { left: 8px, top: 3px, right: 8px, bottom: 3px };

    // Fluent's compact MenuFlyoutItemThemePaddingNarrow: a context menu row's padding, inside the menu's 1px frame
    out property <Inset> menu-item-padding: { left: 4px, top: 4px, right: 8px, bottom: 4px };

    // Fluent's MenuFlyoutScrollerMargin: room above the first row and below the last
    out property <Inset> menu-flyout-scroller-margin: { left: 0px, top: 4px, right: 0px, bottom: 4px };

    // Fluent's MenuFlyoutSeparatorThemePadding: a separator's 1px line between groups of a context menu
    out property <Inset> menu-separator-margin: { left: 12px, top: 4px, right: 12px, bottom: 4px };

    // Fluent's MenuInputGestureTextMargin: the key column keeps this room after the title, even when a row names no key
    out property <Inset> menu-gesture-margin: { left: 24px, top: 0px, right: 0px, bottom: 0px };

    // Corner radii
    out property <length> control-radius: 2px;

    // Fluent's OverlayCornerRadius: context menus round their corners by this much
    out property <length> overlay-radius: 5px;

    // The trainer row's value column
    out property <length> feature-value-column-width: 112px;

    // In-place affix row: [value] [name] [tier] [seal] [type] [status]
    out property <length> affix-value-column-width: 150px;
    out property <length> affix-tier-column-width: 52px;
    out property <length> affix-seal-column-width: 104px;
    out property <length> affix-status-column-width: 20px;

    // Motion: one authored settle when readback confirms a row; off when Windows animation effects are off
    out property <duration> settle-duration: 220ms;

    // A new page fades in (the old one goes at once), so the launch screen, the forge and Settings never swap in a single frame
    out property <duration> page-transition-duration: 180ms;

    // Avalonia's ToolTip.ShowDelay default, the hover delay before a tip opens
    out property <duration> tip-show-delay: 400ms;

    // A tip no longer wanted stays this long, so the pointer can cross onto the bubble and keep it open (WCAG 1.4.13)
    out property <duration> tip-linger-duration: 200ms;

    // Fluent's scroll bar: the thumb's widening and the track's and arrows' fade when a scroll bar expands or collapses
    out property <duration> scroll-bar-transition-duration: 100ms;

    // Avalonia's ScrollBar.ShowDelay default: the pointer rests on a scroll bar this long before it expands
    out property <duration> scroll-bar-show-delay: 500ms;

    // Avalonia's ScrollBar.HideDelay default: a scroll bar the pointer left collapses after this long
    out property <duration> scroll-bar-hide-delay: 2000ms;

    // The toggle switch's knob slides across this fast when it flips; off when Windows animation effects are off
    out property <duration> toggle-knob-duration: 120ms;

    // Icons: Fluent System Icons, 20px regular (MIT, Microsoft; licence in fonts/FluentSystemIcons-LICENSE.txt). Each SVG's view box is the square round its path, centred, so it fills a square box.
    out property <image> icon-home: @image-url("icons/home.svg");
    out property <image> icon-forge: @image-url("icons/forge.svg");
    out property <image> icon-settings: @image-url("icons/settings.svg");
    out property <image> icon-confirmed: @image-url("icons/confirmed.svg");
    out property <image> icon-warning: @image-url("icons/warning.svg");
    out property <image> icon-error: @image-url("icons/error.svg");
    out property <image> icon-undo: @image-url("icons/undo.svg");
    out property <image> icon-search: @image-url("icons/search.svg");
    out property <image> icon-locked: @image-url("icons/locked.svg");
    out property <image> icon-info: @image-url("icons/info.svg");
    out property <image> icon-help: @image-url("icons/help.svg");
    out property <image> icon-connected: @image-url("icons/connected.svg");
    out property <image> icon-disconnected: @image-url("icons/disconnected.svg");
    out property <image> icon-add: @image-url("icons/add.svg");
    out property <image> icon-remove: @image-url("icons/remove.svg");
    out property <image> icon-close: @image-url("icons/close.svg");
    out property <image> icon-replace: @image-url("icons/replace.svg");
    out property <image> icon-refresh: @image-url("icons/refresh.svg");
    out property <image> icon-folder: @image-url("icons/folder.svg");
    out property <image> icon-pane-collapse: @image-url("icons/pane-collapse.svg");
    out property <image> icon-pane-expand: @image-url("icons/pane-expand.svg");
    out property <image> icon-draft: @image-url("icons/draft.svg");
    out property <image> icon-stash: @image-url("icons/stash.svg");
    out property <image> icon-play: @image-url("icons/play.svg");
    out property <image> icon-mods: @image-url("icons/mods.svg");
    out property <image> icon-log: @image-url("icons/log.svg");
    out property <image> icon-bug: @image-url("icons/bug.svg");
    out property <image> icon-delete: @image-url("icons/delete.svg");

    // Trainer pages: person, target, diamond, hourglass, flag and globe
    out property <image> icon-character: @image-url("icons/character.svg");
    out property <image> icon-combat: @image-url("icons/combat.svg");
    out property <image> icon-loot: @image-url("icons/loot.svg");
    out property <image> icon-monolith: @image-url("icons/monolith.svg");
    out property <image> icon-factions: @image-url("icons/factions.svg");
    out property <image> icon-world: @image-url("icons/world.svg");

    // The Trainer item holding those pages (toolbox), and its open and close chevrons
    out property <image> icon-trainer: @image-url("icons/trainer.svg");
    out property <image> icon-chevron-down: @image-url("icons/chevron-down.svg");
    out property <image> icon-chevron-up: @image-url("icons/chevron-up.svg");

    // Fluent's scroll bar arrow (MIT): the expanded scroll bar's line-up arrow
    out property <image> icon-scroll-up: @image-url("icons/scroll-up.svg");

    // Fluent's scroll bar arrow (MIT): the expanded scroll bar's line-down arrow
    out property <image> icon-scroll-down: @image-url("icons/scroll-down.svg");
}
