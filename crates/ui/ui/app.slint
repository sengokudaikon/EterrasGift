// The main window: navigation beside the page host.

import { Tokens } from "tokens.slint";
import { Nav, NavRow, NavOutcome, Connection, KeyboardFocus, Tip, WindowSize } from "globals.slint";
import { TipBubble } from "widgets/focus.slint";
import { NavPane } from "shell/nav.slint";
import { HomePage, HomeState, LaunchMode, BloomPhase } from "pages/home.slint";
import { LogsPage, LogsState } from "pages/logs.slint";
import { ModsPage, ModsState, ModRow, SourceRow, ModSettingRow, SettingChoiceRow, ModLogRow } from "pages/mods.slint";
import { SettingsPage, SettingsState, LocationSetting, ModuleRow, SettingsSectionRow } from "pages/settings.slint";
import { TrainerPage, TrainerState, TrainerAccess, FeatureRowKind, FeatureTone, FeatureValueView, FeatureFieldView, FeatureRowView, FeatureRowModels, FeatureRowPlace } from "pages/trainer.slint";
import { ForgeState, CellKind, CellRef, ItemRarity, ValueCell, TierOption, AffixRowView, ModifierRowView, FieldView, DraftEntryView, AppliedEntryView, MenuOptionView,
    PickerRowView, TemplateRowView } from "pages/forge/state.slint";
import { PillTone, PillView } from "widgets/pill.slint";
import { MessageTone } from "pages/common.slint";
import { Eterra, Mote } from "decorations.slint";
import { ShellText } from "strings/shell.slint";

export { ForgeState, CellKind, CellRef, ItemRarity, ValueCell, TierOption, AffixRowView, ModifierRowView, FieldView, DraftEntryView, AppliedEntryView, MenuOptionView,
    PickerRowView, TemplateRowView, PillTone, PillView }

export { Tokens, Nav, NavRow, NavOutcome, Connection, HomeState, LaunchMode, BloomPhase, LogsState, ModsState, ModRow, SourceRow, ModSettingRow, SettingChoiceRow, ModLogRow, SettingsState, LocationSetting, ModuleRow, SettingsSectionRow, TrainerState, TrainerAccess, FeatureRowKind, FeatureTone, FeatureValueView, FeatureFieldView, FeatureRowView, FeatureRowModels, FeatureRowPlace, MessageTone, Eterra, Mote, Tip }

export component MainWindow inherits Window {
    title: ShellText.app-name;
    preferred-width: Tokens.window-default-width;
    preferred-height: Tokens.window-default-height;
    min-width: Tokens.window-min-width;
    min-height: Tokens.window-min-height;
    background: Tokens.ground-brush;
    default-font-family: Tokens.body-font;
    default-font-size: Tokens.font-size-body;

    // Size classes, recomputed with the window's width; narrow implies compact.
    out property <bool> narrow: root.width < Tokens.narrow-window-width;
    out property <bool> compact: root.width < Tokens.compact-window-width;
    out property <bool> wide: root.width >= Tokens.wide-window-width;

    // Crossing the wide threshold expands or collapses the pane; the user's toggle holds in between.
    changed wide => {
        Nav.wide-changed(root.wide);
    }

    init => {
        WindowSize.width = root.width;
        WindowSize.height = root.height;
    }
    changed width => {
        WindowSize.width = root.width;
    }
    changed height => {
        WindowSize.height = root.height;
    }

    // A tip belongs to the control under it; a new page or a different pane leaves none behind.
    property <string> page: Nav.current-page;
    property <bool> pane-open: Nav.pane-open;
    changed page => {
        Tip.open = false;
    }
    // Rust counts only the pages after the first, so the page the app starts on never fades in, even when it is not Home.
    property <int> page-serial: Nav.page-serial;
    changed page-serial => {
        host.enter();
    }
    changed pane-open => {
        Tip.open = false;
    }

    // Focus visuals show once a navigation key is pressed; widgets hide them again on a pointer press. In a text box the
    // arrows, Home, End and the page keys move the caret, not focus, so they leave the visuals as they are: a click into a
    // box and then Left shows no ring and no tip (as `KeyboardToolTips` opens a tip only when focus arrives by Tab or
    // direction).
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            // Esc closes an open tip first, as Windows' tooltips do (WCAG 1.4.13); the next Esc reaches the control.
            if (event.text == Key.Escape && Tip.open) {
                Tip.open = false;
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.F6) {
                KeyboardFocus.visible = true;
            } else if (!TextInputInterface.text-input-focused && (event.text == Key.UpArrow || event.text == Key.DownArrow
                || event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.Home || event.text == Key.End
                || event.text == Key.PageUp || event.text == Key.PageDown)) {
                KeyboardFocus.visible = true;
            }
            reject
        }

        nav := NavPane {
            x: 0;
            y: 0;
            height: root.height;
        }

        // Pages swap in place: the old one goes at once, the new one fades in (none for the first page, and none with
        // Windows animation effects off).
        host := Rectangle {
            x: nav.width;
            y: 0;
            width: root.width - nav.width;
            height: root.height;

            property <bool> entering;
            property <duration> entered-at;
            property <float> progress: Math.clamp((animation-tick() - self.entered-at) / Tokens.page-transition-duration, 0, 1);

            public function enter() {
                if (Tokens.motion) {
                    self.entered-at = animation-tick();
                    self.entering = true;
                }
            }

            // Cubic ease-out; reading animation-tick() only while entering keeps the window idle otherwise.
            opacity: self.entering ? 1 - (1 - self.progress) * (1 - self.progress) * (1 - self.progress) : 1;

            Timer {
                interval: Tokens.page-transition-duration;
                running: host.entering;
                triggered => {
                    host.entering = false;
                }
            }

            if root.page == "home": HomePage { }
            if root.page == "mods": ModsPage {
                compact: root.compact;
                wide: root.wide;
            }
            if root.page == "logs": LogsPage { compact: root.compact; }
            if root.page == "settings": SettingsPage { compact: root.compact; }
            if root.page != "home" && root.page != "mods" && root.page != "settings" && root.page != "logs": TrainerPage {
                page-id: root.page;
                page-title: Nav.current-title;
                compact: root.compact;
                narrow: root.narrow;
                wide: root.wide;
            }
        }

        if Tip.open && !Tip.in-flyout: TipBubble {
            window-width: root.width;
            window-height: root.height;
        }
    }
}
