// State shared between the views and Rust. Rust owns the truth (crates/ui/src); these globals carry it to the views and
// carry the user's actions back as callbacks.

import { ShellText } from "strings/shell.slint";

// One row of the navigation pane. `parent` marks the Trainer item, which holds pages but is never a page itself.
export struct NavRow {
    id: string,
    title: string,
    icon: image,
    child: bool,
    parent: bool,
    expanded: bool,
    selected: bool,
}

// What a navigation key or click asks the view to do. Rust decides; the view only shows the rail flyout.
export enum NavOutcome { ignored, handled, open-flyout }

export global Nav {
    // Rows of the pane and of its foot (Settings). The keyboard treats them as one list: foot index = rows.length + i.
    in property <[NavRow]> rows;
    in property <[NavRow]> footer;
    // The Trainer item's pages, listed by the rail's flyout.
    in property <[NavRow]> flyout-pages;
    in property <string> current-page: "home";
    in property <string> current-title: ShellText.home;
    in property <bool> pane-open;
    // Rust asks a row to take keyboard focus by setting these; the row clears `focus-row` once it has focus.
    in-out property <int> focus-row: -1;
    in property <int> focus-serial;
    // The row that takes the navigation's single tab stop.
    in property <int> tab-row;
    // Counts the pages that came to show after the first; each one fades in, the first never does.
    in property <int> page-serial;

    callback row-clicked(int) -> NavOutcome;
    callback row-key(int, string, bool) -> NavOutcome;
    callback toggle-pane();
    callback navigate(string);
    callback wide-changed(bool);
}

// The trainer's connection, shown at the foot of the navigation.
export global Connection {
    in property <bool> present;
    in property <bool> connected;
    in property <bool> blocked;
    in property <string> text: ShellText.not-connected;
    in property <bool> show-action;
    in property <string> action-text: ShellText.connect;

    callback connect();
}

// Focus visuals show only while the keyboard is driving (Windows convention); a pointer press hides them again.
export global KeyboardFocus {
    in-out property <bool> visible;
}

// The one tooltip on screen, drawn by MainWindow above everything so no pane clips it.
export enum TipPlacement { below, right }

export global Tip {
    in-out property <bool> open;
    in-out property <string> text;
    // Who put the tip up: each opening takes the next number, and only that opener updates or closes it. Two controls
    // with the same text are still two owners (keyboard focus moving between them must not close the new one's tip).
    in-out property <int> owner;
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
    in-out property <TipPlacement> placement;
    // The pointer is on the bubble: it stays open while the pointer reads it (WCAG 1.4.13).
    in-out property <bool> bubble-hovered;
    // Raised inside a flyout's popup: its anchor is in the popup's coordinates, and the window's bubble would lie under
    // the popup, so the flyout draws the bubble itself (`TipBubble` as its last child) and the window draws none.
    in-out property <bool> in-flyout;
}
