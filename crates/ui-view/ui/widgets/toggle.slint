// Windows' toggle switch with its on/off words beside it, retinted: the bronze-gold accent when on.

import { Tokens } from "../tokens.slint";
import { KeyboardFocus } from "../globals.slint";
import { FocusRing } from "focus.slint";
import { ShellText } from "../strings/shell.slint";

export component ToggleSwitch inherits Rectangle {
    in property <bool> checked;
    in property <string> on-text: ShellText.on;
    in property <string> off-text: ShellText.off;
    in property <string> label;
    in property <bool> enabled: true;
    callback toggled(bool);

    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.flip(); }

    function flip() {
        if (root.enabled) {
            root.toggled(!root.checked);
        }
    }

    min-height: Tokens.control-min-height;

    HorizontalLayout {
        spacing: Tokens.space-12;
        alignment: start;

        track := Rectangle {
            width: Tokens.toggle-track-width;
            height: Tokens.toggle-track-height;
            y: (parent.height - self.height) / 2;
            border-radius: self.height / 2;
            // Fluent's switch on the retinted palette: off, a BaseMedium outline (BaseHigh under the pointer) round a knob in
            // the text colour; on, the accent fill, darker while pressed. The knob grows under the pointer and stretches while
            // pressed.
            border-width: root.checked ? 0px : 1px;
            border-color: !root.enabled ? Tokens.text-disabled-brush : touch.has-hover ? Tokens.text-brush
                : (Tokens.high-contrast ? Tokens.text-secondary-brush : Tokens.fluent-base-medium-color);
            background: root.checked ? (!root.enabled ? Tokens.text-disabled-brush : touch.pressed ? Tokens.accent-pressed-brush : Tokens.accent-brush)
                : (touch.pressed ? Tokens.selected-brush : touch.has-hover ? Tokens.hover-brush : Tokens.ground-brush);

            Rectangle {
                property <length> size: touch.has-hover || touch.pressed ? Tokens.toggle-knob-hover-size : Tokens.toggle-knob-size;
                width: touch.pressed ? Tokens.toggle-knob-pressed-width : self.size;
                height: self.size;
                y: (parent.height - self.height) / 2;
                x: root.checked ? parent.width - self.width - (parent.height - self.size) / 2 : (parent.height - self.size) / 2;
                border-radius: self.height / 2;
                background: root.checked ? Tokens.on-accent-brush : !root.enabled ? Tokens.text-disabled-brush : Tokens.text-brush;
                animate x { duration: Tokens.toggle-knob-duration; easing: ease-out; enabled: Tokens.motion; }
            }

            FocusRing {
                focused: focus.has-focus;
                radius: parent.height / 2;
            }
        }

        Text {
            text: root.checked ? root.on-text : root.off-text;
            color: root.enabled ? Tokens.text-brush : Tokens.text-disabled-brush;
            vertical-alignment: center;
        }
    }

    focus := FocusScope {
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) {
                KeyboardFocus.visible = true;
            }
        }
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.flip();
                return accept;
            }
            reject
        }

        touch := TouchArea {
            enabled: root.enabled;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    KeyboardFocus.visible = false;
                }
            }
            clicked => {
                focus.focus();
                root.flip();
            }
        }
    }
}
