// Menus on the app's own surface. Slint's own ContextMenuArea is a native menu on Windows that can't take the app's look,
// so menus are these:
//
// - `OptionMenu`, the list of choices a cell opens under itself (a rarity, a base, a tier), its rows given as children.
// - `PopupMenu`, a context menu on an `OptionMenu`, in Fluent's compact density on the retinted palette: Dusk Brown in a
//   Weathered Taupe frame over a soft shadow, 28px rows of [icon | title | key] in Noto Sans, separators between groups.
//   Declare it as a child of the element whose coordinates you'll give, and open it with `open-at`: at the pointer for a
//   right-click, under the row for the menu key or Shift+F10. Up and Down move (wrapping, skipping separators and disabled
//   rows), Home and End go to the ends, Enter or Space picks, and Escape, Tab or Shift+Tab closes it; closing gives focus
//   back to whatever had it.

import { Tokens } from "../tokens.slint";
import { KeyboardFocus } from "../globals.slint";

// The ground of every menu and flyout: Dusk Brown in the strong-line frame, as the tooltip and the rail's flyout have it,
// over a soft drop shadow so it lifts off the near-black page (the 2026-10-20 audit measured Fluent's faint frame at
// about 1.02:1). The software renderer draws no shadows, so captures show the frame alone.
export component FlyoutSurface inherits Rectangle {
    background: Tokens.hover-brush;
    border-width: 1px;
    border-color: Tokens.strong-line-brush;
    border-radius: Tokens.control-radius;
    drop-shadow-color: Tokens.flyout-shadow-color;
    drop-shadow-blur: Tokens.flyout-shadow-blur;
    drop-shadow-offset-y: Tokens.flyout-shadow-offset-y;
}

// The height of an option menu of `rows` one-line rows: 30px rows 2px apart inside the flyout padding.
export global MenuMetrics {
    out property <length> row: Tokens.font-size-value * 4 / 3 + Tokens.cell-padding.top + Tokens.cell-padding.bottom + 2px;

    public pure function height(rows: int) -> length {
        return rows * self.row + Math.max(0, rows - 1) * Tokens.space-2 + Tokens.flyout-padding.top + Tokens.flyout-padding.bottom + 2px;
    }
}

// A list of choices under the cell that opens it, on the flyout surface. It fills a PopupWindow of the caller's (popups
// need an explicit size), whose `close()` its `close` calls: a component inheriting PopupWindow can't sit under an `if`.
// Its children are its rows: each reads `highlighted` (and `keys-focused`, where the highlight shows only while the list
// has the keys) and calls `choose(index)` when clicked.
//
// It opens with the keys on the list, at `initial()`. Up and Down move by `step`, Home and End go to the ends, Enter or Space
// picks, and Escape closes from anywhere in it. A key pressed in another control inside it, such as a search box, stays with
// that control. A close from the keyboard says `returned`, for the caller to give focus back to the cell.
export component OptionMenu inherits FlyoutSurface {
    // How many entries it lists.
    in property <int> count;
    // What the list is, for assistive technology.
    in property <string> label;
    // The space between its children, and round them inside the frame.
    in property <length> spacing: Tokens.space-2;
    in property <length> inset-left: Tokens.flyout-padding.left;
    in property <length> inset-right: Tokens.flyout-padding.right;
    in property <length> inset-top: Tokens.flyout-padding.top;
    in property <length> inset-bottom: Tokens.flyout-padding.bottom;
    // It keeps the keyboard while it is open, as a context menu does: Tab and Shift+Tab close it, and no key reaches past
    // it.
    in property <bool> keeps-keyboard;
    // The entry the keys act on; -1 for none.
    in-out property <int> highlighted: -1;
    // The entry the keys start on, and the next entry they can reach from `from` in `direction` (`from` when there is
    // none). An entry can be picked when the step from just before it lands on it.
    pure callback initial() -> int;
    pure callback step(int, int) -> int;
    // An entry was picked, by a click or a key. The menu has closed.
    callback picked(int);
    // It closed from the keyboard: Escape, or a pick with Enter or Space.
    callback returned();
    // Closes the popup it fills.
    callback close();
    // The keys are on the list, so its highlight shows.
    out property <bool> keys-focused: keys.has-focus;

    // Picks `index`, if it can be picked: a row's click.
    public function choose(index: int) {
        if (root.usable(index)) {
            root.close();
            root.picked(index);
        }
    }

    // Hands the keys to the list, at `initial()`: a search box's Down.
    public function focus-keys() {
        root.highlighted = root.initial();
        KeyboardFocus.visible = true;
        keys.focus();
    }

    pure function usable(index: int) -> bool {
        return index >= 0 && index < root.count && root.step(index - 1, 1) == index;
    }

    keys := FocusScope {
        accessible-role: list;
        accessible-label: root.label;
        init => {
            root.highlighted = root.initial();
            self.focus();
        }
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) {
                KeyboardFocus.visible = true;
            }
        }
        capture-key-pressed(event) => {
            if (event.text == Key.Escape || (root.keeps-keyboard && (event.text == Key.Tab || event.text == Key.Backtab))) {
                root.close();
                root.returned();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            // Passed on by another control inside it.
            if (!self.has-focus) {
                return reject;
            }
            if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                KeyboardFocus.visible = true;
                root.highlighted = root.step(root.highlighted, event.text == Key.UpArrow ? -1 : 1);
                return accept;
            }
            if (event.text == Key.Home) {
                KeyboardFocus.visible = true;
                root.highlighted = root.step(-1, 1);
                return accept;
            }
            if (event.text == Key.End) {
                KeyboardFocus.visible = true;
                root.highlighted = root.step(root.count, -1);
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") {
                if (root.usable(root.highlighted)) {
                    root.choose(root.highlighted);
                    root.returned();
                }
                return accept;
            }
            root.keeps-keyboard ? accept : reject
        }

        VerticalLayout {
            padding-left: root.inset-left;
            padding-right: root.inset-right;
            padding-top: root.inset-top;
            padding-bottom: root.inset-bottom;
            spacing: root.spacing;
            alignment: start;

            @children
        }
    }
}

export struct MenuEntry {
    title: string,
    // Drawn in the row's text colour; a row without one keeps the column blank, so titles line up.
    icon: image,
    // The key that does the same outside the menu ("Space", "Delete"), muted at the row's end.
    gesture: string,
    disabled: bool,
    // A line between groups; its other fields are ignored.
    separator: bool,
}

// It is itself a zero-size anchor (popups' insides can't be reached from outside, so the PopupWindow sits inside it).
export component PopupMenu inherits Rectangle {
    in property <[MenuEntry]> entries;
    // The icon column, kept for every row when any row has an icon, so the titles line up.
    in property <bool> has-icons: true;
    // A row picked, by its index in `entries`. The menu has closed by then.
    callback activated(int);

    // Opened from the keyboard: the first row it can pick starts highlighted. From the pointer none does, until a key is
    // pressed.
    property <bool> keyboard-open;
    property <length> icon-column: root.has-icons ? Tokens.icon-size + Tokens.space-12 : 0px;

    // Opens with its top-left corner at (at-x, at-y) in the coordinates of the element it's declared in. From the
    // keyboard the first row it can pick is highlighted, so Enter acts at once.
    public function open-at(at-x: length, at-y: length, keyboard: bool) {
        root.at-x = at-x;
        root.at-y = at-y;
        root.keyboard-open = keyboard;
        if (keyboard) {
            KeyboardFocus.visible = true;
        }
        popup.show();
    }

    property <length> at-x;
    property <length> at-y;
    // Popups need an explicit size (crates/ui/README.md): measured from hidden copies of the rows.
    property <length> menu-width: 2px + Tokens.menu-item-padding.left + root.icon-column + titles.preferred-width + Tokens.menu-gesture-margin.left + gestures.preferred-width + Tokens.menu-item-padding.right;
    property <length> menu-height: 2px + Tokens.menu-flyout-scroller-margin.top + heights.preferred-height + Tokens.menu-flyout-scroller-margin.bottom;
    // At its parent's origin, so `open-at` takes the parent's coordinates (sized but unplaced, it would be centred).
    x: 0px;
    y: 0px;
    width: 0px;
    height: 0px;

    pure function usable(index: int) -> bool {
        return index >= 0 && index < root.entries.length && !root.entries[index].separator && !root.entries[index].disabled;
    }
    pure function wrap(index: int) -> int {
        return Math.mod(index, Math.max(1, root.entries.length));
    }
    // The next row it can pick from `from` in `direction`, wrapping; `from` itself when there's none. Slint has no loops,
    // so it looks eight rows on, more than a context menu skips in a row.
    pure function step(from: int, direction: int) -> int {
        let start = from < 0 && direction < 0 ? 0 : from;
        if (root.usable(root.wrap(start + direction))) { return root.wrap(start + direction); }
        if (root.usable(root.wrap(start + 2 * direction))) { return root.wrap(start + 2 * direction); }
        if (root.usable(root.wrap(start + 3 * direction))) { return root.wrap(start + 3 * direction); }
        if (root.usable(root.wrap(start + 4 * direction))) { return root.wrap(start + 4 * direction); }
        if (root.usable(root.wrap(start + 5 * direction))) { return root.wrap(start + 5 * direction); }
        if (root.usable(root.wrap(start + 6 * direction))) { return root.wrap(start + 6 * direction); }
        if (root.usable(root.wrap(start + 7 * direction))) { return root.wrap(start + 7 * direction); }
        if (root.usable(root.wrap(start + 8 * direction))) { return root.wrap(start + 8 * direction); }
        return from;
    }

    // Hidden copies of the titles, keys and row heights, for the menu's size.
    titles := VerticalLayout {
        visible: false;
        for entry in root.entries: Text { text: entry.separator ? "" : entry.title; font-size: Tokens.font-size-value; }
    }
    gestures := VerticalLayout {
        visible: false;
        for entry in root.entries: Text { text: entry.separator ? "" : entry.gesture; font-size: Tokens.font-size-caption; }
    }
    heights := VerticalLayout {
        visible: false;
        for entry in root.entries: Rectangle {
            height: entry.separator ? Tokens.menu-separator-margin.top + 1px + Tokens.menu-separator-margin.bottom : Tokens.menu-item-height;
        }
    }

    popup := PopupWindow {
        x: root.at-x;
        y: root.at-y;
        width: root.menu-width;
        height: root.menu-height;
        close-policy: PopupClosePolicy.close-on-click-outside;

        menu := OptionMenu {
            border-radius: Tokens.overlay-radius;
            inset-left: 1px;
            inset-right: 1px;
            inset-top: 1px + Tokens.menu-flyout-scroller-margin.top;
            inset-bottom: 1px + Tokens.menu-flyout-scroller-margin.bottom;
            spacing: 0px;
            keeps-keyboard: true;
            count: root.entries.length;
            initial => {
                return root.keyboard-open ? root.step(-1, 1) : -1;
            }
            step(from, direction) => {
                return root.step(from, direction);
            }
            picked(index) => {
                root.activated(index);
            }
            close => {
                popup.close();
            }

            for entry[index] in root.entries: Rectangle {
                height: entry.separator ? Tokens.menu-separator-margin.top + 1px + Tokens.menu-separator-margin.bottom : Tokens.menu-item-height;

                if entry.separator: Rectangle {
                    x: Tokens.menu-separator-margin.left;
                    y: Tokens.menu-separator-margin.top;
                    width: parent.width - Tokens.menu-separator-margin.left - Tokens.menu-separator-margin.right;
                    height: 1px;
                    background: Tokens.fluent-base-medium-low-color;
                }

                if !entry.separator: row := Rectangle {
                    property <bool> enabled: !entry.disabled;
                    property <brush> ink: !self.enabled ? Tokens.fluent-base-medium-low-color : Tokens.text-brush;
                    accessible-role: list-item;
                    accessible-label: entry.title;
                    accessible-description: entry.gesture;
                    accessible-enabled: self.enabled;
                    accessible-item-selectable: true;
                    accessible-item-selected: menu.highlighted == index;
                    accessible-action-default => { menu.choose(index); }
                    // Fluent hovers on ListLow, which the retinted palette makes the menu's own ground, so the row under
                    // the pointer takes Wine-Stained Brown (Fluent's pressed ListMedium), as the rail's flyout does. The
                    // keyboard's row is framed while focus shows.
                    background: touch.has-hover ? Tokens.selected-brush : transparent;
                    border-width: 1px;
                    border-color: menu.highlighted == index && KeyboardFocus.visible ? Tokens.focus-brush : transparent;
                    border-radius: Tokens.control-radius;

                    HorizontalLayout {
                        padding-left: Tokens.menu-item-padding.left;
                        padding-right: Tokens.menu-item-padding.right;
                        padding-top: Tokens.menu-item-padding.top;
                        padding-bottom: Tokens.menu-item-padding.bottom;
                        spacing: 0px;

                        if root.has-icons: Rectangle {
                            width: root.icon-column;
                            Image {
                                x: 0;
                                width: Tokens.icon-size;
                                height: Tokens.icon-size;
                                image-fit: contain;
                                source: entry.icon;
                                colorize: row.ink;
                            }
                        }
                        Text {
                            text: entry.title;
                            font-size: Tokens.font-size-value;
                            color: row.ink;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: Tokens.menu-gesture-margin.left;
                            horizontal-stretch: 0;
                        }
                        Text {
                            text: entry.gesture;
                            font-size: Tokens.font-size-caption;
                            color: row.enabled ? Tokens.fluent-base-medium-color : Tokens.fluent-base-medium-low-color;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                            width: gestures.preferred-width;
                        }
                    }

                    touch := TouchArea {
                        enabled: row.enabled;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                KeyboardFocus.visible = false;
                            }
                        }
                        clicked => {
                            menu.choose(index);
                        }
                    }
                }
            }
        }
    }
}
