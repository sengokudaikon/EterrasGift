// The item templates flyout: the user's saved templates, each drafted onto the item or deleted (asked first, in the row), and
// the item saved as a new one (its affixes, or the whole item). A name that would replace a kept template says so, and
// Save becomes Replace. The name field takes the keyboard when it opens; Escape backs out of a delete question, then
// closes it, and the popup gives focus back to the Templates button.

import { Tokens } from "../../tokens.slint";
import { KeyboardFocus, Tip } from "../../globals.slint";
import { Button, ButtonKind } from "../../widgets/button.slint";
import { ChoiceBox } from "../../widgets/choice-box.slint";
import { TipBubble, TipTrigger } from "../../widgets/focus.slint";
import { FlyoutSurface } from "../../widgets/menu.slint";
import { ListView } from "../../widgets/scroll-view.slint";
import { TextField } from "../../widgets/text-field.slint";
import { FactsText } from "../../widgets/text.slint";
import { TemplateRowView } from "state.slint";
import { ForgeText } from "../../strings/forge.slint";

export global TemplateMetrics {
    // A list row: the name over its caption, with its buttons beside them.
    out property <length> row: Math.max(Tokens.control-min-height, Tokens.font-size-body * 4 / 3 + Tokens.space-1 + Tokens.font-size-caption * 4 / 3)
        + Tokens.space-6 * 2;
    out property <length> caption-line: Tokens.font-size-caption * 4 / 3;

    public pure function list-height(rows: int) -> length {
        return rows == 0 ? self.caption-line * 2 : Math.min(Tokens.replace-list-max-height, rows * self.row);
    }

    // The whole flyout for `rows` templates: the title, the list, the name, the kind and Save, then the message at its
    // measured height (none while there is nothing to say).
    public pure function height(rows: int, message: length) -> length {
        return Tokens.flyout-padding.top + Tokens.flyout-padding.bottom
            + Tokens.font-size-section * 4 / 3
            + self.list-height(rows)
            + Tokens.control-min-height
            + Tokens.control-min-height
            + Tokens.space-10 * 3
            + (message > 0 ? Tokens.space-10 + message : 0px);
    }
}

// Measures the message as the flyout wraps it; a popup's insides can't be read from outside, so this sits by its opener.
export component TemplatesMeasure inherits Rectangle {
    // The line under the form.
    in property <string> note;
    out property <length> message: root.note == "" ? 0px : text.preferred-height;

    width: 0;
    height: 0;
    visible: false;

    text := Text {
        x: 0;
        y: 0;
        width: Tokens.replace-flyout-width;
        text: root.note;
        font-size: Tokens.font-size-caption;
        wrap: word-wrap;
    }
}

export component TemplatesPanel inherits FlyoutSurface {
    // From the page: what this shows and what it asks of it.
    in property <bool> has-item;
    callback template-apply(int);
    callback template-delete(int);
    in property <string> template-name;
    callback template-name-edited(string);
    in property <string> template-replaces;
    // The line under the form.
    in property <string> note;
    in property <[TemplateRowView]> template-rows;
    callback template-save(string, bool);

    // After a template is applied: its drafts show on the page, behind the flyout.
    callback done();

    property <int> kind;
    // The row whose Delete was pressed: it asks before it deletes.
    property <int> deleting: -1;

    function save() {
        root.deleting = -1;
        if (root.template-name != "") {
            root.template-save(root.template-name, root.kind == 1);
        }
    }

    // Escape bubbles here from the fields and buttons (the kind list's own popup takes its Escape first).
    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.deleting >= 0) {
                    root.deleting = -1;
                } else {
                    root.done();
                }
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding-left: Tokens.flyout-padding.left;
            padding-right: Tokens.flyout-padding.right;
            padding-top: Tokens.flyout-padding.top;
            padding-bottom: Tokens.flyout-padding.bottom;
            spacing: Tokens.space-10;
            alignment: start;

            Text {
                text: ForgeText.templates;
                font-size: Tokens.font-size-section;
                font-weight: Tokens.emphasis-weight;
                color: Tokens.text-brush;
            }

            Rectangle {
                height: TemplateMetrics.list-height(root.template-rows.length);

                if root.template-rows.length == 0: Text {
                    width: parent.width;
                    text: ForgeText.no-templates;
                    font-size: Tokens.font-size-caption;
                    color: Tokens.text-muted-brush;
                    wrap: word-wrap;
                }

                if root.template-rows.length > 0: ListView {
                    for entry[index] in root.template-rows: HorizontalLayout {
                        property <bool> asking: root.deleting == index;

                        height: TemplateMetrics.row;
                        padding-top: Tokens.space-6;
                        padding-bottom: Tokens.space-6;
                        spacing: Tokens.space-8;

                        VerticalLayout {
                            spacing: Tokens.space-1;
                            alignment: center;
                            horizontal-stretch: 1;

                            // Cut to the row, the name says itself in full on hover; the buttons' tips name it for the keyboard.
                            Text {
                                text: entry.name;
                                color: Tokens.text-brush;
                                overflow: elide;

                                name-touch := TouchArea { }

                                TipTrigger {
                                    text: entry.label;
                                    hovered: name-touch.has-hover;
                                    in-flyout: true;
                                }
                            }

                            if asking: Text {
                                text: ForgeText.delete-template;
                                font-size: Tokens.font-size-caption;
                                color: Tokens.text-brush;
                                overflow: elide;
                            }

                            if !asking: FactsText {
                                facts: entry.facts;
                            }
                        }

                        // Asking, the same two buttons become Delete and Keep, so the key that asked lands on Keep.
                        Button {
                            in-flyout: true;
                            text: asking ? ForgeText.delete : ForgeText.draft-action;
                            kind: asking ? ButtonKind.primary : ButtonKind.standard;
                            enabled: asking || root.has-item;
                            tip: asking ? ForgeText.delete-for-good-tip(entry.name) : ForgeText.draft-onto-tip(entry.name);
                            clicked => {
                                if (asking) {
                                    root.deleting = -1;
                                    root.template-delete(index);
                                    name-field.focus();
                                } else {
                                    root.template-apply(index);
                                    root.done();
                                }
                            }
                        }

                        Button {
                            in-flyout: true;
                            text: asking ? ForgeText.keep : ForgeText.delete-ellipsis;
                            kind: asking ? ButtonKind.standard : ButtonKind.subtle;
                            tip: asking ? ForgeText.keep-named(entry.name) : ForgeText.delete-named(entry.name);
                            clicked => {
                                root.deleting = asking ? -1 : index;
                            }
                        }
                    }
                }
            }

            name-field := TextField {
                text: root.template-name;
                placeholder: ForgeText.template-name;
                label: ForgeText.template-name;
                init => {
                    self.focus();
                }
                edited(text) => {
                    root.deleting = -1;
                    root.template-name-edited(text);
                }
                // Enter saves a new name; one that would replace a kept template goes to Replace, which says so.
                accepted(text) => {
                    if (root.template-replaces != "") {
                        KeyboardFocus.visible = true;
                        save-button.focus();
                    } else {
                        root.save();
                    }
                }
            }

            HorizontalLayout {
                spacing: Tokens.space-8;

                ChoiceBox {
                    label: ForgeText.what-to-save;
                    choices: [ForgeText.affixes-only, ForgeText.whole-item];
                    index: root.kind;
                    horizontal-stretch: 1;
                    chosen(index) => {
                        root.kind = index;
                    }
                }

                save-button := Button {
                    in-flyout: true;
                    text: root.template-replaces != "" ? ForgeText.replace : ForgeText.save;
                    kind: ButtonKind.primary;
                    enabled: root.template-name != "" && root.has-item;
                    tip: root.template-replaces != ""
                        ? ForgeText.save-replacing-tip(root.template-replaces)
                        : ForgeText.save-new-tip;
                    clicked => {
                        root.save();
                    }
                }
            }

            if root.note != "": Text {
                text: root.note;
                font-size: Tokens.font-size-caption;
                color: root.template-replaces != "" ? Tokens.warning-brush : Tokens.text-secondary-brush;
                wrap: word-wrap;
            }
        }
    }

    // Tips raised in here, drawn over the flyout: the window's own bubble would lie under the popup.
    if Tip.open && Tip.in-flyout: TipBubble {
        window-width: root.width;
        window-height: root.height;
    }
}
