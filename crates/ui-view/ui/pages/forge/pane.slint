// The changes pane: what will change and what did, on Lifted Umber
// beside the table. A record only: Apply never depends on it.

import { ScrollView } from "../../widgets/scroll-view.slint";
import { Tokens } from "../../tokens.slint";
import { KeyboardFocus } from "../../globals.slint";
import { FocusRing, TipTrigger } from "../../widgets/focus.slint";
import { AppliedEntryView, DraftEntryView } from "state.slint";
import { ForgeText } from "../../strings/forge.slint";
import { CompactIconButton } from "../../widgets/compact-icon-button.slint";

export component ChangesPane inherits Rectangle {
    // From the page: what this shows and what it asks of it.
    callback discard-entry(int);
    in property <string> draft-count-text;
    in property <[DraftEntryView]> drafts;
    in property <[AppliedEntryView]> history;
    callback show-draft(int);

    // Lying over the table (a narrow window): it takes the pointer over its whole area, and Escape inside it closes it.
    in property <bool> overlay;
    callback dismissed();

    background: Tokens.raised-brush;

    // Nothing under the overlaid pane answers a press on its empty parts.
    if root.overlay: TouchArea { }

    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Tokens.hairline-brush;
    }

    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (root.overlay && event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            reject
        }

        scroll := ScrollView {
            x: 1px;
            width: parent.width - 1px;
            content-width: self.visible-width;
            content-height: content.preferred-height;

            content := VerticalLayout {
                width: scroll.visible-width;
                padding-left: Tokens.pane-content-margin.left;
                padding-right: Tokens.pane-content-margin.right;
                padding-top: Tokens.pane-content-margin.top;
                padding-bottom: Tokens.pane-content-margin.bottom;
                spacing: Tokens.space-18;
                alignment: start;

                VerticalLayout {
                    spacing: Tokens.space-6;

                    // Teal with the pencil only while there are drafts; "No drafts" is a muted note.
                    HorizontalLayout {
                        spacing: Tokens.space-8;
                        alignment: start;

                        if root.drafts.length > 0: Image {
                            width: Tokens.icon-size;
                            height: Tokens.icon-size;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                            source: Tokens.icon-draft;
                            colorize: Tokens.draft-brush;
                        }

                        Text {
                            text: root.draft-count-text;
                            font-size: Tokens.font-size-subheading;
                            font-weight: Tokens.emphasis-weight;
                            color: root.drafts.length > 0 ? Tokens.draft-brush : Tokens.text-muted-brush;
                        }
                    }

                    // Each entry is a button, a Tab stop that Enter or Space shows. The entries sit flush: the 6px spacing
                    // parts the header from the list only.
                    VerticalLayout {
                        spacing: Tokens.space-0;

                        for entry[index] in root.drafts: Rectangle {
                            height: entry-layout.preferred-height;
                            border-radius: Tokens.control-radius;
                            background: entry-touch.has-hover || name-touch.has-hover ? Tokens.draft-hover-brush : transparent;
                            accessible-role: button;
                            accessible-label: ForgeText.show-draft-for(entry.name);
                            accessible-action-default => { root.show-draft(index); }

                            entry-focus := FocusScope {
                                focus-gained(reason) => {
                                    if (reason == FocusReason.tab-navigation) {
                                        KeyboardFocus.visible = true;
                                    }
                                }
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == " ") {
                                        root.show-draft(index);
                                        return accept;
                                    }
                                    reject
                                }

                                entry-touch := TouchArea {
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            KeyboardFocus.visible = false;
                                        }
                                    }
                                    clicked => {
                                        root.show-draft(index);
                                    }
                                }
                            }

                            entry-layout := HorizontalLayout {
                                padding-left: Tokens.ledger-entry-padding.left;
                                padding-right: Tokens.ledger-entry-padding.right;
                                padding-top: Tokens.ledger-entry-padding.top;
                                padding-bottom: Tokens.ledger-entry-padding.bottom;
                                spacing: Tokens.space-8;

                                VerticalLayout {
                                    spacing: Tokens.space-2;
                                    horizontal-stretch: 1;

                                    // The name, cut to the pane, says itself in full on hover.
                                    Text {
                                        text: entry.name;
                                        font-weight: Tokens.emphasis-weight;
                                        color: Tokens.text-brush;
                                        overflow: elide;

                                        name-touch := TouchArea {
                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.down) {
                                                    KeyboardFocus.visible = false;
                                                }
                                            }
                                            clicked => {
                                                root.show-draft(index);
                                            }
                                        }
                                    }

                                    Text {
                                        text: entry.summary;
                                        color: Tokens.draft-brush;
                                        wrap: word-wrap;
                                    }

                                    if entry.effect != "": Text {
                                        text: entry.effect;
                                        font-size: Tokens.font-size-caption;
                                        color: Tokens.text-secondary-brush;
                                        wrap: word-wrap;
                                    }

                                    if entry.stale: HorizontalLayout {
                                        spacing: Tokens.space-6;
                                        alignment: start;

                                        Image {
                                            width: Tokens.icon-size-small;
                                            height: Tokens.icon-size-small;
                                            y: (parent.height - self.height) / 2;
                                            image-fit: contain;
                                            source: Tokens.icon-warning;
                                            colorize: Tokens.warning-brush;
                                        }

                                        Text {
                                            text: ForgeText.changed-in-game;
                                            font-size: Tokens.font-size-caption;
                                            color: Tokens.warning-brush;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: start;

                                    CompactIconButton {
                                        icon: Tokens.icon-close;
                                        tip: ForgeText.discard-draft-for(entry.name);
                                        clicked => {
                                            root.discard-entry(index);
                                        }
                                    }
                                }
                            }

                            TipTrigger {
                                text: name-touch.has-hover ? entry.name : ForgeText.show-this-draft;
                                hovered: entry-touch.has-hover || name-touch.has-hover;
                                focused: entry-focus.has-focus;
                            }

                            FocusRing {
                                focused: entry-focus.has-focus;
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: Tokens.space-6;

                    Text {
                        text: ForgeText.applied;
                        color: Tokens.text-muted-brush;
                    }

                    if root.history.length == 0: Text {
                        text: ForgeText.nothing-applied;
                        font-size: Tokens.font-size-caption;
                        color: Tokens.text-muted-brush;
                        wrap: word-wrap;
                    }

                    // Flush; each entry keeps its own catalog-entry margin.
                    VerticalLayout {
                        spacing: Tokens.space-0;

                        for entry in root.history: HorizontalLayout {
                            padding-top: Tokens.catalog-entry-margin.top;
                            padding-bottom: Tokens.catalog-entry-margin.bottom;
                            spacing: Tokens.space-8;

                            VerticalLayout {
                                padding-top: Tokens.icon-baseline-nudge.top + Tokens.space-2;
                                alignment: start;

                                Image {
                                    width: Tokens.icon-size-small;
                                    height: Tokens.icon-size-small;
                                    image-fit: contain;
                                    source: Tokens.icon-confirmed;
                                    colorize: Tokens.confirmed-brush;
                                }
                            }

                            VerticalLayout {
                                spacing: Tokens.space-2;
                                horizontal-stretch: 1;

                                // A name too long for the pane wraps, the time kept whole beside its first line, so
                                // nothing is cut that the keyboard cannot reach; the tip stays for the pointer.
                                Rectangle {
                                    height: name-line.preferred-height;

                                    name-line := HorizontalLayout {
                                        spacing: Tokens.space-12;
                                        alignment: start;

                                        Text {
                                            text: entry.name;
                                            font-weight: Tokens.emphasis-weight;
                                            color: Tokens.text-brush;
                                            wrap: word-wrap;
                                            max-width: self.preferred-width;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: entry.time;
                                            font-size: Tokens.font-size-caption;
                                            color: Tokens.text-muted-brush;
                                            min-width: self.preferred-width;
                                            horizontal-stretch: 0;
                                            vertical-alignment: top;
                                        }
                                    }

                                    name-time-touch := TouchArea { }

                                    TipTrigger {
                                        text: entry.name + "\n" + entry.time;
                                        hovered: name-time-touch.has-hover;
                                    }
                                }

                                Text {
                                    text: entry.summary;
                                    font-size: Tokens.font-size-caption;
                                    color: Tokens.text-secondary-brush;
                                    wrap: word-wrap;
                                }

                                if entry.effect != "": Text {
                                    text: entry.effect;
                                    font-size: Tokens.font-size-caption;
                                    color: Tokens.text-secondary-brush;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: entry.outcome;
                                    font-size: Tokens.font-size-caption;
                                    color: Tokens.confirmed-brush;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
