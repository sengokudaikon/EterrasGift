// The Mods page: [list | the selected mod's pane] over the action bar, as on Item Forge. Rust (`crates/ui/src/pages/mods.rs`)
// puts the mod library behind it; disk work belongs to its ordered worker. `ModsView` draws what its properties say and
// reports the controls; `ModsPage` is the only part that knows the `ModsState` global. The parts are in pages/mods/.

import { ModsState } from "mods/state.slint";
import { ModsView } from "mods/view.slint";

export component ModsPage inherits Rectangle {
    in property <bool> compact;
    in property <bool> wide;

    ModsView {
        width: root.width;
        height: root.height;
        compact: root.compact;
        wide: root.wide;
        mods: ModsState.mods;
        sources: ModsState.sources;
        settings: ModsState.settings;
        log-lines: ModsState.log-lines;
        selected-index: ModsState.selected-index;
        installed-count: ModsState.installed-count;
        enabled-count: ModsState.enabled-count;
        is-read: ModsState.is-read;
        can-open-folder: ModsState.can-open-folder;
        can-open-log: ModsState.can-open-log;
        open-folder-tip: ModsState.open-folder-tip;
        open-log-tip: ModsState.open-log-tip;
        readiness: ModsState.readiness;
        readiness-facts: ModsState.readiness-facts;
        readiness-tone: ModsState.readiness-tone;
        can-play: ModsState.can-play;
        busy: ModsState.busy;
        selected: ModsState.selected;
        building: ModsState.building;
        change-message: ModsState.change-message;
        change-is-draft: ModsState.change-is-draft;
        change-tone: ModsState.change-tone;
        can-undo: ModsState.can-undo;
        draft-count: ModsState.draft-count;
        select-mod(index0) => { ModsState.select-mod(index0); }
        toggle-mod(index0) => { ModsState.toggle-mod(index0); }
        remove-mod(index0) => { ModsState.remove-mod(index0); }
        reveal-mod(index0) => { ModsState.reveal-mod(index0); }
        rebuild(index0) => { ModsState.rebuild(index0); }
        install-build(index0) => { ModsState.install-build(index0); }
        build-source(index0) => { ModsState.build-source(index0); }
        setting-edited(index0, text1) => { ModsState.setting-edited(index0, text1); }
        setting-toggled(index0, on1) => { ModsState.setting-toggled(index0, on1); }
        setting-choice(index0, text1) => { ModsState.setting-choice(index0, text1); }
        commit-settings => { ModsState.commit-settings(); }
        undo-remove => { ModsState.undo-remove(); }
        revert-drafts => { ModsState.revert-drafts(); }
        refresh => { ModsState.refresh(); }
        add-mod => { ModsState.add-mod(); }
        open-folder => { ModsState.open-folder(); }
        open-log => { ModsState.open-log(); }
        play => { ModsState.play(); }
    }
}
