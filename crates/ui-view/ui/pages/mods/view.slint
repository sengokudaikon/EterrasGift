// The Mods page as its properties say: the list, the selected mod's pane and the action bar.

import { ScrollView } from "../../widgets/scroll-view.slint";
import { Tokens } from "../../tokens.slint";
import { KeyboardFocus } from "../../globals.slint";
import { ModsText } from "../../strings/mods.slint";
import { TitleText, SectionText, SecondaryText, BodyText, LabelText, CaptionText, CaptionTone, FactsText } from "../../widgets/text.slint";
import { Button, ButtonKind } from "../../widgets/button.slint";
import { FocusRing, TipTrigger } from "../../widgets/focus.slint";
import { PopupMenu } from "../../widgets/menu.slint";
import { MessageTone } from "../common.slint";
import { AshField } from "../../decorations.slint";
import { ModCheck, RowSpot } from "rows.slint";
import { ModPane } from "pane.slint";
import { ModRow, SourceRow, ModSettingRow, ModLogRow, SelectedModView } from "state.slint";

// One line of the action bar's status: the icon says what kind of line it is, and the text wraps beside it.
export component StatusLine inherits Rectangle {
    in property <string> message;
    // Short facts side by side on the first line, each its own text; the message, if any, goes under them.
    in property <[string]> facts;
    in property <image> icon;
    in property <brush> icon-ink;
    in property <brush> ink;
    property <length> gap: root.facts.length > 0 && root.message != "" ? Tokens.space-2 : 0px;
    // Tall enough for the icon as well, so a one-line message never clips its foot.
    height: Math.max(facts-row.height + root.gap + message-text.height, Tokens.icon-baseline-nudge.top + Tokens.icon-size-small);
    Image {
        x: 0; y: Tokens.icon-baseline-nudge.top; width: Tokens.icon-size-small; height: Tokens.icon-size-small;
        image-fit: contain; source: root.icon; colorize: root.icon-ink;
    }
    facts-row := FactsText {
        x: Tokens.icon-size-small + Tokens.space-6; y: 0; width: parent.width - self.x;
        height: root.facts.length > 0 ? self.preferred-height : 0px;
        facts: root.facts; color: root.ink;
    }
    message-text := CaptionText {
        x: Tokens.icon-size-small + Tokens.space-6; y: facts-row.height + root.gap; width: parent.width - self.x;
        height: root.message != "" || root.facts.length == 0 ? self.preferred-height : 0px;
        text: root.message; color: root.ink;
        accessible-role: text;
        // Announced as it changes.
        accessible-live-region: polite;
    }
}

export component ModsView inherits Rectangle {
    in property <bool> compact;
    in property <bool> wide;
    in property <[ModRow]> mods;
    in property <[SourceRow]> sources;
    in property <[ModSettingRow]> settings;
    in property <[ModLogRow]> log-lines;
    in property <int> selected-index: -1;
    in property <int> installed-count;
    in property <int> enabled-count;
    in property <bool> is-read;
    in property <bool> can-open-folder: true;
    in property <bool> can-open-log;
    in property <string> open-folder-tip;
    in property <string> open-log-tip;
    in property <string> readiness;
    in property <[string]> readiness-facts;
    in property <MessageTone> readiness-tone: MessageTone.info;
    in property <bool> can-play;
    in property <bool> busy;
    in property <SelectedModView> selected;
    in property <bool> building;
    in property <string> change-message;
    in property <bool> change-is-draft;
    in property <MessageTone> change-tone: MessageTone.info;
    in property <bool> can-undo;
    in property <int> draft-count;
    callback select-mod(int);
    callback toggle-mod(int);
    callback remove-mod(int);
    callback reveal-mod(int);
    callback rebuild(int);
    callback install-build(int);
    callback build-source(int);
    callback setting-edited(int, string);
    callback setting-toggled(int, bool);
    callback setting-choice(int, string);
    callback commit-settings();
    callback undo-remove();
    callback revert-drafts();
    callback refresh();
    callback add-mod();
    callback open-folder();
    callback open-log();
    callback play();
    property <length> gutter: root.compact ? Tokens.preview-page-compact-margin.left : Tokens.preview-page-margin.left;
    property <length> pane-width: root.wide ? Tokens.changes-pane-wide-width : root.compact ? Tokens.changes-pane-compact-width : Tokens.changes-pane-width;
    // The content column fills up to its cap and stays left.
    property <length> content-width: Math.max(0px, Math.min(Tokens.mods-content-max-width, pane.x) - 2 * root.gutter);
    property <length> row-step: Tokens.row-min-height + Tokens.row-gap.bottom;
    // Column heads share the rows' columns: [name] [version, maximized only] [state].
    property <length> version-width: root.wide ? version-probe.preferred-width : 0px;
    property <length> state-width: state-probe.preferred-width;
    property <int> active-index: root.selected-index;
    property <int> visible-count: root.mods.length;
    property <bool> had-rows;
    // Ctrl+Z gives the list focus back, on the restored row, once it is there again.
    property <bool> focus-list-on-rows;
    init => { root.had-rows = root.mods.length > 0; }
    changed visible-count => {
        // Removing the final row leaves the list no tab stop. Keep page shortcuts, particularly Undo, alive.
        if (root.visible-count == 0 && root.had-rows) { page-keys.focus(); }
        if (root.visible-count > 0 && root.focus-list-on-rows) {
            root.focus-list-on-rows = false;
            list-focus.focus();
        }
        root.had-rows = root.visible-count > 0;
    }
    // Rows wholly in view, for PageUp and PageDown: they go to the first or last of them, then a page further, as a
    // Windows list does.
    property <int> first-shown: Math.min(root.mods.length - 1, Math.ceil(-library-scroll.content-y / root.row-step));
    property <int> last-shown: Math.max(root.first-shown, Math.min(root.mods.length - 1, Math.floor((-library-scroll.content-y + library-scroll.visible-height + Tokens.row-gap.bottom) / root.row-step) - 1));
    property <int> page-rows: Math.max(1, root.last-shown - root.first-shown);
    function page-down() -> int {
        return root.selected-index < root.last-shown ? root.last-shown : Math.min(root.mods.length - 1, root.selected-index + root.page-rows);
    }
    function page-up() -> int {
        return root.selected-index > root.first-shown ? root.first-shown : Math.max(0, root.selected-index - root.page-rows);
    }
    // The keyboard opens the row menu under the selected row, at its left edge.
    function menu-under-row() {
        row-menu.open-at(
            list-focus.absolute-position.x - root.absolute-position.x,
            list-focus.absolute-position.y - root.absolute-position.y + Math.max(0, root.selected-index) * root.row-step + Tokens.row-min-height,
            true);
    }
    changed active-index => {
        if (root.active-index >= 0) {
            let top = root.active-index * root.row-step;
            if (top < -library-scroll.content-y) { library-scroll.content-y = -top; }
            else if (top + Tokens.row-min-height > -library-scroll.content-y + library-scroll.visible-height) {
                library-scroll.content-y = Math.min(0px, library-scroll.visible-height - top - Tokens.row-min-height);
            }
        }
    }

    version-probe := VerticalLayout {
        visible: false;
        LabelText { text: ModsText.version; wrap: no-wrap; }
        for item in root.mods: CaptionText { text: item.version; wrap: no-wrap; }
    }
    state-probe := VerticalLayout {
        visible: false;
        for item in root.mods: HorizontalLayout {
            spacing: Tokens.space-12;
            if item.problem != "": HorizontalLayout {
                spacing: Tokens.space-6;
                Rectangle { width: Tokens.icon-size-small; }
                CaptionText { text: item.problem-label; wrap: no-wrap; }
            }
            if item.drafted: Rectangle { width: Tokens.icon-size-small; }
        }
    }

    // With no mods and none to build the content column has a still dusting of ash: nothing here, and nothing waited on.
    // Placed at the page's corner: an element given a size and no position is centred in its parent, which would shift
    // every mote by (pane gap / 2, bar / 2).
    if root.is-read && root.installed-count == 0 && root.sources.length == 0: AshField { x: 0; y: 0; width: pane.x; height: bar.y; still: true; }
    page-keys := FocusScope {
        key-pressed(event) => {
            // Ctrl+Z puts back a mod just removed, as the action bar's Undo does; a text box keeps Ctrl+Z for its own text.
            if (event.modifiers.control && (event.text == "z" || event.text == "Z") && root.can-undo) {
                root.undo-remove();
                // Focus follows the restored row, as from the keyboard.
                KeyboardFocus.visible = true;
                if (root.mods.length > 0) { list-focus.focus(); } else { root.focus-list-on-rows = true; }
                return accept;
            }
            reject
        }
        // Nothing above the list appears or disappears, so the list's top edge never moves under the pointer.
        header := VerticalLayout {
            x: root.gutter; y: Tokens.preview-page-margin.top;
            width: root.content-width; height: self.preferred-height;
            VerticalLayout {
                spacing: Tokens.space-8;
                padding-bottom: Tokens.preview-header-margin.bottom;
                // The title's line height; "Mods" never wraps.
                TitleText { text: ModsText.title; height: Tokens.line-height-title; vertical-alignment: center; }
                SecondaryText { text: ModsText.intro; }
            }
            // The list's tools: the folder it comes from and the log of the last game. Below the standard class their labels hide
            // and they keep a standard button's padding. Adding is always open: it queues on the
            // library's ordered worker behind the first read.
            HorizontalLayout {
                spacing: Tokens.space-8; alignment: start;
                padding-bottom: Tokens.preview-header-margin.bottom;
                Button {
                    text: ModsText.add-mod; label-hidden: root.compact; accessible-name: ModsText.add-mod; icon: Tokens.icon-add;
                    tip: ModsText.add-mod-tip;
                    clicked => { root.add-mod(); }
                }
                Button {
                    text: ModsText.open-folder; label-hidden: root.compact; accessible-name: ModsText.open-mods-folder; icon: Tokens.icon-folder;
                    enabled: root.can-open-folder; tip: root.open-folder-tip;
                    clicked => { root.open-folder(); }
                }
                Button {
                    text: ModsText.open-log; label-hidden: root.compact; accessible-name: ModsText.open-log; icon: Tokens.icon-log;
                    enabled: root.can-open-log; tip: root.open-log-tip;
                    clicked => { root.open-log(); }
                }
            }
        }
        installed-header := HorizontalLayout {
            x: root.gutter + Tokens.table-header-inset.left;
            y: header.y + header.height;
            width: root.content-width - Tokens.table-header-inset.left - Tokens.table-header-inset.right;
            height: self.preferred-height;
            spacing: Tokens.space-12;
            HorizontalLayout {
                spacing: Tokens.space-8;
                horizontal-stretch: 1;
                LabelText { text: ModsText.installed; horizontal-stretch: 0; vertical-alignment: center; }
                CaptionText { text: root.installed-count > 0 ? ModsText.enabled-of(root.enabled-count, root.installed-count) : ""; horizontal-stretch: 1; vertical-alignment: center; }
            }
            // The Version column keeps its gap while it is empty, so the name stops 12px earlier.
            LabelText { text: root.wide ? ModsText.version : ""; width: root.version-width; wrap: no-wrap; }
            Rectangle { width: root.state-width; }
        }
        // The installed list over the mod projects not installed yet: sized to its rows, it scrolls in what the projects leave it.
        library-scroll := ScrollView {
            x: root.gutter;
            y: installed-header.y + installed-header.height + Tokens.mod-list-margin.top;
            width: root.content-width;
            height: root.mods.length == 0 ? 0px : Math.max(0px, Math.min(root.mods.length * root.row-step, bar.y - self.y - not-installed.height));
            content-width: self.visible-width;
            content-height: root.mods.length * root.row-step;
            // One tab stop: arrows move, Space turns the selected mod on or off, Del removes it, the menu key or Shift+F10 opens its menu.
            // Always there, so Ctrl+Z can bring focus back to it; a tab stop only while it has rows.
            list-focus := FocusScope {
                enabled: root.mods.length > 0;
                height: root.mods.length * root.row-step;
                accessible-role: list;
                accessible-label: ModsText.installed-mods;
                focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { KeyboardFocus.visible = true; } if (root.selected-index < 0) { root.select-mod(0); } }
                key-pressed(event) => {
                    // The keyboard opens the menu under the row; a right-click opens it at the pointer.
                    if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                        root.menu-under-row();
                        return accept;
                    }
                    if (event.modifiers.control || event.modifiers.alt) { return reject; }
                    // Keys on the list show where focus is.
                    if (event.text == Key.DownArrow) { KeyboardFocus.visible = true; root.select-mod(Math.min(root.mods.length - 1, root.selected-index + 1)); return accept; }
                    if (event.text == Key.UpArrow) { KeyboardFocus.visible = true; root.select-mod(Math.max(0, root.selected-index - 1)); return accept; }
                    if (event.text == Key.Home) { KeyboardFocus.visible = true; root.select-mod(0); return accept; }
                    if (event.text == Key.End) { KeyboardFocus.visible = true; root.select-mod(root.mods.length - 1); return accept; }
                    if (event.text == Key.PageDown) { KeyboardFocus.visible = true; root.select-mod(root.page-down()); return accept; }
                    if (event.text == Key.PageUp) { KeyboardFocus.visible = true; root.select-mod(root.page-up()); return accept; }
                    if (event.text == " " && !root.busy) { KeyboardFocus.visible = true; root.toggle-mod(root.selected-index); return accept; }
                    if (event.text == Key.Delete && !root.busy) { KeyboardFocus.visible = true; root.remove-mod(root.selected-index); return accept; }
                    reject
                }
                VerticalLayout {
                    spacing: Tokens.row-gap.bottom;
                    alignment: start;
                    for item[index] in root.mods: mod-row := Rectangle {
                        // Hovered parts with tooltips of their own count as the row being hovered.
                        property <int> spots;
                        property <bool> selected: root.selected-index == index;
                        property <bool> hovered: row-touch.has-hover || self.spots > 0;
                        function pick() { root.select-mod(index); list-focus.focus(); }
                        // A right-click opens the row's menu at the pointer.
                        function menu-at(x: length, y: length) { row-menu.open-at(x - root.absolute-position.x, y - root.absolute-position.y, false); }
                        height: Tokens.row-min-height;
                        border-radius: Tokens.control-radius;
                        border-width: 1px;
                        border-color: self.selected ? Tokens.accent-brush : transparent;
                        background: self.selected ? Tokens.selected-brush : self.hovered ? Tokens.hover-brush : transparent;
                        accessible-role: list-item;
                        accessible-label: item.name;
                        accessible-description: item.author == "" ? item.version : item.version + ", " + item.author;
                        accessible-checkable: true;
                        accessible-checked: item.enabled;
                        accessible-item-selectable: true;
                        accessible-item-selected: self.selected;
                        accessible-action-default => { root.select-mod(index); }
                        row-touch := RowSpot {
                            pressed-down => { mod-row.pick(); }
                            menu-requested(x, y) => { mod-row.menu-at(x, y); }
                        }
                        HorizontalLayout {
                            // Inside the row's 1px frame, as ListBoxItem's padding is.
                            padding-left: 1px + Tokens.row-padding.left; padding-right: 1px + Tokens.row-padding.right; spacing: Tokens.space-12;
                            Rectangle {
                                width: Tokens.icon-size-nav;
                                ModCheck {
                                    y: (parent.height - self.height) / 2;
                                    checked: item.enabled;
                                    hovered: check-spot.has-hover;
                                    check-spot := RowSpot {
                                        tip: ModsText.toggle-tip;
                                        changed has-hover => { mod-row.spots += self.has-hover ? 1 : -1; }
                                        pressed-down => { mod-row.pick(); }
                                        menu-requested(x, y) => { mod-row.menu-at(x, y); }
                                        clicked => { if (!root.busy) { root.toggle-mod(index); } }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1; spacing: Tokens.space-1;
                                Text {
                                    text: item.name; font-size: Tokens.font-size-value; color: item.enabled ? Tokens.text-brush : Tokens.text-muted-brush; overflow: elide;
                                    RowSpot {
                                        tip: item.name;
                                        changed has-hover => { mod-row.spots += self.has-hover ? 1 : -1; }
                                        pressed-down => { mod-row.pick(); }
                                        menu-requested(x, y) => { mod-row.menu-at(x, y); }
                                    }
                                }
                                // The version and the author, each its own text; maximized, the version moves to its column.
                                HorizontalLayout {
                                    spacing: Tokens.space-8;
                                    if !root.wide: CaptionText {
                                        text: item.version; wrap: no-wrap; horizontal-stretch: 0;
                                        RowSpot {
                                            changed has-hover => { mod-row.spots += self.has-hover ? 1 : -1; }
                                            pressed-down => { mod-row.pick(); }
                                            menu-requested(x, y) => { mod-row.menu-at(x, y); }
                                        }
                                    }
                                    CaptionText {
                                        text: item.author; wrap: no-wrap; overflow: elide; horizontal-stretch: 1;
                                        RowSpot {
                                            tip: item.author;
                                            changed has-hover => { mod-row.spots += self.has-hover ? 1 : -1; }
                                            pressed-down => { mod-row.pick(); }
                                            menu-requested(x, y) => { mod-row.menu-at(x, y); }
                                        }
                                    }
                                }
                            }
                            // Kept while empty, with its gap, so the heads line up.
                            CaptionText { text: root.wide ? item.version : ""; tone: CaptionTone.secondary; width: root.version-width; wrap: no-wrap; vertical-alignment: center; }
                            // Only what needs attention shows in the row: a load problem, and the draft pencil while it differs from the last game.
                            HorizontalLayout {
                                width: root.state-width;
                                spacing: Tokens.space-12;
                                alignment: end;
                                if item.problem != "": HorizontalLayout {
                                    spacing: Tokens.space-6;
                                    Image { width: Tokens.icon-size-small; height: Tokens.icon-size-small; y: (parent.height - self.height) / 2; image-fit: contain; source: Tokens.icon-error; colorize: Tokens.error-brush; }
                                    CaptionText { text: item.problem-label; tone: CaptionTone.error; wrap: no-wrap; vertical-alignment: center; }
                                }
                                if item.drafted: Rectangle {
                                    width: Tokens.icon-size-small;
                                    accessible-role: image;
                                    accessible-label: ModsText.changed-since;
                                    Image { width: Tokens.icon-size-small; height: Tokens.icon-size-small; y: (parent.height - self.height) / 2; image-fit: contain; source: Tokens.icon-draft; colorize: Tokens.draft-brush; }
                                    RowSpot {
                                        tip: ModsText.changed-since;
                                        changed has-hover => { mod-row.spots += self.has-hover ? 1 : -1; }
                                        pressed-down => { mod-row.pick(); }
                                        menu-requested(x, y) => { mod-row.menu-at(x, y); }
                                    }
                                }
                            }
                        }
                        // Fluent's focus visual on a list item sits inside it, over its frame: 2px of the focus colour on a 1px
                        // line of the ground (so the scroller can't clip it off the first row).
                        if list-focus.has-focus && mod-row.selected && KeyboardFocus.visible: Rectangle {
                            border-radius: Tokens.control-radius;
                            border-width: 2px;
                            border-color: Tokens.focus-brush;
                            Rectangle {
                                x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
                                border-width: 1px;
                                border-color: Tokens.ground-brush;
                            }
                        }
                    }
                }
            }
        }
        // No mods yet: the two ways one arrives, the first one a button. Its texts sit outside `if`, so its height is right.
        no-mods := VerticalLayout {
            visible: root.is-read && root.mods.length == 0;
            x: root.gutter + Tokens.mods-empty-margin.left;
            y: installed-header.y + installed-header.height + Tokens.mods-empty-margin.top;
            width: root.content-width - Tokens.mods-empty-margin.left - Tokens.mods-empty-margin.right;
            height: self.visible ? self.preferred-height : 0px;
            spacing: Tokens.space-4;
            Text { text: ModsText.no-mods; font-size: Tokens.font-size-value; color: Tokens.text-brush; }
            CaptionText { text: ModsText.no-mods-hint; }
            if root.is-read && root.mods.length == 0: HorizontalLayout {
                alignment: start;
                padding-top: Tokens.empty-action-margin.top;
                Button { text: ModsText.add-mod; tip: ModsText.add-mod-tip; clicked => { root.add-mod(); } }
            }
        }
        // Mod projects in the sources folder that no installed mod builds: not loaded (the box is off and can't be ticked) until built and installed.
        not-installed := VerticalLayout {
            x: root.gutter;
            y: root.mods.length > 0 ? library-scroll.y + library-scroll.height : no-mods.y + no-mods.height;
            width: root.content-width;
            height: root.sources.length == 0 ? 0px : self.preferred-height;
            visible: root.sources.length > 0;
            accessible-role: list;
            accessible-label: ModsText.from-sources-list;
            if root.sources.length > 0: VerticalLayout {
                padding-top: Tokens.mod-sources-margin.top;
                HorizontalLayout {
                    padding-left: Tokens.table-header-inset.left;
                    padding-right: Tokens.table-header-inset.right;
                    spacing: Tokens.space-8;
                    LabelText { text: ModsText.not-installed; horizontal-stretch: 0; vertical-alignment: center; }
                    CaptionText { text: ModsText.from-sources(root.sources.length); vertical-alignment: center; horizontal-stretch: 1; }
                }
                // Each row keeps its row gap below it, the last one too.
                VerticalLayout {
                    padding-top: Tokens.mod-list-margin.top;
                    padding-bottom: Tokens.row-gap.bottom;
                    spacing: Tokens.row-gap.bottom;
                    for source[index] in root.sources: HorizontalLayout {
                        min-height: Tokens.row-min-height;
                        padding-left: Tokens.mod-source-row-padding.left; padding-right: Tokens.mod-source-row-padding.right;
                        spacing: Tokens.space-12;
                        Rectangle {
                            width: Tokens.icon-size-nav;
                            ModCheck {
                                y: (parent.height - self.height) / 2;
                                checked: false; enabled: false;
                                accessible-role: checkbox;
                                accessible-label: ModsText.load(source.name);
                                accessible-enabled: false;
                                check-tip := TouchArea { }
                                TipTrigger { text: ModsText.build-to-turn-on; hovered: check-tip.has-hover; }
                            }
                        }
                        // The name and caption can be elided, with hover tips in full; as one tab stop they say both to the
                        // keyboard too (the selected mod's identity block does the same).
                        source-text := Rectangle {
                            horizontal-stretch: 1;
                            source-focus := FocusScope {
                                accessible-role: text;
                                accessible-label: source.name + "\n" + source.project;
                                focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { KeyboardFocus.visible = true; } }
                                TouchArea {
                                    pointer-event(event) => { if (event.kind == PointerEventKind.down) { KeyboardFocus.visible = false; } }
                                }
                            }
                            VerticalLayout {
                                alignment: center; spacing: Tokens.space-1;
                                Text {
                                    text: source.name; font-size: Tokens.font-size-value; color: Tokens.text-muted-brush; overflow: elide;
                                    source-name-tip := TouchArea { }
                                    TipTrigger { text: source.name; hovered: source-name-tip.has-hover; }
                                }
                                // The project's version and its folder, each its own text.
                                HorizontalLayout {
                                    spacing: Tokens.space-8;
                                    if source.version != "": CaptionText { text: source.version; wrap: no-wrap; horizontal-stretch: 0; }
                                    CaptionText {
                                        text: source.folder; wrap: no-wrap; overflow: elide; horizontal-stretch: 1;
                                        caption-tip := TouchArea { }
                                        TipTrigger { text: source.project; hovered: caption-tip.has-hover; }
                                    }
                                }
                            }
                            TipTrigger { text: source.name + "\n" + source.project; focused: source-focus.has-focus; }
                            FocusRing { focused: source-focus.has-focus; }
                        }
                        Button {
                            text: source.busy ? ModsText.building : ModsText.build-and-install;
                            height: Tokens.control-min-height; y: (parent.height - self.height) / 2; horizontal-stretch: 0;
                            enabled: !root.busy && !root.building;
                            tip: ModsText.build-and-install-tip;
                            clicked => { root.build-source(index); }
                        }
                    }
                }
            }
        }
        // The selected mod: what it is, whether it loaded, what can be done to it, and its settings.
        // Explicit sibling bounds keep breakpoint widths outside the parent layout solver.
        pane := ModPane {
            x: root.width - root.pane-width; y: 0; width: root.pane-width; height: bar.y;
            selected: root.selected;
            selected-index: root.selected-index;
            installed-count: root.installed-count;
            settings: root.settings;
            log-lines: root.log-lines;
            busy: root.busy;
            building: root.building;
            wide: root.wide;
            toggle-mod(index) => { root.toggle-mod(index); }
            reveal-mod(index) => { root.reveal-mod(index); }
            remove-mod(index) => { root.remove-mod(index); }
            install-build(index) => { root.install-build(index); }
            rebuild(index) => { root.rebuild(index); }
            setting-edited(index, value) => { root.setting-edited(index, value); }
            setting-toggled(index, value) => { root.setting-toggled(index, value); }
            setting-choice(index, value) => { root.setting-choice(index, value); }
            commit-settings => { root.commit-settings(); }
        }
        // Action bar: whether the next game with mods can go well and the latest change on the left; Undo, Revert and Play on the right.
        bar := Rectangle {
            x: 0; y: root.height - self.height; width: root.width;
            // The hairline is the bar's top border and adds its pixel to the height; the content is centred under it.
            property <length> border: Tokens.border-top.top;
            height: self.border + Math.max(Tokens.action-bar-status-min-height, statuses.height) + Tokens.action-bar-padding.top + Tokens.action-bar-padding.bottom;
            background: Tokens.surface-brush;
            Rectangle { x: 0; y: 0; height: parent.border; background: Tokens.hairline-brush; }
            // The status keeps its height as lines come and go, and centres whatever it holds on the buttons.
            // Width-aware text heights avoid preferred-height undercounting conditional wrapped captions.
            statuses := Rectangle {
                x: Tokens.action-bar-padding.left;
                y: parent.border + (parent.height - parent.border - self.height) / 2;
                width: Math.min(Tokens.status-message-max-width, actions.x - self.x - Tokens.space-20);
                height: readiness-line.height + (root.change-message == "" ? 0px : Tokens.space-4 + change-line.height);
                property <bool> warning: root.readiness-tone == MessageTone.warning;
                // What will run is a note, not a confirmation: the check is for what the game has read back.
                readiness-line := StatusLine {
                    x: 0; y: 0; width: parent.width;
                    message: root.readiness; facts: root.readiness-facts;
                    icon: parent.warning ? Tokens.icon-warning : Tokens.icon-info;
                    icon-ink: parent.warning ? Tokens.warning-brush : Tokens.text-muted-brush;
                    ink: parent.warning ? Tokens.warning-brush : Tokens.text-secondary-brush;
                }
                change-line := StatusLine {
                    x: 0; y: readiness-line.height + Tokens.space-4; width: parent.width;
                    visible: root.change-message != "";
                    message: root.change-message;
                    icon: root.change-tone == MessageTone.error ? Tokens.icon-error : root.change-is-draft ? Tokens.icon-draft : Tokens.icon-info;
                    icon-ink: root.change-tone == MessageTone.error ? Tokens.error-brush : root.change-is-draft ? Tokens.draft-brush : Tokens.text-muted-brush;
                    ink: root.change-tone == MessageTone.error ? Tokens.error-brush : root.change-is-draft ? Tokens.draft-brush : Tokens.text-secondary-brush;
                }
            }
            // Right-aligned, so a button appearing to the left of Play never moves it.
            actions := HorizontalLayout {
                x: parent.width - self.width - Tokens.action-bar-padding.right;
                y: parent.border + (parent.height - parent.border - self.height) / 2;
                width: self.preferred-width;
                height: Tokens.control-min-height;
                spacing: Tokens.space-8;
                if root.can-undo: Button {
                    text: ModsText.undo; icon: Tokens.icon-undo; horizontal-stretch: 0; enabled: !root.busy;
                    tip: ModsText.undo-tip;
                    clicked => { root.undo-remove(); }
                }
                if root.draft-count > 0: Button {
                    text: ModsText.revert(root.draft-count); kind: ButtonKind.subtle; horizontal-stretch: 0; enabled: !root.busy;
                    tip: ModsText.revert-tip;
                    clicked => { root.revert-drafts(); }
                }
                Button {
                    text: ModsText.play; icon: Tokens.icon-play; kind: ButtonKind.primary; horizontal-stretch: 0; enabled: root.can-play;
                    tip: ModsText.play-tip;
                    clicked => { root.commit-settings(); root.play(); }
                }
            }
        }
    }

    // The row menu: what the pane's buttons do, with the keys that do it from the list.
    row-menu := PopupMenu {
        entries: [
            { title: root.selected.enabled ? ModsText.turn-off : ModsText.turn-on, gesture: ModsText.key-space, disabled: root.selected-index < 0 || root.busy },
            { title: ModsText.show-in-folder, icon: Tokens.icon-folder, disabled: root.selected-index < 0 },
            { separator: true },
            { title: ModsText.remove, icon: Tokens.icon-delete, gesture: ModsText.key-delete, disabled: root.selected-index < 0 || root.busy },
        ];
        activated(index) => {
            if (index == 0) { root.toggle-mod(root.selected-index); }
            if (index == 1) { root.reveal-mod(root.selected-index); }
            if (index == 3) { root.remove-mod(root.selected-index); }
        }
    }
}
