// Home: starting the game, and how far it has come. `HomeView` draws what its properties say and reports the buttons;
// `HomePage` is the only part that knows the `HomeState` global.

import { Tokens } from "../tokens.slint";
import { TitleText, SecondaryText, CaptionText, CaptionTone } from "../widgets/text.slint";
import { Button } from "../widgets/button.slint";
import { EterraBand, AshField, EterraFrames } from "../decorations.slint";
import { HomeText } from "../strings/home.slint";

export enum LaunchMode { online, offline, with-mods }

// Eterra's tree in its four keyframes; Home follows the game: none running, found, a character loading, in game.
export enum BloomPhase { wilted, budding, opening, bloom }

export global HomeState {
    // False only in a run without the launcher (tests): Home then shows the companion's own title.
    in property <bool> has-launcher: true;
    in property <BloomPhase> phase: BloomPhase.wilted;
    // The game is on its way in (found, not yet in play): ash drifts up the page.
    in property <bool> game-starting;
    in property <bool> can-start: true;
    in property <bool> can-start-with-mods: true;
    // Why the buttons are disabled, or what each does (the tooltips, shown on disabled buttons too).
    in property <string> online-tip;
    in property <string> offline-tip;
    in property <string> with-mods-tip;
    // The last start's message, about this one game.
    in property <string> message;
    in property <bool> message-is-error;

    callback start(LaunchMode);
}

export component HomeView inherits Rectangle {
    in property <bool> has-launcher: true;
    in property <bool> game-starting;
    in property <bool> can-start: true;
    in property <bool> can-start-with-mods: true;
    in property <string> online-tip;
    in property <string> offline-tip;
    in property <string> with-mods-tip;
    in property <string> message;
    in property <bool> message-is-error;
    // Not `start`: on a component, that name would shadow the `start` of `alignment: start` in every binding inside it.
    callback play(LaunchMode);

    // Eterra's tree crowns Home and follows the game (Rust heads it for the game's phase); ash drifts only while the game is
    // on its way in.
    band := EterraBand {
        x: 0;
        y: 0;
        width: root.width;
        visible: root.has-launcher;
    }

    if root.has-launcher && root.game-starting: AshField {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    EterraFrames { }

    // One centred column under the eye, pushed below the twigs.
    VerticalLayout {
        x: (root.width - self.width) / 2;
        y: 0;
        width: Math.min(Tokens.reading-max-width, Math.max(0px, root.width - Tokens.empty-state-margin.left - Tokens.empty-state-margin.right));
        height: root.height;
        padding-top: root.has-launcher ? band.content-top : Tokens.empty-state-margin.top;
        alignment: start;
        spacing: root.has-launcher ? Tokens.space-12 : Tokens.space-8;

        TitleText {
            text: root.has-launcher ? HomeText.last-epoch : HomeText.home;
            horizontal-alignment: center;
        }

        if !root.has-launcher: SecondaryText {
            text: HomeText.companion;
            horizontal-alignment: center;
        }

        // Three ways in, in the order of how much they change: online as the game ships, offline, offline with mods.
        if root.has-launcher: HorizontalLayout {
            alignment: center;
            padding-top: Tokens.empty-action-margin.top;
            spacing: Tokens.space-8;

            Button {
                text: HomeText.play-online;
                enabled: root.can-start;
                tip: root.online-tip;
                clicked => {
                    root.play(LaunchMode.online);
                }
            }

            Button {
                text: HomeText.play-offline;
                enabled: root.can-start;
                tip: root.offline-tip;
                clicked => {
                    root.play(LaunchMode.offline);
                }
            }

            Button {
                text: HomeText.play-offline-with-mods;
                enabled: root.can-start && root.can-start-with-mods;
                tip: root.with-mods-tip;
                clicked => {
                    root.play(LaunchMode.with-mods);
                }
            }
        }

        if root.has-launcher && root.message != "": HorizontalLayout {
            alignment: center;
            spacing: Tokens.space-6;

            // Top-aligned with the first line.
            VerticalLayout {
                alignment: start;
                padding-top: Tokens.icon-baseline-nudge.top;

                Image {
                    image-fit: contain;
                    source: root.message-is-error ? Tokens.icon-error : Tokens.icon-info;
                    width: Tokens.icon-size-small;
                    height: Tokens.icon-size-small;
                    colorize: root.message-is-error ? Tokens.error-brush : Tokens.text-muted-brush;
                }
            }

            CaptionText {
                text: root.message;
                tone: root.message-is-error ? CaptionTone.error : CaptionTone.secondary;
                max-width: Tokens.reading-max-width;
                accessible-role: text;
                // Announced as it changes.
                accessible-live-region: polite;
            }
        }
    }
}

export component HomePage inherits Rectangle {
    HomeView {
        width: root.width;
        height: root.height;
        has-launcher: HomeState.has-launcher;
        game-starting: HomeState.game-starting;
        can-start: HomeState.can-start;
        can-start-with-mods: HomeState.can-start-with-mods;
        online-tip: HomeState.online-tip;
        offline-tip: HomeState.offline-tip;
        with-mods-tip: HomeState.with-mods-tip;
        message: HomeState.message;
        message-is-error: HomeState.message-is-error;
        play(mode) => {
            HomeState.start(mode);
        }
    }
}
