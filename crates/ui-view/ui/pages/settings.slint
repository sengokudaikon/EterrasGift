// Settings. Switches save the moment they flip; the typed locations wait for "Save locations". `SettingsView` draws what its
// properties say and reports the controls; `SettingsPage` is the only part that knows the `SettingsState` global.

import { ScrollView } from "../widgets/scroll-view.slint";
import { Tokens } from "../tokens.slint";
import { TitleText, SectionText, SecondaryText, LabelText, CaptionText, BodyText } from "../widgets/text.slint";
import { Button, ButtonKind } from "../widgets/button.slint";
import { ToggleSwitch } from "../widgets/toggle.slint";
import { TextField } from "../widgets/text-field.slint";
import { ActionBar, MessageTone, SettingGroup, SwitchSetting } from "common.slint";
import { SettingsText } from "../strings/settings.slint";

export struct LocationSetting {
    label: string,
    // The box's accessible name, when the label is not it ("Mod library folder").
    name: string,
    value: string,
    placeholder: string,
    caption: string,
    browse-label: string,
}

export struct ModuleRow { title: string, description: string, problem: string, enabled: bool }
export struct SettingsSectionRow {
    module-index: int, section-index: int, title: string, description: string, note: string,
    // `label` names the switch for a screen reader.
    toggle: bool, checked: bool, label: string, on-text: string, off-text: string,
    status: string, action: string, unavailable: string,
    action-enabled: bool, action-tip: string,
}

export global SettingsState {
    // The app's version, for About.
    in property <string> version;
    in property <[ModuleRow]> modules;
    in property <[SettingsSectionRow]> sections;
    in property <[LocationSetting]> locations;
    in property <bool> locations-changed;
    in property <bool> saving;
    in property <bool> saving-locations;
    in property <bool> can-retry;
    in property <string> message;
    in property <MessageTone> message-tone;
    in property <bool> can-restart;
    callback module-toggled(int, bool);
    callback setting-toggled(int, int, bool);
    // A status section's action (module index, section index).
    callback section-action(int, int);
    callback location-edited(int, string);
    callback browse(int);
    callback save-locations();
    callback retry();
    callback restart();
}

export component SettingsView inherits Rectangle {
    in property <bool> compact;
    in property <string> version;
    in property <[ModuleRow]> modules;
    in property <[SettingsSectionRow]> sections;
    in property <[LocationSetting]> locations;
    in property <bool> locations-changed;
    in property <bool> saving-locations;
    in property <bool> can-retry;
    in property <string> message;
    in property <MessageTone> message-tone;
    in property <bool> can-restart;
    callback module-toggled(int, bool);
    callback setting-toggled(int, int, bool);
    callback section-action(int, int);
    callback location-edited(int, string);
    callback browse(int);
    callback save-locations();
    callback retry();
    callback restart();

    // The shared switch column, as wide as the widest switch the page shows with either word. Measured from hidden switches, out of the focus chain and the
    // accessibility tree.
    Rectangle {
        visible: false;
        width: 0px;
        height: 0px;

        switch-measure := VerticalLayout {
            for module in root.modules: VerticalLayout {
                ToggleSwitch { checked: true; }
                ToggleSwitch { checked: false; }
            }
            for section in root.sections: VerticalLayout {
                if section.toggle: ToggleSwitch { checked: true; on-text: section.on-text; }
                if section.toggle: ToggleSwitch { checked: false; off-text: section.off-text; }
            }
        }
    }

    VerticalLayout {
        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            // Measured from where the body actually ends: a layout's preferred height counts wrapped text inside `if` and
            // `for` blocks as one line (crates/ui/README.md).
            content-height: body.y + about-group.y + about-list.y + about-end.y + Tokens.settings-body-margin.bottom;

            // The body's margin sits outside its maximum width. Its height is its own, so where its
            // last child ends never depends on the scroll content's height (that would be a binding loop).
            body := VerticalLayout {
                x: root.compact ? Tokens.settings-body-compact-margin.left : Tokens.settings-body-margin.left;
                y: Tokens.settings-body-margin.top;
                width: Math.min(Tokens.settings-max-width, parent.width - self.x
                    - (root.compact ? Tokens.settings-body-compact-margin.right : Tokens.settings-body-margin.right));
                height: self.preferred-height;
                alignment: start;

                TitleText {
                    text: SettingsText.settings;
                }

                Rectangle {
                    height: Tokens.settings-title-margin.bottom;
                }

                for module[i] in root.modules: SettingGroup {
                    SwitchSetting {
                        title: module.title;
                        description: module.description;
                        note: SettingsText.restart-note;
                        problem: module.problem;
                        control-width: switch-measure.preferred-width;
                        ToggleSwitch {
                            label: module.title;
                            checked: module.enabled;
                            toggled(on) => { root.module-toggled(i, on); }
                        }
                    }
                }

                for section in root.sections: SettingGroup {
                    if section.toggle: SwitchSetting {
                        title: section.title;
                        description: section.description;
                        note: section.note;
                        control-width: switch-measure.preferred-width;
                        ToggleSwitch {
                            label: section.label != "" ? section.label : section.title;
                            checked: section.checked;
                            on-text: section.on-text;
                            off-text: section.off-text;
                            toggled(on) => { root.setting-toggled(section.module-index, section.section-index, on); }
                        }
                    }
                    if !section.toggle: VerticalLayout {
                        spacing: Tokens.space-10;
                        SectionText { text: section.title; }
                        SecondaryText { text: section.description; }
                        Rectangle {
                            background: Tokens.surface-brush;
                            border-width: Tokens.border-all.left;
                            border-color: Tokens.hairline-brush;
                            border-radius: Tokens.control-radius;
                            // The padding lies inside the 1px border, so the frame adds to it.
                            HorizontalLayout {
                                padding-left: Tokens.border-all.left + Tokens.notice-padding.left;
                                padding-right: Tokens.border-all.right + Tokens.notice-padding.right;
                                padding-top: Tokens.border-all.top + Tokens.notice-padding.top;
                                padding-bottom: Tokens.border-all.bottom + Tokens.notice-padding.bottom;
                                BodyText { text: section.status; }
                            }
                        }
                        HorizontalLayout {
                            spacing: Tokens.space-12;
                            alignment: start;
                            Button {
                                text: section.action;
                                icon: Tokens.icon-refresh;
                                enabled: section.action-enabled;
                                tip: section.action-tip;
                                clicked => { root.section-action(section.module-index, section.section-index); }
                            }
                            // Refreshing reads the game, so while it can't, the reason sits beside the button.
                            CaptionText { text: section.unavailable; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                    }
                }

                SettingGroup {
                    VerticalLayout {
                        spacing: Tokens.space-16;

                        SectionText {
                            text: SettingsText.locations;
                        }

                        for location[i] in root.locations: VerticalLayout {
                            spacing: Tokens.space-6;

                            LabelText {
                                text: location.label;
                            }

                            HorizontalLayout {
                                spacing: Tokens.space-8;

                                TextField {
                                    label: location.name;
                                    text: location.value;
                                    placeholder: location.placeholder;
                                    edited(text) => {
                                        root.location-edited(i, text);
                                    }
                                }

                                Button {
                                    text: SettingsText.browse;
                                    icon: Tokens.icon-folder;
                                    // A screen-reader name; the button shows no tip.
                                    accessible-name: location.browse-label;
                                    clicked => {
                                        root.browse(i);
                                    }
                                }
                            }

                            CaptionText {
                                text: location.caption;
                            }
                        }

                    }
                }

                about-group := SettingGroup {
                    last: true;

                    about-list := VerticalLayout {
                        spacing: Tokens.space-6;

                        SectionText {
                            text: SettingsText.about;
                        }

                        BodyText {
                            text: SettingsText.version(root.version);
                        }

                        SecondaryText {
                            text: SettingsText.license;
                        }

                        SecondaryText {
                            text: SettingsText.source(SettingsText.source-address);
                        }

                        SecondaryText {
                            text: SettingsText.made-with-slint;
                        }

                        CaptionText {
                            text: SettingsText.fonts;
                        }

                        CaptionText {
                            text: SettingsText.icons;
                        }

                        // Where the page really ends; see `content-height`.
                        about-end := Rectangle {
                            height: 0px;
                        }
                    }
                }

            }
        }

        ActionBar {
            message: root.message;
            tone: root.message-tone;

            if root.can-restart: Button {
                text: SettingsText.restart-now;
                tip: SettingsText.restart-now-tip;
                clicked => {
                    root.restart();
                }
            }

            if root.can-retry: Button {
                text: SettingsText.retry-save;
                tip: SettingsText.retry-save-tip;
                clicked => { root.retry(); }
            }

            Button {
                text: SettingsText.save-locations;
                kind: ButtonKind.primary;
                enabled: root.locations-changed && !root.saving-locations;
                tip: SettingsText.save-locations-tip;
                clicked => {
                    root.save-locations();
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> compact;

    SettingsView {
        width: root.width;
        height: root.height;
        compact: root.compact;
        version: SettingsState.version;
        modules: SettingsState.modules;
        sections: SettingsState.sections;
        locations: SettingsState.locations;
        locations-changed: SettingsState.locations-changed;
        saving-locations: SettingsState.saving-locations;
        can-retry: SettingsState.can-retry;
        message: SettingsState.message;
        message-tone: SettingsState.message-tone;
        can-restart: SettingsState.can-restart;
        module-toggled(index, on) => { SettingsState.module-toggled(index, on); }
        setting-toggled(module, section, on) => { SettingsState.setting-toggled(module, section, on); }
        section-action(module, section) => { SettingsState.section-action(module, section); }
        location-edited(index, text) => { SettingsState.location-edited(index, text); }
        browse(index) => { SettingsState.browse(index); }
        save-locations => { SettingsState.save-locations(); }
        retry => { SettingsState.retry(); }
        restart => { SettingsState.restart(); }
    }
}
