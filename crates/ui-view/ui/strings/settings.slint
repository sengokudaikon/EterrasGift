// Settings' words. Every view word is an `@tr` here, never a literal in a view; its English is the gettext msgid,
// shared with any phrase that reads the same. A context only tells apart English that means two things
// (see shell.slint).

export global SettingsText {
    out property <string> settings: @tr("Settings");
    out property <string> restart-note: @tr("Takes effect after restarting Eterra's Gift.");
    out property <string> locations: @tr("Locations");
    out property <string> browse: @tr("Browse…");
    out property <string> restart-now: @tr("Restart now");
    out property <string> restart-now-tip: @tr("Restart Eterra's Gift to apply the saved changes");
    out property <string> retry-save: @tr("Retry save");
    out property <string> retry-save-tip: @tr("Try saving again");
    out property <string> save-locations: @tr("Save locations");
    out property <string> save-locations-tip: @tr("Save the locations above");
    out property <string> about: @tr("About");
    public pure function version(version: string) -> string { return @tr("Eterra's Gift {}", version); }
    out property <string> license: @tr("Free software under the GNU General Public License, version 3.");
    public pure function source(address: string) -> string { return @tr("Source code: {}", address); }
    // Where the source is published, not a word to translate.
    out property <string> source-address: "https://github.com/sengokudaikon/EterrasGift";
    out property <string> made-with-slint: @tr("Made with Slint.");
    out property <string> fonts: @tr("Cinzel and Noto Sans are under the SIL Open Font License 1.1.");
    out property <string> icons: @tr("Fluent System Icons are under the MIT License.");
}
